<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_vehicle" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.vehicle</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_vehicles" icon="fa-car">
                    <field string="Vehículos" name="vehicle_count" widget="statinfo"/>
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page string="Vehículos / Matrículas" name="vehicles">
                    <field name="vehicle_ids">
                        <tree editable="bottom">
                            <field name="name" placeholder="Ej: 1234-BBB"/>
                            <field name="notes" placeholder="Marca, modelo o notas..."/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
