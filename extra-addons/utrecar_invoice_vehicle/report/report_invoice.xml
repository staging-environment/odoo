<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_vehicle" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="after">
            <div id="vehicle_informations" class="row mt-2 mb-3 py-2 px-3" t-if="o.vehicle_plate or o.vehicle_mileage or o.vehicle_driver" style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 4px;">
                <div class="col-4" t-if="o.vehicle_plate">
                    <strong>Matrícula:</strong>
                    <span class="m-0" t-field="o.vehicle_plate"/>
                </div>
                <div class="col-4" t-if="o.vehicle_mileage">
                    <strong>Kilómetros:</strong>
                    <span class="m-0" t-esc="o.vehicle_mileage"/> km
                </div>
                <div class="col-4" t-if="o.vehicle_driver">
                    <strong>Conductor:</strong>
                    <span class="m-0" t-field="o.vehicle_driver"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Datos fiscales del cliente congelados en el momento de emitir la factura -->
    <template id="invoice_partner_snapshot_address">
        <address class="mb-0">
            <div><strong t-esc="o.inv_snap_name"/></div>
            <div t-if="o.inv_snap_street" t-esc="o.inv_snap_street"/>
            <div t-if="o.inv_snap_street2" t-esc="o.inv_snap_street2"/>
            <div t-if="o.inv_snap_zip or o.inv_snap_city"><t t-esc="o.inv_snap_zip"/> <t t-esc="o.inv_snap_city"/></div>
            <div t-if="o.inv_snap_state or o.inv_snap_country">
                <t t-esc="o.inv_snap_state"/><t t-if="o.inv_snap_state and o.inv_snap_country">, </t><t t-esc="o.inv_snap_country"/>
            </div>
        </address>
        <div t-if="o.inv_snap_vat">NIF/CIF: <span t-esc="o.inv_snap_vat"/></div>
    </template>

    <template id="report_invoice_document_partner_snapshot" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='address_not_same_as_shipping']/t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-if="o.inv_snap_set">
                    <t t-call="utrecar_invoice_vehicle.invoice_partner_snapshot_address"/>
                </t>
                <t t-else="">
                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat">NIF/CIF: <span t-field="o.partner_id.vat"/></div>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']/t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-if="o.inv_snap_set">
                    <t t-call="utrecar_invoice_vehicle.invoice_partner_snapshot_address"/>
                </t>
                <t t-else="">
                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat">NIF/CIF: <span t-field="o.partner_id.vat"/></div>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@name='no_shipping']/t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-if="o.inv_snap_set">
                    <t t-call="utrecar_invoice_vehicle.invoice_partner_snapshot_address"/>
                </t>
                <t t-else="">
                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat">NIF/CIF: <span t-field="o.partner_id.vat"/></div>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@name='customer_code']" position="replace">
            <t t-set="utrecar_cust_code" t-value="o.inv_snap_ref if o.inv_snap_set else o.partner_id.ref"/>
            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="utrecar_cust_code" name="customer_code">
                <strong>Código de cliente:</strong><br/>
                <span t-esc="utrecar_cust_code"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='shipping_address_block']/div" position="replace">
            <div t-if="o.inv_snap_set and o.inv_snap_shipping" style="white-space: pre-line;" t-esc="o.inv_snap_shipping"/>
            <div t-else="" t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </xpath>
    </template>
</odoo>
