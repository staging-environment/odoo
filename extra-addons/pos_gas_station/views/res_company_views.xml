<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de res.company -->
    <record id="view_company_form_inherit_gas_stations" model="ir.ui.view">
        <field name="name">res.company.form.inherit.gas.stations</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <!-- Deshabilitar creación de nuevas empresas desde esta ficha y añadir clases de ancho completo -->
            <xpath expr="//form" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="class">o_company_fullwidth_form</attribute>
            </xpath>

            <xpath expr="//sheet" position="attributes">
                <attribute name="class">o_company_fullwidth_sheet</attribute>
            </xpath>

            <!-- Botón Volver a Gestión de Gasolineras -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_return_to_gas_station_dashboard"
                            type="object"
                            string="← Volver a Gestión de gasolineras"
                            class="btn-secondary"/>
                </header>
            </xpath>

            <!-- Ocultar caja superior de botones (Estaciones/Ramas) ya que las estaciones están en su pestaña dedicada -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 1. Quitar el bloque lateral derecho (Chatter / Enviar mensaje / Historial) -->
            <xpath expr="//div[hasclass('oe_chatter')]" position="replace"/>

            <!-- 2. Ocultar el ID de la compañía (company_registry) -->
            <xpath expr="//field[@name='company_registry']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 3. Sustituir el bloque compacto de dirección por campos con sus labels claros e individuales -->
            <xpath expr="//label[@for='street']" position="replace"/>
            <xpath expr="//div[hasclass('o_address_format')]" position="replace">
                <field name="street" string="Dirección" placeholder="Calle, Avenida, Polígono..."/>
                <field name="street2" string="Dirección 2" placeholder="Edificio, Piso, Puerta..."/>
                <field name="city" string="Localidad" placeholder="Ciudad o Municipio"/>
                <field name="state_id" string="Provincia" placeholder="Seleccione provincia" options="{'no_open': True, 'no_create': True}"/>
                <field name="zip" string="Código Postal" placeholder="Ej: 41710"/>
                <field name="country_id" string="País" placeholder="Seleccione país" options="{'no_open': True, 'no_create': True}"/>
            </xpath>

            <!-- Ocultar pestaña innecesaria de Ramas (Branches) -->
            <xpath expr="//page[@name='branches']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Listado de Estaciones de Servicio directamente debajo en el formulario de la Empresa -->
            <xpath expr="//notebook" position="after">
                <div class="mt-4 pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="m-0 fw-bold" style="color: #0369a1; font-size: 1.25rem;">
                                <i class="fa fa-gas-pump me-2 text-danger"></i>Estaciones de Servicio asociadas
                            </h4>
                            <div class="text-muted small mt-1">
                                Terminales y estaciones pertenecientes a esta empresa con control de turnos, arqueo y personal.
                            </div>
                        </div>
                        <button name="action_create_station"
                                string="＋ Nueva Estación de Servicio"
                                type="object"
                                class="btn btn-outline-primary btn-sm fw-bold"/>
                    </div>
                    <field name="pos_config_ids" context="{'default_company_id': id}">
                        <tree string="Estaciones de Servicio de la Empresa" create="true" delete="true">
                            <field name="name" string="Estación de Servicio" decoration-bf="1"/>
                            <field name="current_session_state" string="Estado del Turno" widget="badge" 
                                   decoration-success="current_session_state == 'opened'" 
                                   decoration-warning="current_session_state == 'opening_control'"
                                   decoration-muted="current_session_state == 'closed'"/>
                            <field name="current_user_id" string="Cajero / Operario Activo"/>
                            <field name="station_users_summary" string="Personal y Roles Asignados"/>
                            <field name="last_session_closing_date" string="Último Cierre"/>
                            <field name="last_session_closing_cash" string="Último Arqueo" widget="monetary"/>
                            <field name="currency_id" column_invisible="True"/>
                            <button name="action_open_station_form" 
                                    string="Ver Ficha" 
                                    type="object" 
                                    icon="fa-eye" 
                                    class="btn btn-sm btn-outline-primary py-0 px-2"/>
                            <button name="action_edit_station" 
                                    string="Editar" 
                                    type="object" 
                                    icon="fa-pencil" 
                                    class="btn btn-sm btn-primary py-0 px-2 text-white"/>
                            <button name="open_ui" 
                                    string="TPV" 
                                    type="object" 
                                    icon="fa-desktop" 
                                    class="btn btn-sm btn-secondary py-0 px-2"/>
                            <button name="action_delete_station" 
                                    string="Borrar" 
                                    type="object" 
                                    icon="fa-trash" 
                                    class="btn btn-sm btn-outline-danger py-0 px-2 text-danger" 
                                    confirm="¿Está seguro de que desea eliminar esta estación de servicio? Se verificará que no tenga información ni registros asociados antes de proceder."/>
                        </tree>
                    </field>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Extensión de pos.config (Ficha Completa de Estación) con Botón Volver y Grupo de Información -->
    <record id="view_pos_config_form_inherit_return_btn" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.return.btn</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_pos_config_form_full_width</attribute>
            </xpath>
            <xpath expr="//sheet" position="attributes">
                <attribute name="class">o_pos_config_sheet_full_width</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_return_to_company"
                            type="object"
                            string="← Volver a la Empresa"
                            class="btn-secondary"
                            invisible="not company_id"/>
                    <button name="action_return_to_gas_station_dashboard"
                            type="object"
                            string="← Volver a Gestión de gasolineras"
                            class="btn-secondary"/>
                    <button name="open_ui"
                            type="object"
                            string="🖥 Entrar al TPV / Abrir Turno"
                            class="btn-primary fw-bold"/>
                </header>
            </xpath>
            <xpath expr="//div[@id='title']" position="after">
                <group class="mt-2 mb-3">
                    <group string="Información de la Estación">
                        <field name="company_id" string="Empresa Propietaria" options="{'no_open': True, 'no_create': True}"/>
                        <field name="current_session_state" string="Estado del Turno" widget="badge" 
                               decoration-success="current_session_state == 'opened'" 
                               decoration-warning="current_session_state == 'opening_control'"/>
                        <field name="current_user_id" string="Cajero / Empleado Activo"/>
                    </group>
                    <group string="Último Turno y Arqueo">
                        <field name="last_session_closing_date" string="Fecha Último Cierre"/>
                        <field name="last_session_closing_cash" string="Saldo de Cierre / Arqueo" widget="monetary"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extensión del listado (tree) de res.company -->
    <record id="view_company_tree_inherit_gas_stations" model="ir.ui.view">
        <field name="name">res.company.tree.inherit.gas.stations</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="class">o_company_tree_view</attribute>
            </xpath>

            <!-- 1. Ocultar columnas Contacto y Ramas que no tienen sentido en este flujo -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <!-- 2. Añadir Dirección, Teléfono, Nº Estaciones Asociadas y Nº Empleados Asociados -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="company_address" string="Dirección"/>
                <field name="phone" string="Teléfono"/>
                <field name="pos_config_count" string="Estaciones Asociadas"/>
                <field name="station_employee_count" string="Empleados en Estaciones"/>
                <field name="edit_icon" widget="html" string="Acción"/>
            </xpath>
        </field>
    </record>
</odoo>
