<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de res.company -->
    <record id="view_company_form_inherit_gas_stations" model="ir.ui.view">
        <field name="name">res.company.form.inherit.gas.stations</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Botón Volver a Gestión de Gasolineras -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_return_to_gas_station_dashboard"
                            type="object"
                            string="← Volver a Gestión de gasolineras"
                            class="btn-secondary"/>
                </header>
            </xpath>
            <!-- Smart Button en la caja superior de la empresa -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_gas_stations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tachometer">
                    <field name="pos_config_count" widget="statinfo" string="Estaciones"/>
                </button>
            </xpath>
            <!-- Pestaña de Estaciones en el formulario de la Empresa -->
            <xpath expr="//notebook" position="inside">
                <page string="Estaciones de Servicio / TPVs" name="gas_stations_tab">
                    <field name="pos_config_ids" context="{'default_company_id': id}">
                        <tree string="Estaciones de Servicio de la Empresa" create="true" delete="true">
                            <field name="name" string="Nombre de la Estación"/>
                            <field name="current_session_state" string="Estado del Turno" widget="badge" 
                                   decoration-success="current_session_state == 'opened'" 
                                   decoration-warning="current_session_state == 'opening_control'"/>
                            <field name="current_user_id" string="Cajero Activo"/>
                            <button name="action_open_station_form" string="Ajustes / Editar" type="object" icon="fa-sliders" class="btn-secondary"/>
                            <button name="open_ui" string="Entrar al TPV" type="object" icon="fa-desktop" class="btn-primary"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extensión de pos.config (Ajustes de estación) con Botón Volver -->
    <record id="view_pos_config_form_inherit_return_btn" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.return.btn</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_return_to_gas_station_dashboard"
                            type="object"
                            string="← Volver a Gestión de gasolineras"
                            class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
