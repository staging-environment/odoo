<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA FORMULARIO PARA ASIGNACION DE ROL Y TIENDAS A USUARIO -->
    <record id="view_users_form_inherit_utrecar_role" model="ir.ui.view">
        <field name="name">res.users.form.inherit.utrecar.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <group string="Perfil y Acceso UTRECAR">
                    <field name="utrecar_role_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}"/>
                    <field name="pos_config_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Dejar vacio para acceso a todas las tiendas de la empresa"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- VISTA ARBOL DE ROLES -->
    <record id="view_utrecar_role_tree" model="ir.ui.view">
        <field name="name">utrecar.role.tree</field>
        <field name="model">utrecar.role</field>
        <field name="arch" type="xml">
            <tree string="Roles UTRECAR">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="user_count" string="Usuarios"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <!-- VISTA FORMULARIO DE ROLES CON ASIGNACION DIRECTA DE USUARIOS -->
    <record id="view_utrecar_role_form" model="ir.ui.view">
        <field name="name">utrecar.role.form</field>
        <field name="model">utrecar.role</field>
        <field name="arch" type="xml">
            <form string="Rol de Usuario">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre del Rol"/>
                        <h1><field name="name" placeholder="Ej: Gestor de Gasolinera"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Usuarios Asignados" name="assigned_users">
                            <field name="user_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="pos_config_ids" widget="many2many_tags" string="Tiendas Asignadas"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCIONES -->
    <record id="action_utrecar_role" model="ir.actions.act_window">
        <field name="name">Configuración de Roles</field>
        <field name="res_model">utrecar.role</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ACCION CLIENTE: MATRIZ DE PERMISOS -->
    <record id="action_utrecar_permission_matrix" model="ir.actions.client">
        <field name="name">Matriz de Roles y Permisos</field>
        <field name="tag">utrecar_permission_matrix</field>
    </record>

    <!-- ACCION CLIENTE: DASHBOARD VISUAL DE GASOLINERAS POR EMPRESA -->
        <!-- ACCION CLIENTE: VISUALIZACION DE EMPLEADOS POR ESTACION Y VPN -->
    <record id="action_vpn_station_employees" model="ir.actions.client">
        <field name="name">Usuarios y Estaciones (VPN)</field>
        <field name="tag">vpn_station_employees</field>
        <field name="target">current</field>
    </record>

        <!-- ACCION CLIENTE: GESTION DE PERSONAL Y EMPRESAS -->
    <record id="action_employee_company_roles" model="ir.actions.client">
        <field name="name">Personal y Empresas</field>
        <field name="tag">employee_company_roles</field>
        <field name="target">current</field>
    </record>

    <record id="action_gas_station_dashboard" model="ir.actions.client">
        <field name="name">Gestión de gasolineras</field>
        <field name="tag">gas_station_dashboard</field>
    </record>

    <!-- 1. APLICACIÓN PRINCIPAL #1 DE ODOO (SUSTITUYE A CONVERSACIONES COMO HOME) -->
    <menuitem id="menu_gas_station_root"
              name="Gestión de gasolineras"
              action="action_gas_station_dashboard"
              web_icon="pos_gas_station,static/description/icon.png"
              sequence="1"/>

    <!-- SUBMENÚS VISIBLES EN LA BARRA SUPERIOR (SIMPLIFICADA: SIN PRODUCTOS, PEDIDOS NI INFORMES) -->
    <menuitem id="menu_gas_station_sub_employee_roles"
              name="Personal y Empresas"
              parent="menu_gas_station_root"
              action="action_employee_company_roles"
              sequence="1"/>

    <!-- RELEGAR CONVERSACIONES AL FINAL PARA QUE NO SEA EL DEFAULT -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="sequence">999</field>
    </record>

    <!-- ACCION DISPATCHER INTELIGENTE DE ENTRADA AL PUNTO DE VENTA -->
    <record id="action_pos_entry_dispatcher" model="ir.actions.server">
        <field name="name">Entrada Punto de Venta</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_entry_pos()
        </field>
    </record>

    <!-- SOBREESCRIBIR ACCION DEL MENU PRINCIPAL DE PUNTO DE VENTA -->
    <record id="point_of_sale.menu_point_root" model="ir.ui.menu">
        <field name="action" ref="action_pos_entry_dispatcher"/>
    </record>
    <record id="point_of_sale.menu_pos_dashboard" model="ir.ui.menu">
        <field name="action" ref="action_pos_entry_dispatcher"/>
    </record>

    <!-- REGLA DE REGISTRO PARA RESTRINGIR TIENDAS POR USUARIO -->
    <record id="rule_pos_config_user_allowed" model="ir.rule">
        <field name="name">POS Config: Tiendas Asignadas a Empleado</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="domain_force">['|', ('allowed_user_ids', '=', False), ('allowed_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <!-- REGLA PARA QUE LOS GESTORES Y ADMINISTRADORES VEAN TODAS LAS TIENDAS -->
    <record id="rule_pos_config_manager_all" model="ir.rule">
        <field name="name">POS Config: Todas las Tiendas para Gestores</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
</odoo>
