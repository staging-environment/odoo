<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VENTANA PRINCIPAL TÁCTIL PARA AUTENTICACIÓN DE EMPLEADOS Y APERTURA DE TURNO -->
    <template id="station_employee_select_modal" name="Selector Táctil de Empleado Estación">
        &lt;!DOCTYPE html&gt;
        <html lang="es">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
            <title>Terminal de pista - Identificación de Empleado</title>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
            <style>
                :root {
                    --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%);
                    --card-bg: #ffffff;
                    --card-border: #e2e8f0;
                    --accent-cyan: #0284c7;
                    --accent-blue: #2563eb;
                    --accent-emerald: #10b981;
                    --text-main: #0f172a;
                    --text-muted: #64748b;
                }
                * {
                    box-sizing: border-box;
                    margin: 0;
                    padding: 0;
                    -webkit-tap-highlight-color: transparent;
                }
                body {
                    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                    background: var(--bg-gradient);
                    color: var(--text-main);
                    min-height: 100vh;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 24px 20px;
                    overflow-x: hidden;
                }
                .ambient-glow {
                    position: fixed;
                    top: 5%;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 700px;
                    height: 420px;
                    background: radial-gradient(ellipse at center, rgba(14, 165, 233, 0.10), transparent 70%);
                    pointer-events: none;
                    z-index: 0;
                }
                .modal-container {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    max-width: 780px;
                    background: #ffffff;
                    border: 1px solid var(--card-border);
                    border-radius: 28px;
                    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.08), 0 4px 16px rgba(15, 23, 42, 0.03);
                    padding: 40px 38px 32px 38px;
                    animation: modalFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }
                @keyframes modalFadeIn {
                    from { opacity: 0; transform: translateY(18px) scale(0.98); }
                    to { opacity: 1; transform: translateY(0) scale(1); }
                }
                .modal-header {
                    text-align: center;
                    margin-bottom: 28px;
                }
                .brand-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    background: #e0f2fe;
                    border: 1px solid #bae6fd;
                    padding: 6px 16px;
                    border-radius: 9999px;
                    font-size: 0.82rem;
                    font-weight: 700;
                    color: #0284c7;
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                    margin-bottom: 12px;
                }
                .pulse-dot {
                    width: 8px;
                    height: 8px;
                    background-color: #10b981;
                    border-radius: 50%;
                    box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
                    animation: pulse 2s infinite;
                }
                @keyframes pulse {
                    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
                    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
                    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
                }
                .station-title {
                    font-size: 2.15rem;
                    font-weight: 800;
                    letter-spacing: -0.5px;
                    color: #0f172a;
                    margin-bottom: 6px;
                }
                .station-subtitle {
                    font-size: 0.95rem;
                    color: var(--text-muted);
                    max-width: 580px;
                    margin: 0 auto;
                    line-height: 1.45;
                }
                .station-meta-bar {
                    display: flex;
                    justify-content: center;
                    flex-wrap: wrap;
                    gap: 12px;
                    margin-top: 14px;
                    font-size: 0.82rem;
                    color: #475569;
                }
                .meta-tag {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    background: #f8fafc;
                    border: 1px solid #e2e8f0;
                    padding: 4px 12px;
                    border-radius: 8px;
                }

                /* BUSCADORES Y FILTROS */
                .search-panel {
                    margin-top: 10px;
                    margin-bottom: 18px;
                    position: relative;
                }
                .search-inputs-row {
                    display: flex;
                    gap: 14px;
                }
                @media (max-width: 640px) {
                    .search-inputs-row {
                        flex-direction: column;
                    }
                    .modal-container {
                        padding: 28px 20px;
                    }
                }
                .field-col {
                    display: flex;
                    flex-direction: column;
                    gap: 6px;
                }
                .flex-name {
                    flex: 1.6;
                }
                .flex-code {
                    flex: 1;
                }
                .field-label {
                    font-size: 0.78rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    color: var(--text-muted);
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }
                .field-label .text-accent {
                    color: var(--accent-cyan);
                }
                .input-wrap {
                    position: relative;
                    display: flex;
                    align-items: center;
                }
                .input-icon {
                    position: absolute;
                    left: 16px;
                    color: var(--text-muted);
                    font-size: 0.95rem;
                    pointer-events: none;
                    transition: color 0.2s;
                }
                .search-input {
                    width: 100%;
                    height: 52px;
                    padding: 0 42px 0 46px;
                    background: #f8fafc;
                    border: 1.5px solid #cbd5e1;
                    border-radius: 14px;
                    color: var(--text-main);
                    font-size: 0.96rem;
                    font-family: inherit;
                    outline: none;
                    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                }
                .search-input::placeholder {
                    color: #94a3b8;
                    font-size: 0.9rem;
                }
                .search-input:focus {
                    border-color: var(--accent-cyan);
                    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
                    background: #ffffff;
                }
                .search-input:focus + .input-icon,
                .input-wrap:focus-within .input-icon {
                    color: var(--accent-cyan);
                }
                .clear-input-btn {
                    position: absolute;
                    right: 14px;
                    background: transparent;
                    border: none;
                    color: #94a3b8;
                    font-size: 0.9rem;
                    cursor: pointer;
                    display: none;
                    align-items: center;
                    justify-content: center;
                    width: 24px;
                    height: 24px;
                    border-radius: 50%;
                    transition: all 0.15s;
                }
                .clear-input-btn:hover {
                    color: #0f172a;
                    background: #e2e8f0;
                }

                .code-input-wrap .search-input {
                    padding-right: 90px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                }
                .btn-code-enter {
                    position: absolute;
                    right: 6px;
                    height: 40px;
                    padding: 0 14px;
                    background: linear-gradient(135deg, #0284c7, #0369a1);
                    border: none;
                    border-radius: 10px;
                    color: #fff;
                    font-weight: 700;
                    font-size: 0.85rem;
                    font-family: inherit;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    transition: all 0.18s ease;
                    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
                }
                .btn-code-enter:hover {
                    background: linear-gradient(135deg, #0369a1, #075985);
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(2, 132, 199, 0.35);
                }
                .btn-code-enter:active {
                    transform: translateY(0) scale(0.97);
                }

                /* DROPDOWN AUTOCOMPLETE */
                .autocomplete-dropdown {
                    position: absolute;
                    top: calc(100% + 8px);
                    left: 0;
                    right: 0;
                    background: #ffffff;
                    border: 1px solid #e2e8f0;
                    border-radius: 18px;
                    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.12), 0 4px 12px rgba(15, 23, 42, 0.04);
                    max-height: 380px;
                    overflow-y: auto;
                    padding: 8px;
                    z-index: 50;
                    animation: dropdownFade 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                }
                @keyframes dropdownFade {
                    from { opacity: 0; transform: translateY(-6px); }
                    to { opacity: 1; transform: translateY(0); }
                }
                .autocomplete-dropdown::-webkit-scrollbar {
                    width: 6px;
                }
                .autocomplete-dropdown::-webkit-scrollbar-thumb {
                    background: #cbd5e1;
                    border-radius: 3px;
                }
                .autocomplete-item {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 12px 14px;
                    border-radius: 12px;
                    cursor: pointer;
                    transition: all 0.16s ease;
                    border: 1px solid transparent;
                    user-select: none;
                }
                .autocomplete-item:hover,
                .autocomplete-item.active {
                    background: #f0f9ff;
                    border-color: #bae6fd;
                    transform: translateX(4px);
                }
                .autocomplete-item:active {
                    transform: scale(0.98);
                }
                .item-avatar {
                    width: 46px;
                    height: 46px;
                    border-radius: 13px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 800;
                    font-size: 1.05rem;
                    color: #fff;
                    flex-shrink: 0;
                    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
                }
                .item-info {
                    flex: 1;
                    min-width: 0;
                }
                .item-name-row {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    margin-bottom: 3px;
                }
                .item-name {
                    font-weight: 700;
                    font-size: 0.98rem;
                    color: #0f172a;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .item-code-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 3px;
                    background: #e0f2fe;
                    color: #0284c7;
                    border: 1px solid #bae6fd;
                    padding: 2px 7px;
                    border-radius: 6px;
                    font-size: 0.72rem;
                    font-weight: 800;
                    letter-spacing: 0.3px;
                }
                .item-meta-row {
                    display: flex;
                    align-items: center;
                    flex-wrap: wrap;
                    gap: 10px;
                    font-size: 0.76rem;
                    color: var(--text-muted);
                }
                .item-role {
                    color: var(--accent-cyan);
                    font-weight: 600;
                }
                .item-dni {
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    color: #64748b;
                }
                .item-action-icon {
                    color: #94a3b8;
                    font-size: 0.95rem;
                    transition: all 0.2s;
                    padding-right: 4px;
                }
                .autocomplete-item:hover .item-action-icon,
                .autocomplete-item.active .item-action-icon {
                    color: var(--accent-cyan);
                    transform: translateX(4px);
                }
                .dropdown-no-results {
                    padding: 26px 16px;
                    text-align: center;
                    color: #64748b;
                }
                .dropdown-no-results i {
                    font-size: 1.8rem;
                    color: #94a3b8;
                    margin-bottom: 8px;
                    display: block;
                }
                .dropdown-no-results p {
                    font-size: 0.9rem;
                    margin: 0;
                }

                .modal-footer {
                    margin-top: 24px;
                    padding-top: 18px;
                    border-top: 1px solid #f1f5f9;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    gap: 14px;
                }
                .admin-link {
                    color: #475569;
                    text-decoration: none;
                    font-size: 0.85rem;
                    font-weight: 600;
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 9px 20px;
                    border-radius: 12px;
                    background: #f8fafc;
                    border: 1px solid #e2e8f0;
                    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                }
                .admin-link:hover {
                    color: #0f172a;
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
                    transform: translateY(-1px);
                }
                .footer-badge {
                    font-size: 0.78rem;
                    color: #64748b;
                }
                .loading-overlay {
                    display: none;
                    position: absolute;
                    inset: 0;
                    background: rgba(255, 255, 255, 0.94);
                    border-radius: 28px;
                    backdrop-filter: blur(12px);
                    z-index: 100;
                    align-items: center;
                    justify-content: center;
                    flex-direction: column;
                    gap: 16px;
                }
                .spinner {
                    width: 46px;
                    height: 46px;
                    border: 3px solid rgba(2, 132, 199, 0.2);
                    border-top-color: var(--accent-cyan);
                    border-radius: 50%;
                    animation: spin 0.8s linear infinite;
                }
                @keyframes spin {
                    to { transform: rotate(360deg); }
                }
            </style>
        </head>
        <body>
            <div class="ambient-glow"></div>
            
            <div class="modal-container">
                <div id="loadingOverlay" class="loading-overlay">
                    <div class="spinner"></div>
                    <div style="font-size: 1.15rem; font-weight: 700; color: #0f172a;">Iniciando turno y conectando TPV...</div>
                    <div style="font-size: 0.88rem; color: #64748b;">Sincronizando con estación de servicio</div>
                </div>

                <div class="modal-header">
                    <t t-if="has_tpv">
                        <div class="brand-badge">
                            <span class="pulse-dot"></span>
                            Terminal de pista • <t t-esc="company_name"/>
                        </div>
                        <h1 class="station-title"><t t-esc="station.name"/></h1>
                        <p class="station-subtitle">Identifíquese con su código o buscando por nombre/DNI para abrir turno en esta estación de <strong class="text-dark"><t t-esc="company_name"/></strong>.</p>
                        <div class="station-meta-bar">
                            <span class="meta-tag">
                                <i class="fa fa-users text-primary me-1"></i> <strong><t t-esc="len(employees)"/></strong> Empleados de <t t-esc="company_name"/> autorizados
                            </span>
                            <span class="meta-tag">
                                <i class="fa fa-network-wired text-info me-1"></i> VPN Pista: <t t-esc="client_ip"/>
                            </span>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="brand-badge" style="background: #e0f2fe; border-color: #bae6fd; color: #0284c7;">
                            <i class="fa fa-desktop"></i> Conexión sin TPV de Pista
                        </div>
                        <h1 class="station-title">Acceso no disponible para TPV</h1>
                        <div class="alert border shadow-sm mt-3 mb-3 text-start" role="alert" style="border-radius: 16px; background: #f8fafc; border-color: #e2e8f0 !important; color: #334155; padding: 22px 24px;">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-info-circle fa-2x" style="color: #0284c7; opacity: 0.95;"></i>
                                <div>
                                    <div class="fw-bold fs-6 mb-1" style="color: #0f172a;">Te estás conectando desde un equipo sin acceso al TPV de gasolinera</div>
                                    <div class="small" style="color: #64748b; line-height: 1.55;">
                                        Esta conexión procede de la IP de VPN <strong class="font-monospace" style="color: #0284c7; background: #e0f2fe; padding: 2px 6px; border-radius: 6px;"><t t-esc="client_ip"/></strong>, la cual no tiene asignado ningún Punto de Venta (TPV) de gasolinera. Para operar un turno y cobrar en pista, es necesario conectarse desde un puesto autorizado de estación de servicio.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- BUSCADOR CON AUTOCOMPLETE Y FILTRO POR CÓDIGO -->
                <t t-if="has_tpv">
                    <div class="search-panel">
                        <div class="search-inputs-row">
                            <!-- Filtro 1: Nombre o DNI con Autocomplete -->
                            <div class="field-col flex-name">
                                <label class="field-label" for="searchEmployeeInput">
                                    <i class="fa fa-search text-accent"></i> Buscar por Nombre o DNI
                                </label>
                                <div class="input-wrap">
                                    <i class="fa fa-user input-icon"></i>
                                    <input type="text" id="searchEmployeeInput" class="search-input" placeholder="Escriba nombre o DNI de empleado..." autocomplete="off" autofocus="autofocus"/>
                                    <button type="button" id="clearNameBtn" class="clear-input-btn" title="Limpiar"><i class="fa fa-times"></i></button>
                                </div>
                            </div>

                            <!-- Filtro 2: Código de Usuario -->
                            <div class="field-col flex-code">
                                <label class="field-label" for="searchCodeInput">
                                    <i class="fa fa-hashtag text-accent"></i> Código de Usuario
                                </label>
                                <div class="input-wrap code-input-wrap">
                                    <i class="fa fa-id-badge input-icon"></i>
                                    <input type="text" id="searchCodeInput" class="search-input" placeholder="Ej: 101" autocomplete="off" inputmode="numeric"/>
                                    <button type="button" id="submitCodeBtn" class="btn-code-enter" title="Acceder con código">
                                        <span>Entrar</span>
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Autocomplete desplegable flotante -->
                        <div id="autocompleteDropdown" class="autocomplete-dropdown" style="display: none;"></div>
                    </div>

                    <!-- Formulario invisible para autenticar y abrir turno -->
                    <form id="employeeLoginForm" action="/pos_gas_station/station_login" method="POST">
                        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                        <input type="hidden" name="station_id" t-att-value="station.id if station else ''"/>
                        <input type="hidden" name="employee_id" id="selectedEmployeeId" value=""/>
                    </form>
                </t>

                <div class="modal-footer" t-if="is_admin_vpn">
                    <a href="/web?admin=1" class="admin-link" id="adminLoginLink">
                        <i class="fa fa-shield-alt text-info"></i> Acceso administrador
                    </a>
                </div>
            </div>

            <!-- Inyección segura de datos de empleados autorizados -->
            <script id="stationEmployeesData" type="application/json" t-out="employees_json"/>

            <script type="text/javascript"><![CDATA[
            (function() {
                // Lista de empleados con rol Empleado
                var EMPLOYEES = [];
                try {
                    var scriptEl = document.getElementById('stationEmployeesData');
                    var rawData = scriptEl ? (scriptEl.textContent || scriptEl.innerText || '').trim() : '';
                    if (rawData) {
                        try {
                            EMPLOYEES = JSON.parse(rawData);
                        } catch (err1) {
                            var txt = document.createElement("textarea");
                            txt.innerHTML = rawData;
                            EMPLOYEES = JSON.parse(txt.value || '[]');
                        }
                    }
                } catch (err) {
                    console.error("Error al parsear datos de empleados:", err);
                    EMPLOYEES = [];
                }

                var searchNameInput = document.getElementById('searchEmployeeInput');
                var clearNameBtn = document.getElementById('clearNameBtn');
                var searchCodeInput = document.getElementById('searchCodeInput');
                var submitCodeBtn = document.getElementById('submitCodeBtn');
                var dropdown = document.getElementById('autocompleteDropdown');
                if (!searchNameInput) {
                    return;
                }
                var activeIndex = -1;
                var currentFiltered = [];

                function selectEmployeeById(empId) {
                    if (!empId) return;
                    document.getElementById('selectedEmployeeId').value = empId;
                    document.getElementById('loadingOverlay').style.display = 'flex';
                    document.getElementById('employeeLoginForm').submit();
                }

                function filterEmployees() {
                    var nameTerm = searchNameInput.value.toLowerCase().trim();
                    var codeTerm = searchCodeInput.value.toLowerCase().trim();

                    if (!nameTerm && !codeTerm) {
                        dropdown.style.display = 'none';
                        dropdown.innerHTML = '';
                        currentFiltered = [];
                        activeIndex = -1;
                        clearNameBtn.style.display = 'none';
                        return;
                    }

                    clearNameBtn.style.display = nameTerm ? 'flex' : 'none';

                    currentFiltered = EMPLOYEES.filter(function(emp) {
                        var matchName = true;
                        if (nameTerm) {
                            var name = (emp.full_name || '').toLowerCase();
                            var dni = (emp.dni || '').toLowerCase();
                            matchName = (name.indexOf(nameTerm) !== -1) || (dni.indexOf(nameTerm) !== -1);
                        }

                        var matchCode = true;
                        if (codeTerm) {
                            var code = String(emp.code || '').toLowerCase();
                            var virtus = String(emp.virtus_codigo || '').toLowerCase();
                            var idStr = String(emp.id || '').toLowerCase();
                            matchCode = (code === codeTerm) || (code.indexOf(codeTerm) === 0) || (virtus === codeTerm) || (idStr === codeTerm);
                        }

                        return matchName && matchCode;
                    });

                    renderDropdown(currentFiltered);
                }

                function renderDropdown(items) {
                    if (!items.length) {
                        dropdown.innerHTML = '<div class="dropdown-no-results"><i class="fa fa-user-slash"></i><p>No se encontró ningún empleado con ese criterio.</p></div>';
                        dropdown.style.display = 'block';
                        activeIndex = -1;
                        return;
                    }

                    var html = '';
                    items.forEach(function(emp, idx) {
                        var codeDisplay = emp.code ? ('#' + emp.code) : ('#' + emp.id);
                        var dniDisplay = emp.dni || 'Sin DNI';
                        var roleDisplay = emp.puesto || 'Expendedor de Pista';

                        html += '<div class="autocomplete-item ' + (idx === activeIndex ? 'active' : '') + '" data-index="' + idx + '" data-id="' + emp.id + '" onclick="selectEmployeeById(\'' + emp.id + '\')">' +
                                '<div class="item-avatar" style="background: ' + emp.avatar_gradient + ';">' +
                                    escapeHtml(emp.initials || 'EM') +
                                '</div>' +
                                '<div class="item-info">' +
                                    '<div class="item-name-row">' +
                                        '<span class="item-name">' + escapeHtml(emp.full_name) + '</span>' +
                                        '<span class="item-code-badge"><i class="fa fa-hashtag"></i> ' + escapeHtml(codeDisplay) + '</span>' +
                                    '</div>' +
                                    '<div class="item-meta-row">' +
                                        '<span class="item-role">' + escapeHtml(roleDisplay) + '</span>' +
                                        '<span class="item-dni"><i class="fa fa-id-card"></i> ' + escapeHtml(dniDisplay) + '</span>' +
                                    '</div>' +
                                '</div>' +
                                '<div class="item-action-icon">' +
                                    '<i class="fa fa-chevron-right"></i>' +
                                '</div>' +
                            '</div>';
                    });

                    dropdown.innerHTML = html;
                    dropdown.style.display = 'block';
                }

                function escapeHtml(text) {
                    if (!text) return '';
                    var div = document.createElement('div');
                    div.textContent = String(text);
                    return div.innerHTML;
                }

                // Eventos de entrada
                searchNameInput.addEventListener('input', function() {
                    activeIndex = -1;
                    filterEmployees();
                });

                searchCodeInput.addEventListener('input', function() {
                    activeIndex = -1;
                    filterEmployees();
                });

                clearNameBtn.addEventListener('click', function() {
                    searchNameInput.value = '';
                    searchNameInput.focus();
                    filterEmployees();
                });

                // Acción de tecla Enter en el input de código
                function handleCodeSubmit() {
                    var code = searchCodeInput.value.trim();
                    if (!code) {
                        searchCodeInput.focus();
                        return;
                    }

                    // 1. Buscar coincidencia exacta por código
                    var exact = EMPLOYEES.find(function(e) {
                        return String(e.code) === code || String(e.virtus_codigo) === code || String(e.id) === code;
                    });
                    if (exact) {
                        selectEmployeeById(exact.id);
                        return;
                    }

                    // 2. Si hay 1 único resultado filtrado, seleccionarlo
                    if (currentFiltered.length === 1) {
                        selectEmployeeById(currentFiltered[0].id);
                        return;
                    }

                    // 3. Si hay varios o ninguno, enfocar dropdown
                    filterEmployees();
                }

                submitCodeBtn.addEventListener('click', handleCodeSubmit);

                searchCodeInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        handleCodeSubmit();
                    }
                });

                // Navegación por teclado en el autocomplete
                searchNameInput.addEventListener('keydown', function(e) {
                    if (dropdown.style.display === 'none' || !currentFiltered.length) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            if (currentFiltered.length === 1) {
                                selectEmployeeById(currentFiltered[0].id);
                            }
                        }
                        return;
                    }

                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        activeIndex = (activeIndex + 1) % currentFiltered.length;
                        updateActiveItem();
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        activeIndex = (activeIndex - 1 + currentFiltered.length) % currentFiltered.length;
                        updateActiveItem();
                    } else if (e.key === 'Enter') {
                        e.preventDefault();
                        if (activeIndex >= 0 && activeIndex < currentFiltered.length) {
                            selectEmployeeById(currentFiltered[activeIndex].id);
                        } else if (currentFiltered.length === 1) {
                            selectEmployeeById(currentFiltered[0].id);
                        }
                    } else if (e.key === 'Escape') {
                        dropdown.style.display = 'none';
                    }
                });

                function updateActiveItem() {
                    var items = dropdown.querySelectorAll('.autocomplete-item');
                    items.forEach(function(item, idx) {
                        if (idx === activeIndex) {
                            item.classList.add('active');
                            item.scrollIntoView({ block: 'nearest' });
                        } else {
                            item.classList.remove('active');
                        }
                    });
                }

                // Cerrar autocomplete si se hace clic fuera
                document.addEventListener('click', function(e) {
                    if (!e.target.closest('.search-panel')) {
                        dropdown.style.display = 'none';
                    }
                });

                // Exponer selectEmployeeById al ámbito global para el onclick
                window.selectEmployeeById = selectEmployeeById;
            })();
            ]]></script>
        </body>
        </html>
    </template>

