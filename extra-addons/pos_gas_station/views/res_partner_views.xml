<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA FORMULARIO HEREDADA: ASIGNACIÓN DE EMPRESA Y ESTACIÓN DE SERVICIO Y PANTALLA COMPLETA SIN CHATTER -->
    <record id="view_partner_form_inherit_gas_station" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.gas.station</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="before">
                <field name="ref" string="Código de Cliente" placeholder="Automático (correlativo)"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="company_id" widget="selection" options="{'no_create': True, 'no_open': True}" required="not parent_id and customer_rank &gt; 0" string="Cliente de la empresa" help="Empresa del grupo (Utrecar / A.R. Trieste) a la que pertenece este cliente. Decide en qué TPV aparece."/>
            </xpath>
            <!-- Etiqueta "Nombre" (obligatorio) sobre el nombre de la compañía / individuo -->
            <xpath expr="//div[hasclass('oe_title')]/h1" position="before">
                <div class="o_utrecar_name_label">
                    <span class="o_form_label">Nombre</span><span class="text-danger fw-bold"> *</span>
                </div>
            </xpath>
            <!-- Persona de contacto: aviso de que dirección y NIF vienen de su empresa -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-info d-flex align-items-center justify-content-between gap-2 py-2 mb-3" role="status"
                     invisible="not parent_id or type != 'contact'">
                    <span>
                        <i class="fa fa-info-circle me-1"/>
                        La <strong>dirección</strong> y el <strong>NIF</strong> de esta persona de contacto se heredan de su empresa
                        y se modifican en la ficha de la empresa.
                    </span>
                    <button name="action_utrecar_open_parent" type="object" string="Abrir ficha de la empresa"
                            class="btn btn-sm btn-primary" icon="fa-building"/>
                </div>
            </xpath>
            <!-- DIRECCIÓN: un campo por fila con su propia etiqueta (en lugar del bloque sin etiquetas de Odoo) -->
            <xpath expr="(//div[hasclass('o_address_format')])[1]" position="replace"/>
            <xpath expr="//span[@name='address_name']" position="replace">
                <field name="type" string="Tipo de dirección" invisible="is_company" readonly="user_ids" required="not is_company"/>
                <field name="street" string="Dirección" placeholder="Calle, número, piso..." readonly="type == 'contact' and parent_id" required="not parent_id and customer_rank &gt; 0"/>
                <field name="street2" string="Dirección (línea 2)" placeholder="Polígono, urbanización... (opcional)" readonly="type == 'contact' and parent_id"/>
                <field name="zip" string="Código Postal" placeholder="Ej: 41710" readonly="type == 'contact' and parent_id" required="not parent_id and customer_rank &gt; 0"/>
                <field name="city" string="Población" placeholder="Ej: Utrera" readonly="type == 'contact' and parent_id" required="not parent_id and customer_rank &gt; 0"/>
                <field name="state_id" string="Provincia" placeholder="Provincia" options="{'no_open': True, 'no_quick_create': True}"
                       context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}" readonly="type == 'contact' and parent_id" required="not parent_id and customer_rank &gt; 0"/>
                <field name="country_id" string="País" placeholder="País" options="{'no_open': True, 'no_create': True}" readonly="type == 'contact' and parent_id" required="not parent_id and customer_rank &gt; 0"/>
            </xpath>
            <!-- Botón visible "Guardar": guarda la ficha (con validaciones y avisos) -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_utrecar_save_partner" type="object" string="Guardar cambios"
                            class="btn-primary o_utrecar_save_partner" icon="fa-floppy-o"/>
                    <button name="action_utrecar_back" type="object" string="Volver"
                            class="btn-secondary o_utrecar_back_partner" icon="fa-arrow-left"/>
                </header>
            </xpath>
            <!-- Ficha sin botón "Nuevo" (los clientes se crean desde Gestión de Gasolineras)
                 y sin botones inteligentes mientras el cliente no esté guardado -->
            <xpath expr="/form" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">not id</attribute>
            </xpath>
            <!-- CAMPOS OBLIGATORIOS EN CLIENTES PRINCIPALES (no en personas de contacto) -->
            <xpath expr="//sheet" position="inside">
                <field name="customer_rank" invisible="1"/>
            </xpath>
            <xpath expr="(//field[@name='vat'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="(//field[@name='email'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="(//field[@name='street'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="(//field[@name='zip'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="(//field[@name='city'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="(//field[@name='state_id'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="(//field[@name='country_id'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0</attribute>
            </xpath>
            <xpath expr="(//field[@name='phone'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0 and not mobile</attribute>
            </xpath>
            <xpath expr="(//field[@name='mobile'])[1]" position="attributes">
                <attribute name="required">not parent_id and customer_rank &gt; 0 and not phone</attribute>
            </xpath>
            <!-- Ocultar campos innecesarios en la ficha de cliente: Sitio web, Idioma y Etiquetas -->
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group//field[@name='lang']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Quitar bloque lateral/inferior de chatter (enviar mensaje, registrar nota y actividades) -->
            <xpath expr="//div[hasclass('oe_chatter')]" position="replace"/>
            <!-- Marcador dentro de sheet para aplicar estilos de pantalla completa -->
            <xpath expr="//sheet" position="inside">
                <div class="o_partner_full_width_marker d-none"/>
            </xpath>
        </field>
    </record>

    <!-- VISTA LISTA / TREE DEDICADA DE CLIENTES DE ESTACIÓN DE SERVICIO -->
    <record id="view_partner_gas_station_tree" model="ir.ui.view">
        <field name="name">res.partner.gas.station.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <tree string="Clientes de Estaciones de Servicio" sample="1">
                <field name="ref" string="Código" decoration-bf="1"/>
                <field name="display_name" string="Nombre / Razón Social"/>
                <field name="vat" string="CIF / NIF"/>
                <field name="customer_type" widget="badge" 
                       decoration-warning="customer_type == 'credit'" 
                       decoration-info="customer_type == 'monthly'" 
                       decoration-muted="customer_type == 'ordinary'"
                       string="Tipo Facturación"/>
                <field name="company_id" string="Empresa"/>
                <field name="phone" class="o_force_ltr" optional="show"/>
                <field name="email" optional="show"/>
                <field name="city" optional="show"/>
                <field name="credit_limit_amount" string="Límite Crédito" optional="hide" widget="monetary"/>
            </tree>
        </field>
    </record>

    <!-- FILTROS Y BÚSQUEDA PERSONALIZADA PARA CLIENTES -->
    <record id="view_res_partner_filter_gas_station" model="ir.ui.view">
        <field name="name">res.partner.select.gas.station</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_person']" position="before">
                <filter name="filter_customer" string="Clientes" domain="[('customer_rank', '>', 0)]"/>
                <separator/>
                <filter name="filter_customer_credit" string="Clientes de Crédito" domain="[('customer_type', '=', 'credit')]"/>
                <filter name="filter_customer_monthly" string="Facturación Mensual" domain="[('customer_type', '=', 'monthly')]"/>
                <filter name="filter_customer_ordinary" string="Facturación Ordinaria" domain="[('customer_type', '=', 'ordinary')]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                <filter name="group_customer_type" string="Tipo de Facturación" context="{'group_by': 'customer_type'}"/>
            </xpath>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA DIRECTA A CLIENTES -->
    <record id="action_gas_station_customers" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('type', '!=', 'private')]</field>
        <field name="context">{
            'default_customer_rank': 1,
            'search_default_filter_customer': 1,
            'search_default_group_company': 1,
        }</field>
        <field name="view_id" ref="view_partner_gas_station_tree"/>
        <field name="search_view_id" ref="view_res_partner_filter_gas_station"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo cliente de estación de servicio
            </p>
            <p>
                Gestione aquí los clientes de cada empresa y estación de servicio, estableciendo si son de Crédito (albarán en pista), Mensual u Ordinaria.
            </p>
        </field>
    </record>
</odoo>
