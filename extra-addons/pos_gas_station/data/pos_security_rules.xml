<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- GRUPO DE SEGURIDAD: GESTIÓN DE PERSONAL Y ADMINISTRADORES -->
    <record id="group_utrecar_manage_staff" model="res.groups">
        <field name="name">Gestionar Personal y Administradores</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="point_of_sale.rule_pos_config_multi_company" model="ir.rule">
        <field name="domain_force">['|', ('company_id', '=', False), '|', ('company_id', 'in', company_ids), ('company_id', 'in', user.company_ids.ids)]</field>
    </record>

    <!-- REGLA DE SEGURIDAD: LOS EMPLEADOS DE PISTA SOLO VEN LAS ESTACIONES VINCULADAS -->
    <record id="rule_pos_config_employee_restricted" model="ir.rule">
        <field name="name">Acceso a Estaciones por Empresa para Empleados de Pista</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
    </record>

    <record id="rule_pos_config_manager_all" model="ir.rule">
        <field name="name">Acceso Total a Estaciones para Responsables y Administradores</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager')), (4, ref('base.group_erp_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- REGLA DE SEGURIDAD: CLIENTES SEPARADOS POR ESTACIÓN SEGÚN PERMISOS DE USUARIO -->
    <record id="rule_res_partner_station_restricted" model="ir.rule">
        <field name="name">Restricción de Clientes por Empresa</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
    </record>

    <record id="rule_res_partner_station_manager_all" model="ir.rule">
        <field name="name">Acceso Total a Clientes para Responsables y Administradores</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager')), (4, ref('base.group_erp_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
