<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_gas_station.GasStationDashboard" owl="1">
        <div class="gas-station-dashboard-wrapper">
            <!-- CABECERA SUPERIOR DEL DASHBOARD -->
            <div class="dashboard-topbar">
                <div class="topbar-left">
                    <div class="dashboard-header-icon">⛽</div>
                    <div>
                        <h2 class="dashboard-title">Gestión de Gasolineras</h2>
                        <span class="dashboard-subtitle">Control Multi-Empresa de Estaciones y Pistas de Suministro</span>
                    </div>
                </div>

                <div class="topbar-stats">
                    <div class="stat-pill">
                        <span class="stat-number"><t t-esc="state.stats.total_companies"/></span>
                        <span class="stat-label">Empresas</span>
                    </div>
                    <div class="stat-pill">
                        <span class="stat-number"><t t-esc="state.stats.total_stations"/></span>
                        <span class="stat-label">Estaciones</span>
                    </div>
                    <div class="stat-pill stat-pill-active" t-if="state.stats.total_open_sessions > 0">
                        <span class="stat-number">🟢 <t t-esc="state.stats.total_open_sessions"/></span>
                        <span class="stat-label">Turno Activo</span>
                    </div>
                </div>

                <div class="topbar-actions">

                                        <button class="btn btn-outline-info btn-sm me-2" t-on-click="() => this.openEmployeeCompanyRoles()" title="Gestión de Personal y Empresas">
                        <i class="fa fa-users me-1"/> Personal y Empresas
                    </button>
                    <button class="btn btn-outline-primary btn-sm me-2" t-on-click="() => this.openNewCompany()" t-if="state.isManager">
                        <i class="fa fa-plus me-1"/> Nueva Empresa
                    </button>
                    <button class="btn btn-primary btn-sm" t-on-click="() => this.loadDashboardData()" title="Actualizar datos">
                        <i class="fa fa-refresh me-1"/> Actualizar
                    </button>
                </div>
            </div>

            <!-- CONTENEDOR PRINCIPAL: CAJAS DE EMPRESAS Y SUS ESTACIONES -->
            <div class="dashboard-content-scroll">
                <t t-if="state.loading">
                    <div class="dashboard-loading-box">
                        <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                        <p>Cargando empresas y estaciones autorizadas...</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="companies-grid">
                        <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                            <div class="company-card-box">
                                <!-- CABECERA DE LA CAJA DE EMPRESA -->
                                <div class="company-card-header">
                                    <div class="company-brand-area">
                                        <!-- LOGO DE LA EMPRESA O MONOGRAMA -->
                                        <div class="company-logo-container" t-on-click="() => this.openCompany(comp.id)" title="Haga clic para editar empresa o cambiar logo">
                                            <t t-if="comp.has_logo">
                                                <img t-att-src="comp.logo_url" class="company-real-logo" t-att-alt="comp.name"/>
                                            </t>
                                            <t t-else="">
                                                <div class="company-fallback-logo">
                                                    <i class="fa fa-building-o"/>
                                                </div>
                                            </t>
                                        </div>
                                        <div class="company-titles">
                                            <div class="company-name-row">
                                                <h3 class="company-name-text cursor-pointer" t-on-click="() => this.openCompanyEmployees(comp)" title="Ver y gestionar empleados con acceso a esta empresa">
                                                    <t t-esc="comp.name"/>
                                                </h3>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">
                                                    <t t-esc="comp.stations_count"/> <t t-if="comp.stations_count === 1">Estación</t><t t-else="">Estaciones</t>
                                                </span>
                                                <span class="badge bg-info-subtle text-info border border-info-subtle cursor-pointer" t-on-click="() => this.openCompanyEmployees(comp)" title="Ver y gestionar empleados con acceso a esta empresa">
                                                    <i class="fa fa-users me-1"/> <t t-esc="comp.employees_count || 0"/> Empleados autorizados
                                                </span>
                                            </div>
                                            <div class="company-meta-row">
                                                <span t-if="comp.vat" class="company-vat"><i class="fa fa-id-card-o me-1"/> <t t-esc="comp.vat"/></span>
                                                <span t-if="comp.city" class="company-city"><i class="fa fa-map-marker me-1"/> <t t-esc="comp.city"/></span>
                                                <span t-if="comp.phone" class="company-phone"><i class="fa fa-phone me-1"/> <t t-esc="comp.phone"/></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="company-header-tools" t-if="state.isManager">
                                        <button class="btn btn-sm btn-outline-info me-2" 
                                                t-on-click="() => this.openCompanyEmployees(comp)" 
                                                title="Gestionar asignación de empleados para esta empresa">
                                            <i class="fa fa-users me-1"/> Empleados (<t t-esc="comp.employees_count || 0"/>)
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary me-2" 
                                                t-on-click="() => this.openNewStation(comp.id)" 
                                                title="Crear nueva estación en esta empresa">
                                            <i class="fa fa-plus me-1"/> Nueva Estación
                                        </button>
                                        <button class="btn btn-sm btn-light border btn-edit-company me-2" 
                                                t-on-click="() => this.openCompany(comp.id)" 
                                                title="Configurar datos de la empresa y ver sus estaciones">
                                            <i class="fa fa-pencil me-1"/> Editar Empresa
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" 
                                                t-if="comp.id !== 4 and comp.stations_count === 0"
                                                t-on-click="() => this.deleteCompany(comp)" 
                                                title="Eliminar empresa vacía">
                                            <i class="fa fa-trash me-1"/> Borrar
                                        </button>
                                    </div>
                                </div>

                                <!-- CUERPO DE LA CAJA DE EMPRESA: GRILLA DE ESTACIONES -->
                                <div class="company-stations-body">
                                    <t t-if="comp.stations.length === 0">
                                        <div class="no-stations-alert">
                                            <i class="fa fa-info-circle me-2 text-muted"/>
                                            <span>No hay estaciones registradas o asignadas para esta empresa según sus permisos.</span>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="stations-cards-grid">
                                            <t t-foreach="comp.stations" t-as="st" t-key="st.id">
                                                <div class="station-card">
                                                    <div class="station-card-top">
                                                        <div class="station-icon-title">
                                                            <span class="station-fuel-pump-icon">⛽</span>
                                                            <div>
                                                                <h4 class="station-title-text"><t t-esc="st.name"/></h4>
                                                                <span class="station-pumps-badge">
                                                                    <i class="fa fa-tachometer me-1"/> <t t-esc="st.pumps_count"/> Surtidores
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <div class="station-session-status">
                                                            <t t-if="st.session_state === 'opened'">
                                                                <span class="badge bg-success py-1 px-2">
                                                                    <i class="fa fa-circle text-white me-1 blink"/> Turno Activo (<t t-esc="st.session_user"/>)
                                                                </span>
                                                            </t>
                                                            <t t-elif="st.session_state === 'opening_control'">
                                                                <span class="badge bg-warning text-dark py-1 px-2">
                                                                    <i class="fa fa-clock-o me-1"/> Turno en Apertura
                                                                </span>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="badge bg-light text-secondary border py-1 px-2">
                                                                    <i class="fa fa-power-off me-1"/> Turno Cerrado (Listo)
                                                                </span>
                                                            </t>
                                                        </div>
                                                    </div>

                                                    <!-- COMBUSTIBLES DISPONIBLES EN LA ESTACIÓN -->
                                                    <div class="station-fuels-pills">
                                                        <t t-foreach="st.fuels" t-as="fuel" t-key="fuel.code">
                                                            <span class="fuel-mini-pill" t-attf-class="fuel-mini-pill fuel-code-#{fuel.code.toLowerCase()}">
                                                                <t t-esc="fuel.name"/>
                                                            </span>
                                                        </t>
                                                    </div>

                                                    <!-- ACCIONES DE ESTACIÓN (APERTURA SE REALIZA DESDE PISTA / HOME) -->
                                                    <div class="station-actions-box">
                                                        <t t-if="st.has_active_session">
                                                            <button class="btn btn-access-pos btn-session-open"
                                                                    t-on-click="() => this.openStation(st.id)">
                                                                <i class="fa fa-bolt me-1"/> Continuar Turno / Entrar al TPV
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-primary ms-1" 
                                                                    t-on-click="() => this.selectEmployeeForStation(st.id)" 
                                                                    title="Cambiar de empleado o reabrir selección de turno">
                                                                <i class="fa fa-user-circle me-1"/> Cambiar Empleado
                                                            </button>
                                                        </t>

                                                        <div class="station-sub-actions" t-if="state.isManager">
                                                            <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.openConfig(st.id)" title="Ajustes de esta estación">
                                                                <i class="fa fa-sliders"/> Ajustes
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger" t-if="st.id !== 7" t-on-click="() => this.deleteStation(st)" title="Eliminar estación">
                                                                <i class="fa fa-trash"/> Borrar
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </div>

            <!-- MODAL DE GESTIÓN DE EMPLEADOS POR EMPRESA -->
            <t t-if="state.showEmployeesModal">
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1050;" role="dialog">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
                        <div class="modal-content shadow-lg border-0" style="border-radius: 16px; overflow: hidden; background: #ffffff;">
                            <div class="modal-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="modal-title fw-bold mb-0 text-white d-flex align-items-center gap-2">
                                        <i class="fa fa-building text-warning"/>
                                        <span>Empleados y Acceso al TPV — <t t-esc="state.selectedCompany ? state.selectedCompany.name : ''"/></span>
                                    </h5>
                                    <p class="mb-0 small text-white-50 mt-1">
                                        Active o desactive las empresas a las que cada empleado tiene autorización para abrir turno en sus TPVs.
                                    </p>
                                </div>
                                <button type="button" class="btn-close btn-close-white" t-on-click="() => this.closeEmployeesModal()" aria-label="Cerrar"></button>
                            </div>

                            <div class="modal-body p-4" style="max-height: 65vh; overflow-y: auto;">
                                <!-- BARRA DE BÚSQUEDA Y FILTRO RÁPIDO -->
                                <div class="d-flex gap-3 mb-3">
                                    <div class="input-group flex-grow-1">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa fa-search text-muted"/></span>
                                        <input type="text" 
                                               class="form-control bg-light border-start-0" 
                                               placeholder="Buscar por nombre o DNI de empleado..." 
                                               t-att-value="state.searchTerm"
                                               t-on-input="(ev) => this.onSearchInput(ev)"/>
                                        <button t-if="state.searchTerm" 
                                                class="btn btn-outline-secondary border-start-0" 
                                                type="button" 
                                                t-on-click="() => this.clearSearch()">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                    <div class="btn-group" role="group">
                                        <button type="button" 
                                                t-attf-class="btn btn-sm #{state.filterAssignedOnly ? 'btn-outline-primary' : 'btn-primary'}"
                                                t-on-click="() => this.setFilter(false)">
                                            Todos (<t t-esc="state.companyEmployees.length"/>)
                                        </button>
                                        <button type="button" 
                                                t-attf-class="btn btn-sm #{state.filterAssignedOnly ? 'btn-primary' : 'btn-outline-primary'}"
                                                t-on-click="() => this.setFilter(true)">
                                            Solo de esta empresa (<t t-esc="this.getAssignedCount()"/>)
                                        </button>
                                    </div>
                                </div>

                                <!-- TABLA DE EMPLEADOS CON CHECKBOXES POR EMPRESA -->
                                <div class="table-responsive border rounded-3">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3 py-3" style="width: 45%;">Empleado (Rol Empleado)</th>
                                                <th class="py-3" style="width: 20%;">DNI / Código</th>
                                                <t t-foreach="state.allCompanies" t-as="comp" t-key="comp.id">
                                                    <th class="text-center py-3" t-att-style="'width: ' + (35 / (state.allCompanies.length || 1)) + '%;'">
                                                        <span class="badge" t-attf-style="#{comp.id === (state.selectedCompany ? state.selectedCompany.id : 0) ? 'background: #3b82f6; color: white;' : 'background: #e2e8f0; color: #475569;'}">
                                                            <t t-esc="comp.name"/>
                                                        </span>
                                                    </th>
                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="filteredEmps" t-value="this.getFilteredEmployees()"/>
                                            <t t-if="filteredEmps.length === 0">
                                                <tr>
                                                    <td t-att-colspan="2 + (state.allCompanies.length || 1)" class="text-center py-4 text-muted">
                                                        <i class="fa fa-user-slash fa-2x mb-2 d-block text-secondary"/>
                                                        No se han encontrado empleados que coincidan con la búsqueda.
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-foreach="filteredEmps" t-as="emp" t-key="emp.odoo_user_id">
                                                <tr>
                                                    <td class="ps-3 py-2">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                                                 t-att-style="'width: 34px; height: 34px; font-size: 12px; background: ' + (emp.avatar_gradient || '#2563eb') + ';'">
                                                                <t t-esc="emp.initials || 'EM'"/>
                                                            </div>
                                                            <div>
                                                                <div class="fw-semibold text-dark"><t t-esc="emp.name"/></div>
                                                                <div class="text-muted small" style="font-size: 0.78rem;"><t t-esc="emp.email"/></div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="py-2">
                                                        <span class="badge bg-light text-dark border"><i class="fa fa-id-card-o me-1"/> <t t-esc="emp.dni || '-'"/></span>
                                                        <span class="badge bg-secondary-subtle text-secondary ms-1">#<t t-esc="emp.code"/></span>
                                                    </td>
                                                    <t t-foreach="state.allCompanies" t-as="comp" t-key="comp.id">
                                                        <td class="text-center py-2">
                                                            <div class="form-check form-switch d-inline-block">
                                                                <input class="form-check-input cursor-pointer" 
                                                                       type="checkbox" 
                                                                       role="switch"
                                                                       t-att-id="'switch_' + emp.odoo_user_id + '_' + comp.id"
                                                                       t-att-checked="emp.company_ids.includes(comp.id)"
                                                                       t-att-disabled="state.updatingUserId === emp.odoo_user_id"
                                                                       t-on-change="(ev) => this.toggleCompanyAccess(emp, comp.id, ev.target.checked)"/>
                                                            </div>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="modal-footer bg-light py-2 px-4 d-flex justify-content-between align-items-center">
                                <div class="small text-muted d-flex align-items-center gap-2">
                                    <i class="fa fa-check-circle text-success"/>
                                    <span>Asignación multi-empresa activa: el empleado aparecerá en el inicio de turno de las gasolineras correspondientes.</span>
                                </div>
                                <button type="button" class="btn btn-secondary px-4 fw-semibold" t-on-click="() => this.closeEmployeesModal()">
                                    Cerrar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
    </t>
</templates>
