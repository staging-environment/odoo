<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_gas_station.GasStationDashboard" owl="1">
        <div class="gas-station-dashboard-wrapper">
            <!-- CABECERA SUPERIOR DEL DASHBOARD -->
            <div class="dashboard-topbar">
                <div class="topbar-left">
                    <div class="dashboard-header-icon">⛽</div>
                    <div>
                        <h2 class="dashboard-title">Gestión de Gasolineras</h2>
                        <span class="dashboard-subtitle">Control Multi-Empresa de Estaciones y Pistas de Suministro</span>
                    </div>
                </div>

                <div class="topbar-stats">
                    <div class="stat-pill">
                        <span class="stat-number"><t t-esc="state.stats.total_companies"/></span>
                        <span class="stat-label">Empresas</span>
                    </div>
                    <div class="stat-pill">
                        <span class="stat-number"><t t-esc="state.stats.total_stations"/></span>
                        <span class="stat-label">Estaciones</span>
                    </div>
                    <div class="stat-pill stat-pill-active" t-if="state.stats.total_open_sessions > 0">
                        <span class="stat-number">🟢 <t t-esc="state.stats.total_open_sessions"/></span>
                        <span class="stat-label">Turno Activo</span>
                    </div>
                </div>

                <div class="topbar-actions">
                    <button class="btn btn-outline-info btn-sm me-2 fw-semibold" t-on-click="() => this.openEmployeeCompanyRoles()" title="Gestión de activación de personal por empresa">
                        <i class="fa fa-users me-1"/> Personal y Empresas
                    </button>
                    <button class="btn btn-primary btn-sm me-2 fw-semibold" t-on-click="() => this.openNewCompany()" t-if="state.isManager" title="Crear una nueva empresa">
                        <i class="fa fa-plus me-1"/> Nueva Empresa
                    </button>
                    <button class="btn btn-outline-secondary btn-sm fw-semibold" t-on-click="() => this.loadDashboardData()" title="Actualizar datos">
                        <i class="fa fa-refresh me-1" t-att-class="state.loading ? 'fa-spin' : ''"/> Actualizar
                    </button>
                </div>
            </div>

            <!-- CONTENEDOR PRINCIPAL: CAJAS DE EMPRESAS Y SUS ESTACIONES -->
            <div class="dashboard-content-scroll">
                <t t-if="state.loading">
                    <div class="dashboard-loading-box">
                        <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                        <p>Cargando empresas y estaciones autorizadas...</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="companies-grid">
                        <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                            <div class="company-card-box">
                                <!-- CABECERA DE LA CAJA DE EMPRESA -->
                                <div class="company-card-header">
                                    <div class="company-brand-area">
                                        <!-- LOGO DE LA EMPRESA O MONOGRAMA -->
                                        <div class="company-logo-container">
                                            <t t-if="comp.has_logo">
                                                <img t-att-src="comp.logo_url" class="company-real-logo" t-att-alt="comp.name"/>
                                            </t>
                                            <t t-else="">
                                                <div class="company-fallback-logo">
                                                    <i class="fa fa-building-o"/>
                                                </div>
                                            </t>
                                        </div>
                                        <div class="company-titles">
                                            <div class="company-name-row d-flex align-items-center gap-2 flex-wrap">
                                                <h3 class="company-name-text mb-0">
                                                    <t t-esc="comp.name"/>
                                                </h3>
                                                <button class="btn btn-sm btn-link text-muted p-0" 
                                                        t-if="state.isManager" 
                                                        t-on-click="() => this.promptEditCompany(comp)" 
                                                        title="Modificar datos de la empresa">
                                                    <i class="fa fa-pencil text-secondary"/>
                                                </button>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">
                                                    <t t-esc="comp.stations_count"/> <t t-if="comp.stations_count === 1">Estación</t><t t-else="">Estaciones</t>
                                                </span>
                                                <span class="badge bg-info-subtle text-info border border-info-subtle cursor-pointer" 
                                                      t-on-click="() => this.openEmployeeCompanyRoles()" 
                                                      title="Gestionar en Personal y Empresas">
                                                    <i class="fa fa-users me-1"/> <t t-esc="comp.employees_count || 0"/> Empleados activos
                                                </span>
                                            </div>
                                            <div class="company-meta-row mt-1 d-flex flex-wrap gap-2 text-muted small align-items-center">
                                                <span t-if="comp.vat" class="company-vat badge bg-light text-dark border"><i class="fa fa-id-card-o me-1 text-primary"/> <t t-esc="comp.vat"/></span>
                                                <span t-if="comp.street" class="company-street"><i class="fa fa-map-marker me-1 text-danger"/> <t t-esc="comp.street"/></span>
                                                <span t-if="comp.zip or comp.city" class="company-city"><i class="fa fa-building-o me-1 text-secondary"/> <t t-esc="comp.zip ? (comp.zip + ' ') : ''"/><t t-esc="comp.city"/></span>
                                                <span t-if="comp.phone" class="company-phone"><i class="fa fa-phone me-1 text-success"/> <t t-esc="comp.phone"/></span>
                                                <span t-if="comp.email" class="company-email"><i class="fa fa-envelope-o me-1 text-info"/> <t t-esc="comp.email"/></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="company-header-tools" t-if="state.isManager">
                                        <button class="btn btn-sm btn-outline-primary fw-semibold" 
                                                t-on-click="() => this.openNewStation(comp.id, comp.name)" 
                                                title="Crear nueva estación en esta empresa">
                                            <i class="fa fa-plus me-1"/> Nueva Estación
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-2" 
                                                t-if="comp.id !== 4 and comp.stations_count === 0"
                                                t-on-click="() => this.deleteCompany(comp)" 
                                                title="Eliminar empresa vacía">
                                            <i class="fa fa-trash me-1"/> Borrar
                                        </button>
                                    </div>
                                </div>

                                <!-- CUERPO DE LA CAJA DE EMPRESA: GRILLA DE ESTACIONES -->
                                <div class="company-stations-body">
                                    <t t-if="comp.stations.length === 0">
                                        <div class="no-stations-alert p-4 text-center text-muted bg-light rounded-3 border">
                                            <i class="fa fa-info-circle fa-2x mb-2 d-block text-secondary"/>
                                            <span>No hay estaciones registradas en esta empresa.</span>
                                            <div class="mt-2" t-if="state.isManager">
                                                <button class="btn btn-sm btn-primary" t-on-click="() => this.openNewStation(comp.id, comp.name)">
                                                    <i class="fa fa-plus me-1"/> Crear Primera Estación
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="stations-cards-grid">
                                            <t t-foreach="comp.stations" t-as="st" t-key="st.id">
                                                <div class="station-card shadow-sm border rounded-3 p-3 bg-white">
                                                    <div>
                                                        <!-- FILA 1: ICONO + NOMBRE + EDICIÓN + SURTIDORES -->
                                                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                                            <div class="d-flex align-items-center gap-2 text-truncate">
                                                                <span class="station-fuel-pump-icon">⛽</span>
                                                                <div class="text-truncate">
                                                                    <div class="d-flex align-items-center gap-1">
                                                                        <h4 class="station-title-text mb-0 text-truncate" t-att-title="st.name"><t t-esc="st.name"/></h4>
                                                                        <button class="btn btn-sm btn-link text-muted p-0 ms-1 flex-shrink-0" 
                                                                                t-if="state.isManager" 
                                                                                t-on-click="() => this.promptRenameStation(st)" 
                                                                                title="Modificar nombre de la estación">
                                                                            <i class="fa fa-pencil text-secondary" style="font-size: 11px;"/>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <span class="badge border px-2 py-1 flex-shrink-0" style="font-size: 11px; background: #f1f5f9; color: #1e293b; border-color: #cbd5e1 !important; font-weight: 700;">
                                                                <i class="fa fa-tachometer me-1 text-primary"/> <t t-esc="st.pumps_count"/> Surt.
                                                            </span>
                                                        </div>

                                                        <!-- FILA 2: IP VPN WIRE GUARD -->
                                                        <div class="mb-3">
                                                            <div class="station-vpn-pill" t-att-title="'IPs VPN de conexión: ' + (st.vpn_ip || 'No asignada')">
                                                                <i class="fa fa-shield text-primary flex-shrink-0"/>
                                                                <span class="text-truncate">VPN: <strong class="text-dark"><t t-esc="st.vpn_ip || 'No asignada'"/></strong></span>
                                                            </div>
                                                        </div>

                                                        <!-- FILA 3: CAJA DE ESTADO DE TURNO (TARJETA SUAVE) -->
                                                        <div class="station-turn-box" t-attf-class="station-turn-box #{st.has_active_session ? 'station-turn-box-active' : 'station-turn-box-closed'}">
                                                            <div class="d-flex align-items-center justify-content-between">
                                                                <div class="d-flex align-items-center gap-1 text-truncate">
                                                                    <t t-if="st.has_active_session">
                                                                        <span class="badge bg-success px-2 py-1 fw-bold" style="font-size: 11px;">
                                                                            <i class="fa fa-circle text-white me-1 blink"/> Turno Activo
                                                                        </span>
                                                                        <span class="text-dark fw-bold small ms-1 text-truncate" style="max-width: 130px;" t-att-title="st.session_user">
                                                                            <t t-esc="st.session_user"/>
                                                                        </span>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1 fw-semibold" style="font-size: 11px;">
                                                                            <i class="fa fa-power-off me-1"/> Turno Cerrado
                                                                        </span>
                                                                        <span class="text-muted small ms-1">(Listo)</span>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                            <div class="mt-1 small text-muted font-monospace" style="font-size: 10.5px;">
                                                                <t t-if="st.has_active_session and st.session_start">
                                                                    <i class="fa fa-clock-o text-success me-1"/> Inicio: <t t-esc="st.session_start"/>
                                                                </t>
                                                                <t t-elif="st.last_closing_date">
                                                                    <i class="fa fa-history text-muted me-1"/> Cierre: <t t-esc="st.last_closing_date"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <i class="fa fa-info-circle text-muted me-1"/> Listo para apertura en pista
                                                                </t>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- FILA 4: COMBUSTIBLES DISPONIBLES EN LA ESTACIÓN Y BORRADO SEGURO -->
                                                    <div class="pt-2 border-top d-flex align-items-center justify-content-between mt-auto">
                                                        <div class="d-flex gap-1 flex-wrap">
                                                            <t t-foreach="st.fuels" t-as="fuel" t-key="fuel.code">
                                                                <span class="fuel-mini-pill" t-attf-class="fuel-code-#{fuel.code.toLowerCase()}">
                                                                    <t t-esc="fuel.name"/>
                                                                </span>
                                                            </t>
                                                        </div>

                                                        <div t-if="state.isManager and st.can_delete">
                                                            <button class="btn btn-sm btn-outline-danger py-0 px-2" 
                                                                    style="font-size: 10px;"
                                                                    t-on-click="() => this.deleteStation(st)" 
                                                                    title="Eliminar estación vacía sin información asociada">
                                                                <i class="fa fa-trash me-1"/> Borrar
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>

            <!-- MODAL INLINE: CREAR NUEVA EMPRESA -->
            <t t-if="state.showCreateCompanyModal">
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                        <div class="modal-content shadow-lg border-0" style="border-radius: 16px; overflow: hidden; background: #ffffff;">
                            <div class="modal-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                                <h5 class="modal-title fw-bold mb-0 text-white d-flex align-items-center gap-2">
                                    <i class="fa fa-building-o"/> Crear Nueva Empresa
                                </h5>
                                <button type="button" class="btn-close btn-close-white" t-on-click="() => this.closeCreateCompanyModal()" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="row g-3">
                                    <!-- Identificación Fiscal -->
                                    <div class="col-12">
                                        <div class="text-uppercase text-primary fw-bold small pb-1 border-bottom d-flex align-items-center gap-2">
                                            <i class="fa fa-id-card"/> Identificación Fiscal
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-bold text-dark small mb-1">Razón Social / Nombre <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" placeholder="Ej: UTRECAR SUR S.L." t-model="state.newCompanyName"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold text-dark small mb-1">CIF / NIF</label>
                                        <input type="text" class="form-control text-uppercase" placeholder="Ej: B12345678" t-model="state.newCompanyVat"/>
                                    </div>

                                    <!-- Domicilio Fiscal -->
                                    <div class="col-12 mt-3">
                                        <div class="text-uppercase text-primary fw-bold small pb-1 border-bottom d-flex align-items-center gap-2">
                                            <i class="fa fa-map-marker"/> Domicilio Fiscal
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold text-dark small mb-1">Dirección Fiscal / Calle</label>
                                        <input type="text" class="form-control" placeholder="Ej: Av. de la Industria, 14, Nave 3" t-model="state.newCompanyStreet"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold text-dark small mb-1">Código Postal</label>
                                        <input type="text" class="form-control font-monospace" placeholder="Ej: 41710" t-model="state.newCompanyZip"/>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-semibold text-dark small mb-1">Localidad / Población</label>
                                        <input type="text" class="form-control" placeholder="Ej: Utrera" t-model="state.newCompanyCity"/>
                                    </div>

                                    <!-- Contacto y Facturación -->
                                    <div class="col-12 mt-3">
                                        <div class="text-uppercase text-primary fw-bold small pb-1 border-bottom d-flex align-items-center gap-2">
                                            <i class="fa fa-phone"/> Contacto y Facturación
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark small mb-1">Teléfono</label>
                                        <input type="text" class="form-control" placeholder="Ej: 955 86 00 00" t-model="state.newCompanyPhone"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark small mb-1">Correo Electrónico (Facturación)</label>
                                        <input type="email" class="form-control" placeholder="Ej: administracion@utrecar.com" t-model="state.newCompanyEmail"/>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer bg-light py-3 px-4 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.closeCreateCompanyModal()">Cancelar</button>
                                <button type="button" class="btn btn-primary fw-bold" t-att-disabled="state.actionLoading" t-on-click="() => this.submitCreateCompany()">
                                    <i class="fa fa-check me-1"/> Crear Empresa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- MODAL INLINE: CREAR NUEVA ESTACIÓN -->
            <t t-if="state.showCreateStationModal">
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content shadow-lg border-0" style="border-radius: 14px; overflow: hidden; background: #ffffff;">
                            <div class="modal-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                                <h5 class="modal-title fw-bold mb-0 text-white d-flex align-items-center gap-2">
                                    <i class="fa fa-plus-circle"/> Nueva Estación en <t t-esc="state.newStationCompanyName"/>
                                </h5>
                                <button type="button" class="btn-close btn-close-white" t-on-click="() => this.closeCreateStationModal()" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark">Nombre de la Estación <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" placeholder="Ej: E.S. Los Palacios" t-model="state.newStationName"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-muted">IPs VPN de WireGuard (Opcional)</label>
                                    <input type="text" class="form-control font-monospace" placeholder="Ej: 10.8.0.25" t-model="state.newStationVpnIp"/>
                                    <small class="text-muted">Si se conecta desde esta IP, Odoo entrará automáticamente al TPV de esta estación.</small>
                                </div>
                            </div>
                            <div class="modal-footer bg-light py-2 px-4 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.closeCreateStationModal()">Cancelar</button>
                                <button type="button" class="btn btn-primary fw-bold" t-att-disabled="state.actionLoading" t-on-click="() => this.submitCreateStation()">
                                    <i class="fa fa-check me-1"/> Crear Estación
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- MODAL INLINE: MODIFICAR / EDITAR DATOS DE LA EMPRESA -->
            <t t-if="state.showEditCompanyModal or state.showRenameCompanyModal">
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                        <div class="modal-content shadow-lg border-0" style="border-radius: 16px; overflow: hidden; background: #ffffff;">
                            <div class="modal-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                                <h5 class="modal-title fw-bold mb-0 text-white d-flex align-items-center gap-2">
                                    <i class="fa fa-pencil text-white"/> Modificar Datos de la Empresa
                                </h5>
                                <button type="button" class="btn-close btn-close-white" t-on-click="() => this.closeEditCompanyModal()" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="row g-3">
                                    <!-- Identificación Fiscal -->
                                    <div class="col-12">
                                        <div class="text-uppercase text-primary fw-bold small pb-1 border-bottom d-flex align-items-center gap-2">
                                            <i class="fa fa-id-card"/> Identificación Fiscal
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-bold text-dark small mb-1">Razón Social / Nombre <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" t-model="state.editCompanyName"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold text-dark small mb-1">CIF / NIF</label>
                                        <input type="text" class="form-control text-uppercase" placeholder="Ej: B12345678" t-model="state.editCompanyVat"/>
                                    </div>

                                    <!-- Domicilio Fiscal -->
                                    <div class="col-12 mt-3">
                                        <div class="text-uppercase text-primary fw-bold small pb-1 border-bottom d-flex align-items-center gap-2">
                                            <i class="fa fa-map-marker"/> Domicilio Fiscal
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold text-dark small mb-1">Dirección Fiscal / Calle</label>
                                        <input type="text" class="form-control" placeholder="Ej: Av. de la Industria, 14, Nave 3" t-model="state.editCompanyStreet"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold text-dark small mb-1">Código Postal</label>
                                        <input type="text" class="form-control font-monospace" placeholder="Ej: 41710" t-model="state.editCompanyZip"/>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-semibold text-dark small mb-1">Localidad / Población</label>
                                        <input type="text" class="form-control" placeholder="Ej: Utrera" t-model="state.editCompanyCity"/>
                                    </div>

                                    <!-- Contacto y Facturación -->
                                    <div class="col-12 mt-3">
                                        <div class="text-uppercase text-primary fw-bold small pb-1 border-bottom d-flex align-items-center gap-2">
                                            <i class="fa fa-phone"/> Contacto y Facturación
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark small mb-1">Teléfono</label>
                                        <input type="text" class="form-control" placeholder="Ej: 955 86 00 00" t-model="state.editCompanyPhone"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark small mb-1">Correo Electrónico (Facturación)</label>
                                        <input type="email" class="form-control" placeholder="Ej: administracion@utrecar.com" t-model="state.editCompanyEmail"/>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer bg-light py-3 px-4 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.closeEditCompanyModal()">Cancelar</button>
                                <button type="button" class="btn btn-primary fw-bold" t-att-disabled="state.actionLoading" t-on-click="() => this.submitEditCompany()">
                                    <i class="fa fa-check me-1"/> Guardar Cambios
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- MODAL INLINE: RENOMBRAR ESTACIÓN -->
            <t t-if="state.showRenameStationModal">
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content shadow-lg border-0" style="border-radius: 14px; overflow: hidden; background: #ffffff;">
                            <div class="modal-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                                <h5 class="modal-title fw-bold mb-0 text-white d-flex align-items-center gap-2">
                                    <i class="fa fa-pencil text-warning"/> Modificar Nombre de la Estación
                                </h5>
                                <button type="button" class="btn-close btn-close-white" t-on-click="() => this.closeRenameStationModal()" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark">Nombre de la Estación</label>
                                    <input type="text" class="form-control" t-model="state.renameStationName"/>
                                </div>
                            </div>
                            <div class="modal-footer bg-light py-2 px-4 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.closeRenameStationModal()">Cancelar</button>
                                <button type="button" class="btn btn-primary fw-bold" t-att-disabled="state.actionLoading" t-on-click="() => this.submitRenameStation()">
                                    <i class="fa fa-check me-1"/> Guardar Nombre
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
