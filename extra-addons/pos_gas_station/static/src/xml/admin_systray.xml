<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_gas_station.AdminSystrayMenu" owl="1">
        <div class="o_admin_systray_container">
            <!-- Selector de Empresa (Dropdown Pill interactivo a la izquierda del Administrador) -->
            <div class="admin-systray-company-selector" t-if="state.companies and state.companies.length > 0">
                <select class="company-systray-select"
                        t-att-value="state.companyId"
                        t-on-change="(ev) => this.onSwitchCompany(ev.target.value)"
                        title="Cambiar de empresa en cualquier pantalla de Odoo">
                    <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                        <option t-att-value="comp.id" t-att-selected="state.companyId === comp.id">
                            🏢 <t t-esc="comp.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <!-- Cápsula Identificadora del Administrador -->
            <div class="admin-systray-capsule" t-att-title="state.vpnIp ? ('Conectado vía WireGuard VPN ' + state.vpnIp) : 'Administrador activo'">
                <!-- Avatar Icon -->
                <div class="admin-systray-avatar">
                    <i class="fa fa-user"></i>
                </div>

                <!-- Nombre del Administrador -->
                <span class="admin-systray-name">
                    <t t-esc="state.adminName || this.user.name || 'Administrador'"/>
                </span>

                <!-- Separador -->
                <span class="admin-systray-divider">|</span>

                <!-- IP WireGuard VPN -->
                <t t-if="state.vpnIp">
                    <div class="admin-systray-ip" title="IP VPN asignada">
                        <i class="fa fa-wifi text-warning me-1" style="font-size: 0.65rem;"/>
                        <t t-esc="state.vpnIp"/>
                    </div>
                </t>
            </div>

            <!-- Botón Salir al Inicio de Odoo -->
            <button type="button"
                    class="admin-systray-logout-btn"
                    t-on-click="() => this.onLogout()"
                    title="Salir del usuario activo y volver a la selección inicial de gasolinera / administración">
                <i class="fa fa-sign-out"></i>
                <span>Salir</span>
            </button>
        </div>
    </t>

</templates>
