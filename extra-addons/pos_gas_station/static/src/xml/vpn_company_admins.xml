<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_gas_station.VpnCompanyAdminsView" owl="1">
        <div class="vpn-admins-page container-fluid py-3 px-4 bg-light">

            <!-- CABECERA SUPERIOR -->
            <div class="bg-white p-3 rounded-3 shadow-sm border mb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1" style="font-size: 0.75rem;">
                                <i class="fa fa-shield me-1"></i> Seguridad y Multi-Empresa
                            </span>
                        </div>
                        <h3 class="fw-bold mb-1" style="color: #0f172a; font-size: 1.25rem;">
                            <i class="fa fa-user-secret text-primary me-2"></i> Administradores por Empresa (VPN)
                        </h3>
                        <p class="text-muted small mb-0" style="font-size: 0.82rem;">
                            Asignación de administradores con IP WireGuard y permisos vinculantes por empresa en Odoo.
                        </p>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary btn-sm d-flex align-items-center gap-2 fw-bold shadow-sm" t-on-click="() => this.openNewAdminModal()">
                            <i class="fa fa-plus-circle"></i> Nuevo Administrador VPN
                        </button>
                        <button class="btn btn-outline-info btn-sm d-flex align-items-center gap-2 fw-semibold" t-on-click="() => this.openEmployeeCompanyRoles()">
                            <i class="fa fa-users"></i> Expendedores
                        </button>
                        <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 fw-semibold" t-on-click="() => this.openDashboard()">
                            <i class="fa fa-arrow-left"></i> Panel Gasolineras
                        </button>
                        <button class="btn btn-light btn-sm border d-flex align-items-center gap-2 fw-semibold" t-on-click="() => this.loadData()">
                            <i class="fa fa-refresh" t-att-class="state.loading ? 'fa-spin' : ''"></i> Actualizar
                        </button>
                    </div>
                </div>

                <!-- KPI CARDS SUMMARY (RESPONSIVE GRID) -->
                <div class="row g-3 mt-2 mb-2">
                    <!-- Total Registrados -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-stat-card">
                            <div class="kpi-info">
                                <span class="kpi-label">Total Registrados</span>
                                <h3 class="kpi-value"><t t-esc="state.stats.total_admins || state.admins.length"/></h3>
                                <span class="kpi-subtext">Administradores VPN</span>
                            </div>
                            <div class="kpi-icon-box kpi-icon-slate">
                                <i class="fa fa-user-secret"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Empresas Dinámicas -->
                    <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="kpi-stat-card">
                                <div class="kpi-info">
                                    <span class="kpi-label" t-att-title="comp.name">Admins <t t-esc="comp.name"/></span>
                                    <h3 class="kpi-value"><t t-esc="this.getCompanyAdminCount(comp.id)"/></h3>
                                    <span class="kpi-subtext">Acceso autorizado</span>
                                </div>
                                <div t-attf-class="kpi-icon-box #{comp.id === 4 ? 'kpi-icon-blue' : (comp.id === 1 ? 'kpi-icon-amber' : 'kpi-icon-cyan')}">
                                    <i class="fa fa-building"></i>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Gestión Personal -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-stat-card">
                            <div class="kpi-info">
                                <span class="kpi-label">Gestión Personal</span>
                                <h3 class="kpi-value"><t t-esc="state.stats.can_manage_staff_count || 0"/></h3>
                                <span class="kpi-subtext">Permisos avanzados</span>
                            </div>
                            <div class="kpi-icon-box kpi-icon-purple">
                                <i class="fa fa-users-cog"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BUSCADOR Y FILTROS -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top">
                    <div class="position-relative" style="min-width: 280px; flex: 1; max-width: 450px;">
                        <i class="fa fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" 
                               class="form-control form-control-sm ps-5 rounded-pill border-secondary-subtle" 
                               placeholder="Buscar por persona, IP VPN (ej: 10.8.0.2) o usuario..."
                               t-model="state.searchTerm"/>
                        <button t-if="state.searchTerm" 
                                class="btn btn-sm btn-link text-muted position-absolute top-50 end-0 translate-middle-y me-2 p-0"
                                t-on-click="() => this.clearSearch()">
                            <i class="fa fa-times-circle"></i>
                        </button>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm fw-semibold rounded-pill px-3"
                                t-att-class="state.filterCompany === 'all' ? 'btn-dark' : 'btn-outline-secondary'"
                                style="font-size: 0.8rem;"
                                t-on-click="() => this.setFilter('all')">
                            Todos (<t t-esc="state.admins.length"/>)
                        </button>
                        <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                            <button class="btn btn-sm fw-semibold rounded-pill px-3"
                                    t-att-class="state.filterCompany === comp.id ? 'btn-primary' : 'btn-outline-secondary'"
                                    style="font-size: 0.8rem;"
                                    t-on-click="() => this.setFilter(comp.id)">
                                <t t-esc="comp.name"/> (<t t-esc="this.getCompanyAdminCount(comp.id)"/>)
                            </button>
                        </t>
                        <button class="btn btn-sm fw-semibold rounded-pill px-3"
                                t-att-class="state.filterCompany === 'staff' ? 'text-white' : 'btn-outline-secondary'"
                                t-attf-style="font-size: 0.8rem; #{state.filterCompany === 'staff' ? 'background: #7c3aed; border-color: #7c3aed;' : ''}"
                                t-on-click="() => this.setFilter('staff')">
                            <i class="fa fa-users-cog me-1"></i> Gestión Personal (<t t-esc="state.stats.can_manage_staff_count || 0"/>)
                        </button>
                    </div>
                </div>
            </div>

            <!-- CONTENIDO PRINCIPAL: TABLA DE ADMINISTRADORES (COMPACTA) -->
            <div class="bg-white rounded-3 shadow-sm border overflow-hidden">
                <t t-if="state.loading">
                    <div class="text-center py-5">
                        <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"></i>
                        <p class="text-muted">Cargando administradores VPN...</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light border-bottom">
                                <tr>
                                    <th class="ps-3 py-2 text-uppercase small text-muted fw-bold" style="min-width: 250px;">Persona Física / VPN</th>
                                    <th class="text-center py-2 text-uppercase small text-muted fw-bold" style="width: 170px;">
                                        <i class="fa fa-users-cog text-purple me-1" style="color: #7c3aed;"></i> Gestión Personal
                                    </th>
                                    <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                                        <th class="text-center py-2 border-start text-uppercase small text-muted fw-bold" style="width: 175px; min-width: 155px;">
                                            <i class="fa fa-building text-primary me-1"></i>
                                            <t t-esc="comp.name"/>
                                        </th>
                                    </t>
                                    <th class="text-center pe-3 py-2 text-uppercase small text-muted fw-bold" style="width: 80px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="!filteredAdmins.length">
                                    <tr>
                                        <td t-att-colspan="3 + state.companies.length" class="text-center py-5">
                                            <i class="fa fa-user-secret fa-3x text-muted mb-3 opacity-50 d-block"></i>
                                            <h5 class="fw-bold text-secondary">No se encontraron administradores VPN</h5>
                                            <p class="text-muted small">Pruebe ajustando los términos de búsqueda o filtros, o registre uno nuevo.</p>
                                            <button class="btn btn-primary btn-sm fw-bold" t-on-click="() => this.openNewAdminModal()">
                                                <i class="fa fa-plus-circle me-1"></i> Registrar Administrador VPN
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-foreach="filteredAdmins" t-as="admin" t-key="admin.id">
                                        <tr>
                                            <!-- PERSONA FÍSICA Y DATOS DE CONEXIÓN -->
                                            <td class="ps-3 py-2">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0"
                                                         style="width: 36px; height: 36px; font-size: 0.9rem; background: linear-gradient(135deg, #0f172a, #2563eb);">
                                                        <t t-esc="this.getAdminInitials(admin)"/>
                                                    </div>
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold text-dark" style="font-size: 0.92rem;"><t t-esc="admin.name"/></span>
                                                            <span class="badge bg-light text-dark border font-monospace px-1.5 py-0.5" style="font-size: 0.74rem;">
                                                                <i class="fa fa-wifi me-1 text-primary"/> <t t-esc="admin.vpn_ip"/>
                                                            </span>
                                                        </div>
                                                        <div class="small text-muted d-flex align-items-center gap-1 mt-0.5" style="font-size: 0.78rem;">
                                                            <t t-if="admin.user_login">
                                                                <span><i class="fa fa-user me-1 text-secondary"></i> <t t-esc="admin.user_name"/> (<t t-esc="admin.user_login"/>)</span>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-warning"><i class="fa fa-exclamation-triangle me-1"></i> Sin usuario Odoo vinculado</span>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- CHECK GESTION DE PERSONAL Y ADMINISTRADORES -->
                                            <td class="text-center py-2">
                                                <div class="d-flex flex-column align-items-center justify-content-center">
                                                    <div class="form-check form-switch m-0" title="Autorizar a este usuario a gestionar empleados y administradores">
                                                        <input class="form-check-input" 
                                                               type="checkbox" 
                                                               style="width: 2.3rem; height: 1.15rem; cursor: pointer;"
                                                               t-att-checked="admin.can_manage_staff"
                                                               t-att-disabled="this.isUpdatingKey('can_manage_staff_' + admin.id)"
                                                               t-on-click="() => this.toggleField(admin, 'can_manage_staff', admin.can_manage_staff)"/>
                                                    </div>
                                                    <div class="mt-1" style="font-size: 0.76rem;">
                                                        <t t-if="admin.can_manage_staff">
                                                            <span class="badge border fw-semibold px-2 py-0.5" style="background: #f5f3ff; color: #7c3aed; border-color: #ddd6fe !important;">
                                                                <i class="fa fa-check me-1"/> Autorizado
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-light text-muted border px-2 py-0.5">Sin permiso</span>
                                                        </t>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- COLUMNAS DE EMPRESAS (SWITCH ASIGNACIÓN) -->
                                            <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                                                <td class="text-center py-2 border-start" t-attf-class="#{this.isCompanyAssigned(admin, comp.id) ? 'bg-primary-subtle bg-opacity-10' : ''}">
                                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                                        <div class="form-check form-switch m-0" t-attf-title="Asignar o desasignar como administrador de #{comp.name}">
                                                            <input class="form-check-input" 
                                                                   type="checkbox" 
                                                                   style="width: 2.3rem; height: 1.15rem; cursor: pointer;"
                                                                   t-att-checked="this.isCompanyAssigned(admin, comp.id)"
                                                                   t-att-disabled="this.isUpdatingKey('comp_' + admin.id + '_' + comp.id)"
                                                                   t-on-click="() => this.toggleCompany(admin, comp.id, this.isCompanyAssigned(admin, comp.id))"/>
                                                        </div>
                                                        <div>
                                                            <t t-if="this.isUpdatingKey('comp_' + admin.id + '_' + comp.id)">
                                                                <span class="badge bg-light text-primary border px-2 py-0.5" style="font-size: 0.76rem;">...</span>
                                                            </t>
                                                            <t t-elif="this.isCompanyAssigned(admin, comp.id)">
                                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 fw-semibold" style="font-size: 0.76rem;">
                                                                    <i class="fa fa-shield me-1"/> Administrador
                                                                </span>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="badge bg-light text-muted border px-2 py-0.5" style="font-size: 0.76rem; opacity: 0.65;">
                                                                    Sin acceso
                                                                </span>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </td>
                                            </t>

                                            <!-- ACCIONES -->
                                            <td class="text-center pe-3 py-2">
                                                <button class="btn btn-sm btn-outline-secondary rounded-circle" 
                                                        style="width: 28px; height: 28px; padding: 0;"
                                                        t-on-click="() => this.editAdmin(admin)"
                                                        title="Modificar datos del administrador">
                                                    <i class="fa fa-pencil" style="font-size: 0.8rem;"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>

            <!-- MODAL DE CREACIÓN / EDICIÓN -->
            <div t-if="state.showModal" class="modal-backdrop-custom d-flex align-items-center justify-content-center">
                <div class="modal-card-custom bg-white rounded-3 shadow-lg p-4 border" style="max-width: 520px; width: 100%;">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="fa fa-user-secret text-primary me-2"></i>
                            <t t-esc="state.modalAdminId ? 'Modificar Administrador VPN' : 'Nuevo Administrador VPN'"/>
                        </h5>
                        <button class="btn-close" t-on-click="() => this.closeModal()"></button>
                    </div>

                    <div t-if="state.modalError" class="alert alert-danger py-2 small mb-3">
                        <i class="fa fa-exclamation-circle me-1"></i> <t t-esc="state.modalError"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Persona Física / Nombre del Equipo <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="Ej: Alfonso Portatil, Jose (Informático)" t-model="state.modalName"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">IP WireGuard VPN <span class="text-danger">*</span></label>
                        <input type="text" class="form-control font-monospace" placeholder="Ej: 10.8.0.8" t-model="state.modalVpnIp"/>
                        <small class="text-muted">Debe coincidir con la IP asignada en el cliente WireGuard.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Usuario Odoo Vinculado</label>
                        <select class="form-select" t-on-change="(ev) => this.onSelectUser(ev.target.value)">
                            <option value="" t-att-selected="!state.modalUserId">-- Sin usuario específico (utilizará Superadmin) --</option>
                            <t t-foreach="state.users" t-as="u" t-key="u.id">
                                <option t-att-value="u.id" t-att-selected="this.isUserSelected(u.id)"><t t-esc="u.name"/> (<t t-esc="u.login"/>)</option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted d-block">Empresas Autorizadas</label>
                        <div class="d-flex flex-wrap gap-2">
                            <t t-foreach="state.companies" t-as="c" t-key="c.id">
                                <button type="button" 
                                        class="btn btn-sm rounded-pill px-3 fw-semibold"
                                        t-att-class="this.isModalCompanySelected(c.id) ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.toggleModalCompany(c.id)">
                                    <i t-attf-class="fa #{this.isModalCompanySelected(c.id) ? 'fa-check' : 'fa-plus'} me-1"/>
                                    <t t-esc="c.name"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="modalStaffCheck" t-model="state.modalCanManageStaff"/>
                            <label class="form-check-label fw-bold small" for="modalStaffCheck">
                                <i class="fa fa-users-cog text-purple me-1" style="color: #7c3aed;"></i>
                                Autorizar Gestión de Personal y Administradores
                            </label>
                        </div>
                        <small class="text-muted d-block mt-1">Si está desmarcado, el usuario no verá el menú "Usuarios" ni podrá modificar accesos.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <button class="btn btn-outline-secondary fw-semibold" t-on-click="() => this.closeModal()">Cancelar</button>
                        <button class="btn btn-primary fw-bold px-4" t-att-disabled="state.modalLoading" t-on-click="() => this.saveModalAdmin()">
                            <i t-if="state.modalLoading" class="fa fa-spin fa-spinner me-1"/>
                            Guardar Administrador
                        </button>
                    </div>
                </div>
            </div>

            <!-- NOTA AL PIE -->
            <div class="mt-3 p-3 bg-white rounded-3 border d-flex align-items-center gap-3">
                <i class="fa fa-info-circle text-primary fs-5"></i>
                <div class="small text-muted" style="font-size: 0.8rem;">
                    <strong>Administración Multi-Empresa por VPN:</strong>
                    Al ingresar desde una IP autorizada, el usuario verá en la pantalla inicial los botones específicos para administrar las empresas asignadas. Al pulsar sobre una empresa, la sesión de administración se aísla exclusivamente a esa entidad.
                </div>
            </div>

        </div>
    </t>

</templates>
