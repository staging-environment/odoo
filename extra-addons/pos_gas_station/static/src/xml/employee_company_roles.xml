<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_gas_station.EmployeeCompanyRolesView" owl="1">
        <div class="emp-roles-page employee-company-roles-view container-fluid py-4 px-4 bg-light" data-page="employee_company_roles" style="min-height: 100vh;">

            <!-- CABECERA SUPERIOR -->
            <div class="bg-white p-4 rounded-3 shadow-sm border mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">
                                <i class="fa fa-id-badge me-1"></i> Control de Accesos a TPV
                            </span>
                        </div>
                        <h2 class="fw-bold mb-1" style="color: #0f172a;">
                            <i class="fa fa-users text-primary me-2"></i> Expendedores
                        </h2>
                        <p class="text-muted small mb-0">
                            Activación de empleados por empresa para permitir la apertura de turno y cobro en el TPV de pista.
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary d-flex align-items-center gap-2 fw-bold" t-on-click="() => this.openDashboard()">
                            <i class="fa fa-arrow-left"></i> Panel de Gasolineras
                        </button>
                        <button class="btn btn-primary d-flex align-items-center gap-2 fw-bold shadow-sm" t-on-click="() => this.loadData()">
                            <i class="fa fa-refresh" t-att-class="state.loading ? 'fa-spin' : ''"></i> Actualizar
                        </button>
                    </div>
                </div>

                <!-- KPI CARDS SUMMARY (SCROLL HORIZONTAL SI HAY MUCHAS EMPRESAS) -->
                <div class="d-flex flex-nowrap overflow-auto gap-3 mt-3 pb-2 kpi-cards-scroll-container">
                    <div style="flex: 0 0 220px;">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3 h-100">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                                <i class="fa fa-users fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">Total Personal</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.total_users || state.users.length"/></h3>
                            </div>
                        </div>
                    </div>

                    <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                        <div style="flex: 0 0 240px;">
                            <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3 h-100">
                                <div class="rounded-3 p-3 text-white" t-attf-style="background: #{comp.id === 4 ? 'linear-gradient(135deg, #1d4ed8, #1e40af)' : (comp.id === 1 ? 'linear-gradient(135deg, #b45309, #92400e)' : 'linear-gradient(135deg, #0284c7, #0369a1)')};">
                                    <i class="fa fa-building fs-3"></i>
                                </div>
                                <div>
                                    <span class="text-muted small fw-semibold d-block text-truncate" style="max-width: 150px;" t-att-title="comp.name">En <t t-esc="comp.name"/></span>
                                    <h3 class="fw-bold mb-0 text-dark"><t t-esc="(state.stats.company_counts and state.stats.company_counts[comp.id]) or (comp.id === 4 ? state.stats.trieste_count : (comp.id === 1 ? state.stats.utrecar_count : 0))"/></h3>
                                </div>
                            </div>
                        </div>
                    </t>

                    <div style="flex: 0 0 220px;">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3 h-100">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #7c3aed, #6d28d9);">
                                <i class="fa fa-exchange fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">Multi-Empresa</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.multi_count || 0"/></h3>
                            </div>
                        </div>
                    </div>

                    <div style="flex: 0 0 220px;">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3 h-100">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #dc2626, #991b1b);">
                                <i class="fa fa-user-times fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">Sin Asignación</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.none_count || 0"/></h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BARRA DE BÚSQUEDA Y FILTROS -->
            <div class="bg-white p-3 rounded-3 shadow-sm border mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 500px;">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fa fa-search text-muted"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 bg-light"
                               placeholder="Buscar por nombre, email o DNI..."
                               t-model="state.searchTerm"/>
                        <button t-if="state.searchTerm" class="btn btn-outline-secondary border-start-0 bg-light" t-on-click="() => state.searchTerm = ''">
                            ✖
                        </button>
                    </div>
                </div>

                <!-- FILTROS POR EMPRESA -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small fw-bold">Empresa:</span>
                    <div class="btn-group btn-group-sm shadow-none flex-wrap" role="group">
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'all' ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('all')">
                            Todas
                        </button>
                        <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                            <button type="button"
                                    t-attf-class="btn #{state.filterCompany === comp.id ? 'btn-primary' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.setCompanyFilter(comp.id)">
                                <t t-esc="comp.name"/>
                            </button>
                        </t>
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'multi' ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('multi')">
                            Multi-Empresa
                        </button>
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'none' ? 'btn-danger' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('none')">
                            Sin Asignación
                        </button>
                    </div>
                </div>
            </div>

            <!-- TABLA PRINCIPAL DE ASIGNACIÓN -->
            <div class="bg-white rounded-3 shadow-sm border overflow-hidden">
                <t t-if="state.loading">
                    <div class="text-center py-5">
                        <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"></i>
                        <p class="text-muted">Cargando directorio de personal y permisos...</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="employee-roles-table-wrapper table-responsive">
                        <table class="table table-hover align-middle mb-0" style="min-width: 100%;">
                            <thead class="table-light border-bottom position-sticky top-0" style="z-index: 10;">
                                <tr>
                                    <th style="width: 50px; min-width: 50px; left: 0; z-index: 12;" class="sticky-cell text-center"></th>
                                    <th style="width: 280px; min-width: 280px; left: 50px; z-index: 12;" class="sticky-cell">Empleado / Usuario</th>
                                    <th style="width: 170px; min-width: 170px; left: 330px; z-index: 12;" class="sticky-cell sticky-cell-divider">Identificación</th>
                                    
                                    <!-- COLUMNAS DINÁMICAS POR EMPRESA -->
                                    <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                                        <th style="min-width: 280px; width: 280px;" class="text-center py-3"
                                            t-attf-style="background-color: #{comp.id === 4 ? '#eff6ff' : (comp.id === 1 ? '#fffbeb' : '#f8fafc')};">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <span class="badge py-2 px-3 fw-bold shadow-sm"
                                                      t-attf-style="background: #{comp.id === 4 ? '#1d4ed8' : (comp.id === 1 ? '#b45309' : '#0284c7')}; color: white; border-radius: 8px; font-size: 0.85rem;">
                                                    <i class="fa fa-building me-1"/> <t t-esc="comp.name.toUpperCase()"/>
                                                </span>
                                            </div>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="filteredUsers.length === 0">
                                    <tr>
                                        <td t-att-colspan="3 + state.companies.length" class="text-center py-5 text-muted">
                                            <i class="fa fa-info-circle fa-2x mb-2 d-block text-secondary"></i>
                                            No se encontraron empleados con los filtros aplicados.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="filteredUsers" t-as="u" t-key="u.odoo_user_id">
                                    <tr>
                                        <!-- AVATAR (STICKY) -->
                                        <td class="sticky-cell text-center" style="left: 0; z-index: 5;">
                                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                                 t-attf-style="background: #{u.avatar_gradient}; width: 38px; height: 38px; font-size: 0.85rem;">
                                                <t t-esc="u.initials"/>
                                            </div>
                                        </td>

                                        <!-- NOMBRE Y CORREO (STICKY) -->
                                        <td class="sticky-cell" style="left: 50px; z-index: 5;">
                                            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                                <t t-esc="u.name"/>
                                                <span t-if="u.active_company_count === 0" class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold" style="font-size: 0.72rem;">
                                                    <i class="fa fa-ban me-1"/> Inactivo
                                                </span>
                                            </div>
                                            <div class="text-muted small"><t t-esc="u.email"/></div>
                                        </td>

                                        <!-- DNI Y CÓDIGO (STICKY CON BORDE DERECHO VISIBLE) -->
                                        <td class="sticky-cell sticky-cell-divider" style="left: 330px; z-index: 5;">
                                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                                <span t-if="u.dni and u.dni !== '-'" class="badge bg-light text-dark border font-monospace">
                                                    <i class="fa fa-id-card-o text-muted me-1"/> <t t-esc="u.dni"/>
                                                </span>
                                                <span t-if="u.code" class="badge bg-light text-muted border font-monospace" style="font-size: 0.75rem;">
                                                    #<t t-esc="u.code"/>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- COLUMNAS DE ACCESO POR EMPRESA -->
                                        <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                                            <t t-set="acc" t-value="u.company_access and u.company_access[comp.id]"/>
                                            <t t-set="isUpdating" t-value="state.updatingKey === u.odoo_user_id + '_' + comp.id"/>

                                            <td class="border-start text-center p-3" t-attf-class="#{acc and acc.active ? 'bg-primary-subtle bg-opacity-10' : ''}">
                                                <div class="d-flex align-items-center justify-content-center gap-3">
                                                    <!-- SWITCH ACCESO -->
                                                    <div class="form-check form-switch m-0" t-attf-title="Activar o desactivar acceso a #{comp.name}">
                                                        <input class="form-check-input" 
                                                               type="checkbox" 
                                                               style="width: 2.8rem; height: 1.4rem; cursor: pointer;"
                                                               t-att-checked="acc and acc.active"
                                                               t-att-disabled="isUpdating"
                                                               t-on-click="() => this.toggleCompanyAccess(u, comp.id, acc ? acc.active : false)"/>
                                                    </div>

                                                    <!-- BADGE ESTADO -->
                                                    <div style="min-width: 140px;" class="text-start">
                                                        <t t-if="isUpdating">
                                                            <span class="badge bg-light text-primary border px-3 py-2 fw-semibold">
                                                                <i class="fa fa-spin fa-spinner me-1"/> Actualizando...
                                                            </span>
                                                        </t>
                                                        <t t-elif="acc and acc.active">
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold" style="font-size: 0.85rem;">
                                                                <i class="fa fa-check-circle me-1"/> Activo (TPV)
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-light text-muted border px-3 py-2 fw-normal" style="font-size: 0.85rem; opacity: 0.75;">
                                                                <i class="fa fa-ban me-1"/> Sin acceso
                                                            </span>
                                                        </t>
                                                    </div>
                                                </div>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>

            <!-- NOTA AL PIE -->
            <div class="mt-3 p-3 bg-white rounded-3 border d-flex align-items-center gap-3">
                <i class="fa fa-info-circle text-primary fs-4"></i>
                <div class="small text-muted">
                    <strong>Control de acceso a TPV por empresa:</strong>
                    Los empleados con estado <strong>Activo (TPV)</strong> en cada empresa son los únicos que pueden identificarse y abrir turno en las terminales de esa empresa, contando con facultades completas para operar el TPV. El acceso de administración a Odoo está estrictamente reservado a las IPs de VPN autorizadas (10.8.0.2, 10.8.0.3, 10.8.0.8, 10.8.0.19).
                </div>
            </div>
        </div>
    </t>

</templates>
