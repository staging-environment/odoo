<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_gas_station.EmployeeCompanyRolesView" owl="1">
        <div class="emp-roles-page container-fluid py-4 px-4 bg-light" style="min-height: 100vh;">

            <!-- OVERLAY TRANSPARENTE PARA CERRAR SELECTOR MULTI-ROL -->
            <div t-if="state.activeDropdownKey" class="dropdown-backdrop-transparent" t-on-click="() => this.closeDropdown()"/>

            <!-- CABECERA SUPERIOR -->
            <div class="bg-white p-4 rounded-3 shadow-sm border mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">
                                <i class="fa fa-id-badge me-1"></i> Control de Accesos y Seguridad
                            </span>
                        </div>
                        <h2 class="fw-bold mb-1" style="color: #0f172a;">
                            <i class="fa fa-users text-primary me-2"></i> Personal, Empresas y Roles
                        </h2>
                        <p class="text-muted small mb-0">
                            Gestión centralizada de asignación multi-empresa y roles específicos de cada empleado en A.R. Trieste y Utrecar S.L.
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary d-flex align-items-center gap-2 fw-bold" t-on-click="() => this.openDashboard()">
                            <i class="fa fa-arrow-left"></i> Panel de Gasolineras
                        </button>
                        <button class="btn btn-primary d-flex align-items-center gap-2 fw-bold shadow-sm" t-on-click="() => this.loadData()">
                            <i class="fa fa-refresh" t-att-class="state.loading ? 'fa-spin' : ''"></i> Actualizar
                        </button>
                    </div>
                </div>

                <!-- KPI CARDS SUMMARY -->
                <div class="row g-3 mt-3">
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                                <i class="fa fa-users fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">Total Personal</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.total_users || state.users.length"/></h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #1d4ed8, #1e40af);">
                                <i class="fa fa-building fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">En A.R. Trieste</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.trieste_count || 0"/></h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #b45309, #92400e);">
                                <i class="fa fa-building-o fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">En Utrecar S.L.</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.utrecar_count || 0"/></h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #7c3aed, #6d28d9);">
                                <i class="fa fa-exchange fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">Multi-Empresa</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.multi_count || 0"/></h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl">
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center gap-3">
                            <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #dc2626, #991b1b);">
                                <i class="fa fa-user-times fs-3"></i>
                            </div>
                            <div>
                                <span class="text-muted small fw-semibold d-block">Sin Asignación</span>
                                <h3 class="fw-bold mb-0 text-dark"><t t-esc="state.stats.none_count || 0"/></h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BARRA DE BÚSQUEDA Y FILTROS -->
            <div class="bg-white p-3 rounded-3 shadow-sm border mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 500px;">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fa fa-search text-muted"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 bg-light"
                               placeholder="Buscar por nombre, email o DNI..."
                               t-model="state.searchTerm"/>
                        <button t-if="state.searchTerm" class="btn btn-outline-secondary border-start-0 bg-light" t-on-click="() => state.searchTerm = ''">
                            ✖
                        </button>
                    </div>
                </div>

                <!-- FILTROS POR EMPRESA -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small fw-bold">Empresa:</span>
                    <div class="btn-group btn-group-sm shadow-none" role="group">
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'all' ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('all')">
                            Todas
                        </button>
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'trieste' ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('trieste')">
                            A.R. Trieste
                        </button>
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'utrecar' ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('utrecar')">
                            Utrecar S.L.
                        </button>
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'multi' ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('multi')">
                            Multi-Empresa
                        </button>
                        <button type="button"
                                t-attf-class="btn #{state.filterCompany === 'none' ? 'btn-danger' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setCompanyFilter('none')">
                            Sin Asignación
                        </button>
                    </div>

                    <!-- FILTRO POR ROL -->
                    <span class="text-muted small fw-bold ms-3">Rol:</span>
                    <select class="form-select form-select-sm" style="width: auto;" t-model="state.filterRole">
                        <option value="all">Todos los roles</option>
                        <option value="employee">EMPLEADO</option>
                        <option value="manager">GESTOR</option>
                        <option value="ceo">CEO</option>
                        <option value="admin_hr">ADMINISTRACION</option>
                    </select>
                </div>
            </div>

            <!-- TABLA PRINCIPAL DE ASIGNACIÓN MULTI-EMPRESA Y MULTI-ROL -->
            <div class="bg-white rounded-3 shadow-sm border overflow-hidden">
                <t t-if="state.loading">
                    <div class="text-center py-5">
                        <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"></i>
                        <p class="text-muted">Cargando directorio de personal y permisos...</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th style="width: 45px;" class="text-center"></th>
                                    <th style="min-width: 250px;">Empleado / Usuario</th>
                                    <th style="min-width: 140px;">Identificación</th>
                                    
                                    <!-- COLUMNA A.R. TRIESTE -->
                                    <th style="min-width: 320px;" class="company-header-trieste text-center py-3">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <span class="badge-company-trieste">
                                                <i class="fa fa-building me-1"/> A.R. TRIESTE
                                            </span>
                                        </div>
                                        <span class="text-secondary small fw-semibold font-monospace d-block mt-1">Estación: E.S. Repsol (Pista)</span>
                                    </th>

                                    <!-- COLUMNA UTRECAR S.L. -->
                                    <th style="min-width: 320px;" class="company-header-utrecar text-center py-3">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <span class="badge-company-utrecar">
                                                <i class="fa fa-building-o me-1"/> UTRECAR S.L.
                                            </span>
                                        </div>
                                        <span class="text-secondary small fw-semibold font-monospace d-block mt-1">Estaciones: Vistalegre, Ronda Norte, etc.</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="filteredUsers.length === 0">
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="fa fa-info-circle fa-2x mb-2 d-block text-secondary"></i>
                                            No se encontraron empleados con los filtros aplicados.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="filteredUsers" t-as="u" t-key="u.odoo_user_id">
                                    <tr>
                                        <!-- AVATAR -->
                                        <td class="text-center">
                                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                                 t-attf-style="background: #{u.avatar_gradient}; width: 38px; height: 38px; font-size: 0.85rem;">
                                                <t t-esc="u.initials"/>
                                            </div>
                                        </td>

                                        <!-- NOMBRE Y CORREO -->
                                        <td>
                                            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                                <t t-esc="u.name"/>
                                                <span t-if="u.active_company_count === 0" class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold" style="font-size: 0.72rem;">
                                                    <i class="fa fa-ban me-1"/> Sin empresa (Inactivo)
                                                </span>
                                            </div>
                                            <div class="text-muted small"><t t-esc="u.email"/></div>
                                        </td>

                                        <!-- DNI Y CÓDIGO -->
                                        <td>
                                            <span class="badge bg-light text-dark border font-monospace me-1">
                                                <i class="fa fa-id-card me-1"/> <t t-esc="u.dni"/>
                                            </span>
                                            <span class="text-muted small font-monospace">#<t t-esc="u.code"/></span>
                                        </td>

                                        <!-- EMPRESA 1: A.R. TRIESTE (ID 4) -->
                                        <td class="border-start text-center p-3 position-relative" t-attf-class="#{u.company_access and u.company_access[4] and u.company_access[4].active ? 'bg-primary-subtle bg-opacity-25' : ''}">
                                            <t t-set="accTrieste" t-value="u.company_access and u.company_access[4]"/>
                                            <t t-set="isUpdatingTrieste" t-value="state.updatingKey === u.odoo_user_id + '_4'"/>
                                            <t t-set="isOpenTrieste" t-value="state.activeDropdownKey === u.odoo_user_id + '_4'"/>

                                            <div class="d-flex align-items-center justify-content-center gap-3">
                                                <!-- SWITCH ACCESO -->
                                                <div class="form-check form-switch m-0" title="Activar o desactivar acceso a A.R. Trieste">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           style="width: 2.8rem; height: 1.4rem; cursor: pointer;"
                                                           t-att-checked="accTrieste and accTrieste.active"
                                                           t-att-disabled="isUpdatingTrieste"
                                                           t-on-click="() => this.toggleCompanyAccess(u, 4, accTrieste ? accTrieste.active : false)"/>
                                                </div>

                                                <!-- SELECTOR MULTI-ROL EN TRIESTE -->
                                                <div class="position-relative role-selector-container">
                                                    <t t-if="accTrieste and accTrieste.active">
                                                        <button type="button" 
                                                                class="btn btn-sm role-selector-btn d-flex align-items-center justify-content-between gap-2 shadow-sm"
                                                                t-attf-class="#{isOpenTrieste ? 'border-primary' : ''}"
                                                                t-att-disabled="isUpdatingTrieste"
                                                                t-on-click="() => this.toggleDropdown(u.odoo_user_id + '_4')"
                                                                title="Haga clic para asignar o quitar roles en A.R. Trieste">
                                                            
                                                            <div class="d-flex align-items-center gap-1 flex-wrap text-start role-badges-summary">
                                                                <t t-if="accTrieste.roles and accTrieste.roles.length > 0">
                                                                    <t t-foreach="accTrieste.roles" t-as="r" t-key="r.id">
                                                                        <span class="badge role-pill shadow-xs" 
                                                                              t-attf-style="background-color: #{r.color || '#0284c7'}; color: #fff;">
                                                                            <t t-esc="r.name"/>
                                                                        </span>
                                                                    </t>
                                                                </t>
                                                                <t t-elif="accTrieste.role_name and accTrieste.role_name !== 'Sin Rol'">
                                                                    <span class="badge role-pill shadow-xs" 
                                                                          t-attf-style="background-color: #{accTrieste.role_color || '#0284c7'}; color: #fff;">
                                                                        <t t-esc="accTrieste.role_name"/>
                                                                    </span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge bg-warning-subtle text-dark border px-2 py-1 font-monospace" style="font-size: 0.75rem;">
                                                                        <i class="fa fa-exclamation-triangle text-warning me-1"/> Sin Rol
                                                                    </span>
                                                                </t>
                                                            </div>

                                                            <div class="ms-1 text-muted d-flex align-items-center">
                                                                <i t-if="isUpdatingTrieste" class="fa fa-spin fa-spinner text-primary"/>
                                                                <i t-else="" class="fa fa-caret-down fs-6" t-att-class="isOpenTrieste ? 'text-primary' : 'text-secondary'"/>
                                                            </div>
                                                        </button>

                                                        <!-- DROPDOWN FLOTANTE MULTI-ROL -->
                                                        <div t-if="isOpenTrieste" class="role-dropdown-popover shadow-lg border rounded-3 bg-white text-start">
                                                            <div class="popover-header px-3 py-2 bg-light border-bottom d-flex align-items-center justify-content-between">
                                                                <span class="fw-bold small text-dark">
                                                                    <i class="fa fa-shield text-primary me-1"/> Roles en A.R. Trieste
                                                                </span>
                                                                <button type="button" class="btn btn-sm btn-link text-muted p-0 border-0" t-on-click="() => this.closeDropdown()">✖</button>
                                                            </div>

                                                            <div class="popover-body p-2">
                                                                <t t-foreach="state.roles" t-as="r" t-key="r.id">
                                                                    <t t-set="isRoleChecked" t-value="this.hasCompanyRole(u, 4, r.id)"/>
                                                                    <div class="role-option-item d-flex align-items-center justify-content-between px-3 py-2 rounded mb-1 cursor-pointer"
                                                                         t-attf-class="#{isRoleChecked ? 'bg-primary-subtle text-primary fw-bold' : 'text-dark'}"
                                                                         t-on-click="() => this.toggleCompanyRole(u, 4, r.id)">
                                                                        <div class="d-flex align-items-center gap-2">
                                                                            <span class="role-dot rounded-circle" t-attf-style="background-color: #{r.color || '#0284c7'}; width: 10px; height: 10px; display: inline-block;"/>
                                                                            <span class="role-name-text"><t t-esc="r.name"/></span>
                                                                        </div>
                                                                        <div>
                                                                            <i t-if="isRoleChecked" class="fa fa-check-square text-primary fs-5"/>
                                                                            <i t-else="" class="fa fa-square-o text-muted fs-5"/>
                                                                        </div>
                                                                    </div>
                                                                </t>
                                                            </div>

                                                            <div class="popover-footer px-3 py-2 bg-light border-top d-flex justify-content-between align-items-center">
                                                                <small class="text-muted" style="font-size: 0.72rem;">Puede marcar más de un rol</small>
                                                                <button type="button" class="btn btn-sm btn-primary py-1 px-3 fw-bold" style="font-size: 0.75rem;" t-on-click="() => this.closeDropdown()">
                                                                    Listo
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="btn btn-sm btn-light border text-muted disabled" style="min-width: 190px; opacity: 0.6; cursor: not-allowed;">
                                                            <i class="fa fa-lock me-1"/> Sin acceso
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>

                                            <div class="mt-1 small">
                                                <span t-if="accTrieste and accTrieste.active" class="status-badge-active-trieste">
                                                    <i class="fa fa-check me-1"/> Autorizado en Trieste
                                                </span>
                                                <span t-else="" class="status-badge-inactive">
                                                    <i class="fa fa-ban me-1"/> Sin acceso
                                                </span>
                                            </div>
                                        </td>

                                        <!-- EMPRESA 2: UTRECAR S.L. (ID 1) -->
                                        <td class="border-start text-center p-3 position-relative" t-attf-class="#{u.company_access and u.company_access[1] and u.company_access[1].active ? 'bg-warning-subtle bg-opacity-25' : ''}">
                                            <t t-set="accUtrecar" t-value="u.company_access and u.company_access[1]"/>
                                            <t t-set="isUpdatingUtrecar" t-value="state.updatingKey === u.odoo_user_id + '_1'"/>
                                            <t t-set="isOpenUtrecar" t-value="state.activeDropdownKey === u.odoo_user_id + '_1'"/>

                                            <div class="d-flex align-items-center justify-content-center gap-3">
                                                <!-- SWITCH ACCESO -->
                                                <div class="form-check form-switch m-0" title="Activar o desactivar acceso a Utrecar S.L.">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           style="width: 2.8rem; height: 1.4rem; cursor: pointer;"
                                                           t-att-checked="accUtrecar and accUtrecar.active"
                                                           t-att-disabled="isUpdatingUtrecar"
                                                           t-on-click="() => this.toggleCompanyAccess(u, 1, accUtrecar ? accUtrecar.active : false)"/>
                                                </div>

                                                <!-- SELECTOR MULTI-ROL EN UTRECAR -->
                                                <div class="position-relative role-selector-container">
                                                    <t t-if="accUtrecar and accUtrecar.active">
                                                        <button type="button" 
                                                                class="btn btn-sm role-selector-btn d-flex align-items-center justify-content-between gap-2 shadow-sm"
                                                                t-attf-class="#{isOpenUtrecar ? 'border-primary' : ''}"
                                                                t-att-disabled="isUpdatingUtrecar"
                                                                t-on-click="() => this.toggleDropdown(u.odoo_user_id + '_1')"
                                                                title="Haga clic para asignar o quitar roles en Utrecar S.L.">
                                                            
                                                            <div class="d-flex align-items-center gap-1 flex-wrap text-start role-badges-summary">
                                                                <t t-if="accUtrecar.roles and accUtrecar.roles.length > 0">
                                                                    <t t-foreach="accUtrecar.roles" t-as="r" t-key="r.id">
                                                                        <span class="badge role-pill shadow-xs" 
                                                                              t-attf-style="background-color: #{r.color || '#0284c7'}; color: #fff;">
                                                                            <t t-esc="r.name"/>
                                                                        </span>
                                                                    </t>
                                                                </t>
                                                                <t t-elif="accUtrecar.role_name and accUtrecar.role_name !== 'Sin Rol'">
                                                                    <span class="badge role-pill shadow-xs" 
                                                                          t-attf-style="background-color: #{accUtrecar.role_color || '#0284c7'}; color: #fff;">
                                                                        <t t-esc="accUtrecar.role_name"/>
                                                                    </span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge bg-warning-subtle text-dark border px-2 py-1 font-monospace" style="font-size: 0.75rem;">
                                                                        <i class="fa fa-exclamation-triangle text-warning me-1"/> Sin Rol
                                                                    </span>
                                                                </t>
                                                            </div>

                                                            <div class="ms-1 text-muted d-flex align-items-center">
                                                                <i t-if="isUpdatingUtrecar" class="fa fa-spin fa-spinner text-primary"/>
                                                                <i t-else="" class="fa fa-caret-down fs-6" t-att-class="isOpenUtrecar ? 'text-primary' : 'text-secondary'"/>
                                                            </div>
                                                        </button>

                                                        <!-- DROPDOWN FLOTANTE MULTI-ROL -->
                                                        <div t-if="isOpenUtrecar" class="role-dropdown-popover shadow-lg border rounded-3 bg-white text-start">
                                                            <div class="popover-header px-3 py-2 bg-light border-bottom d-flex align-items-center justify-content-between">
                                                                <span class="fw-bold small text-dark">
                                                                    <i class="fa fa-shield text-warning me-1"/> Roles en Utrecar S.L.
                                                                </span>
                                                                <button type="button" class="btn btn-sm btn-link text-muted p-0 border-0" t-on-click="() => this.closeDropdown()">✖</button>
                                                            </div>

                                                            <div class="popover-body p-2">
                                                                <t t-foreach="state.roles" t-as="r" t-key="r.id">
                                                                    <t t-set="isRoleChecked" t-value="this.hasCompanyRole(u, 1, r.id)"/>
                                                                    <div class="role-option-item d-flex align-items-center justify-content-between px-3 py-2 rounded mb-1 cursor-pointer"
                                                                         t-attf-class="#{isRoleChecked ? 'bg-primary-subtle text-primary fw-bold' : 'text-dark'}"
                                                                         t-on-click="() => this.toggleCompanyRole(u, 1, r.id)">
                                                                        <div class="d-flex align-items-center gap-2">
                                                                            <span class="role-dot rounded-circle" t-attf-style="background-color: #{r.color || '#0284c7'}; width: 10px; height: 10px; display: inline-block;"/>
                                                                            <span class="role-name-text"><t t-esc="r.name"/></span>
                                                                        </div>
                                                                        <div>
                                                                            <i t-if="isRoleChecked" class="fa fa-check-square text-primary fs-5"/>
                                                                            <i t-else="" class="fa fa-square-o text-muted fs-5"/>
                                                                        </div>
                                                                    </div>
                                                                </t>
                                                            </div>

                                                            <div class="popover-footer px-3 py-2 bg-light border-top d-flex justify-content-between align-items-center">
                                                                <small class="text-muted" style="font-size: 0.72rem;">Puede marcar más de un rol</small>
                                                                <button type="button" class="btn btn-sm btn-primary py-1 px-3 fw-bold" style="font-size: 0.75rem;" t-on-click="() => this.closeDropdown()">
                                                                    Listo
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="btn btn-sm btn-light border text-muted disabled" style="min-width: 190px; opacity: 0.6; cursor: not-allowed;">
                                                            <i class="fa fa-lock me-1"/> Sin acceso
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>

                                            <div class="mt-1 small">
                                                <span t-if="accUtrecar and accUtrecar.active" class="status-badge-active-utrecar">
                                                    <i class="fa fa-check me-1"/> Autorizado en Utrecar
                                                </span>
                                                <span t-else="" class="status-badge-inactive">
                                                    <i class="fa fa-ban me-1"/> Sin acceso
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>

            <!-- NOTA AL PIE -->
            <div class="mt-3 p-3 bg-white rounded-3 border d-flex align-items-center gap-3">
                <i class="fa fa-info-circle text-primary fs-4"></i>
                <div class="small text-muted">
                    <strong>Integración con TPV y Seguridad:</strong>
                    Los empleados con rol <strong>EMPLEADO</strong> activo en cada empresa son los únicos que pueden acceder y abrir turno en las terminales de esa empresa, contando con facultades completas para operar el TPV. El rol <strong>CEO</strong> habilita el acceso directo a la administración del sistema desde la pantalla principal de identificación.
                </div>
            </div>
        </div>
    </t>

