<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ============================================================ -->
    <!-- PLANTILLA PRINCIPAL VIRTUSTPV PARA ODOO 17 (4 ZONAS DE TRABAJO)-->
    <!-- ============================================================ -->
    <t t-name="pos_gas_station.UtrecarMainScreen" owl="1">
        <div class="virtus-layout-container">

            <!-- ============================================================ -->
            <!-- COLUMNA IZQUIERDA (74% ANCHO): TABLA DE ARTÍCULOS + SURTIDORES -->
            <!-- ============================================================ -->
            <div class="virtus-left-workspace">

                <!-- 1. ZONA SUPERIOR: CABECERA + TABLA DE ARTÍCULOS EN VENTA -->
                <div class="virtus-top-ticket-card">
                    
                    <!-- BARRA SUPERIOR DE TICKET -->
                    <div class="ticket-header-bar">
                        <div class="station-title-badge">
                            <i class="fa fa-gas-pump mr-2 text-primary"/>
                            <span class="station-name-text"><t t-esc="state.stationName"/></span>
                        </div>

                        <!-- MATRÍCULA CENTRAL ESPAÑOLA / EUROPEA -->
                        <div class="euro-plate-container">
                            <span class="plate-flag">🇪🇸 E</span>
                            <input type="text" 
                                   class="plate-input-field" 
                                   placeholder="MATRÍCULA..." 
                                   t-att-value="state.vehiclePlate"
                                   t-on-input="(ev) => this.onPlateChange(ev)" />
                        </div>

                        <!-- ACCIONES RÁPIDAS DE LÍNEAS -->
                        <div class="ticket-actions-group">
                            <button class="btn-ticket-tool" t-on-click="() => this.openRefundScreen()" title="Historial de tickets / Devolución">
                                <i class="fa fa-history mr-1"/> Historial
                            </button>
                            <button class="btn-ticket-tool" t-on-click="() => this.deleteSelectedLine()" title="Eliminar línea seleccionada">
                                <i class="fa fa-trash-alt mr-1"/> Borrar
                            </button>
                            <button class="btn-ticket-tool btn-tool-cancel" t-on-click="() => this.clearCurrentOrder()" title="Cancelar venta actual">
                                <i class="fa fa-times-circle mr-1"/> Cancelar
                            </button>
                        </div>
                    </div>

                    <!-- TABLA DE ARTÍCULOS REGISTRADOS -->
                    <div class="ticket-table-wrapper">
                        <table class="virtus-pos-table">
                            <thead>
                                <tr>
                                    <th style="width: 12%;">CÓDIGO</th>
                                    <th style="width: 38%;">ARTÍCULO / COMBUSTIBLE</th>
                                    <th style="width: 12%; text-align: right;">CANTIDAD</th>
                                    <th style="width: 12%; text-align: right;">PRECIO</th>
                                    <th style="width: 10%; text-align: right;">DESC %</th>
                                    <th style="width: 16%; text-align: right;">IMPORTE</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="currentOrderLines.length === 0">
                                    <tr class="empty-row">
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="fa fa-shopping-cart fa-2x mb-1 d-block opacity-40"/>
                                            Ticket vacío. Seleccione una <strong>Calle libre</strong> para Prepago o pulse <strong>PASAR A TICKET</strong> para Postpago.
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-foreach="currentOrderLines" t-as="line" t-key="line.id">
                                        <tr t-att-class="(state.selectedLineId === line.id || line.selected) ? 'selected-row' : ''" 
                                            t-on-click="() => this.selectOrderLine(line)">
                                            <td><span class="badge-code"><t t-esc="line.product.default_code || 'COMB'"/></span></td>
                                            <td class="font-weight-bold text-dark"><t t-esc="line.product.display_name"/></td>
                                            <td class="text-right font-weight-bold"><t t-esc="line.get_quantity_str()"/> <t t-esc="line.product.uom_id ? line.product.uom_id[1] : 'Ud'"/></td>
                                            <td class="text-right"><t t-esc="line.get_unit_price().toFixed(3)"/> €</td>
                                            <td class="text-right"><t t-esc="line.get_discount_str()"/> %</td>
                                            <td class="text-right font-weight-bold text-primary"><t t-esc="line.get_display_price().toFixed(2)"/> €</td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 2. ZONA INFERIOR: MAPA DE SURTIDORES (CALLAS 1 A 8) -->
                <div class="virtus-bottom-pumps-card">
                    <div class="pumps-card-header">
                        <div class="pumps-title">
                            <i class="fa fa-tachometer-alt mr-2 text-info"/> CONTROL DE PISTA — ESTADO DE SURTIDORES
                        </div>
                        <div class="pumps-status-legend">
                            <span class="legend-item"><span class="dot dot-free"/> Libre</span>
                            <span class="legend-item"><span class="dot dot-ready"/> Pendiente Cobro</span>
                            <span class="legend-item"><span class="dot dot-dispensing"/> Suministrando / Autorizado</span>
                        </div>
                    </div>

                    <!-- GRID DE SURTIDORES EN 2 FILAS DE 4 CALLES -->
                    <div class="virtus-pumps-grid">
                        <t t-foreach="state.pumps" t-as="pump" t-key="pump.id">
                            <t t-set="fuelInfo" t-value="getPumpFuelData(pump)"/>
                            <div t-attf-class="pump-tile status-#{pump.status} #{state.selectedPumpId === pump.id ? 'is-selected' : ''} #{getPumpFuelClass(pump)}"
                                 t-on-click="() => this.onPumpSelect(pump)">
                                
                                <div class="pump-tile-top">
                                    <span class="pump-num">CALLE <t t-esc="pump.id"/></span>
                                    <span class="pump-badge"><t t-esc="pump.statusText"/></span>
                                </div>

                                <!-- CHIP DE COMBUSTIBLE -->
                                <div class="pump-fuel-banner">
                                    <t t-if="fuelInfo.isActive">
                                        <div t-attf-class="fuel-chip-badge #{fuelInfo.badgeClass}">
                                            <span class="f-code"><t t-esc="fuelInfo.shortCode"/></span>
                                            <span class="f-name"><t t-esc="fuelInfo.name"/></span>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="fuel-chip-badge fuel-chip-idle">
                                            <span class="f-code text-muted">GA/95</span>
                                            <span class="f-name text-muted"><t t-esc="pump.fuel || 'Gasóleo / Sin Plomo'"/></span>
                                        </div>
                                    </t>
                                </div>

                                <!-- CONTADOR LCD DE SURTIDOR -->
                                <div class="pump-lcd-box">
                                    <div class="lcd-euros-row">
                                        <t t-if="pump.amount > 0">
                                            <t t-esc="pump.amount.toFixed(2)"/> €
                                        </t>
                                        <t t-else="">
                                            0.00 €
                                        </t>
                                    </div>
                                    <div class="lcd-liters-row">
                                        <t t-if="pump.liters > 0">
                                            <t t-esc="pump.liters.toFixed(2)"/> L
                                        </t>
                                        <t t-else="">
                                            0.00 L
                                        </t>
                                    </div>
                                </div>

                                <!-- BOTÓN DE ACCIÓN SEGÚN ESTADO DE VIRTUSTPV -->
                                <div class="pump-bottom-action">
                                    <t t-if="pump.status === 'ready' || (pump.amount > 0 &amp;&amp; pump.status !== 'dispensing')">
                                        <button class="btn-pump-action btn-pump-ticket" t-on-click.stop="() => this.onPumpClick(pump)">
                                            <i class="fa fa-arrow-circle-up mr-1"/> PASAR A TICKET
                                        </button>
                                    </t>
                                    <t t-elif="pump.status === 'dispensing'">
                                        <div class="dispensing-pill">
                                            <i class="fa fa-spinner fa-spin mr-1"/> EN PROCESO
                                        </div>
                                        <button class="btn-cancel-auth" t-on-click.stop="() => this.cancelPumpAuthorization(pump)">
                                            <i class="fa fa-ban mr-1"/> Cancelar
                                        </button>
                                    </t>
                                    <t t-else="">
                                        <div class="idle-state-tag">
                                            <t t-if="state.selectedPumpId === pump.id &amp;&amp; state.presetValue > 0">
                                                <button class="btn-load-preset" t-on-click.stop="() => this.authorizePreset()">
                                                    <i class="fa fa-check mr-1"/> PREPAGO A TICKET
                                                </button>
                                            </t>
                                            <t t-else="">
                                                SURTIDOR LIBRE
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

            </div>

            <!-- ============================================================ -->
            <!-- COLUMNA DERECHA (26% ANCHO, ALTURA COMPLETA): PANEL VIRTUS   -->
            <!-- ============================================================ -->
            <div class="virtus-right-control-panel">

                <!-- 1. OPCIONES DE TURNO Y UTILIDADES (ARRIBA) -->
                <div class="virtus-top-tools-grid">
                    <button class="btn-virtus-menu btn-menu-store" t-on-click="() => this.openStoreModal()">
                        <i class="fa fa-th-large mr-2"/> TIENDA / PARRILLA
                    </button>
                    <button class="btn-virtus-menu btn-menu-security" t-on-click="() => this.onSecurityDepositClick()" title="Retirada de efectivo a caja fuerte">
                        <i class="fa fa-shield-alt mr-2"/> INGRESO SEGURIDAD
                    </button>
                    <button class="btn-virtus-menu btn-menu-danger" t-on-click="() => this.onEmergencyStopClick()" title="Parada de emergencia de surtidores">
                        <i class="fa fa-stop-circle mr-2"/> PARADA EMERGENCIA
                    </button>
                </div>

                <!-- 2. CUADRÍCULA DE PREFIJADO / COBRO RÁPIDO (CENTRO) -->
                <div class="virtus-keypad-container">
                    
                    <!-- DISPLAY DIGITAL DE PREFIJADO -->
                    <div class="virtus-lcd-screen">
                        <div class="lcd-digits-box">
                            <span class="lcd-subtitle"><t t-esc="state.mode === 'money' ? 'PREFIJADO IMPORTE' : 'PREFIJADO LITROS'"/></span>
                            <span class="lcd-value"><t t-esc="state.presetValue > 0 ? state.presetValue : '0'"/> <t t-esc="state.mode === 'money' ? '€' : 'L'"/></span>
                        </div>
                        <button t-attf-class="btn-drop-switcher #{state.mode === 'liters' ? 'is-active-drop' : ''}" 
                                t-on-click="() => this.toggleMode()"
                                title="Cambiar entre Euros y Litros">
                            <span class="drop-symbol">💧</span>
                            <span class="drop-caption"><t t-esc="state.mode === 'money' ? 'A LITROS' : 'A EUROS'"/></span>
                        </button>
                    </div>

                    <!-- BOTONERA DE BILLETES Y MONEDAS / LITROS EN ALTA VISIBILIDAD -->
                    <div class="virtus-fast-grid">
                        <t t-if="state.mode === 'money'">
                            <button class="btn-fast-money bill-svg bill-1e" t-on-click="() => this.addPreset(1)" title="1 Euro"></button>
                            <button class="btn-fast-money bill-svg bill-5e" t-on-click="() => this.addPreset(5)" title="5 Euros"></button>
                            <button class="btn-fast-money bill-svg bill-10e" t-on-click="() => this.addPreset(10)" title="10 Euros"></button>
                            <button class="btn-fast-money bill-svg bill-20e" t-on-click="() => this.addPreset(20)" title="20 Euros"></button>
                            <button class="btn-fast-money bill-svg bill-50e" t-on-click="() => this.addPreset(50)" title="50 Euros"></button>
                            <button class="btn-fast-money bill-svg bill-100e" t-on-click="() => this.addPreset(100)" title="100 Euros"></button>
                        </t>
                        <t t-else="">
                            <button class="btn-fast-liter" t-on-click="() => this.addPreset(1)">1 L</button>
                            <button class="btn-fast-liter" t-on-click="() => this.addPreset(5)">5 L</button>
                            <button class="btn-fast-liter" t-on-click="() => this.addPreset(10)">10 L</button>
                            <button class="btn-fast-liter" t-on-click="() => this.addPreset(20)">20 L</button>
                            <button class="btn-fast-liter" t-on-click="() => this.addPreset(50)">50 L</button>
                            <button class="btn-fast-liter btn-liter-full" t-on-click="() => this.addPreset(999)" title="Lleno / Sin límite">⛽ LLENO</button>
                        </t>
                    </div>

                    <!-- SELECTOR DE COMBUSTIBLE (GA / 95 / GB / G+) -->
                    <div class="virtus-fuels-tab-bar">
                        <t t-foreach="state.availableFuels" t-as="fuel" t-key="fuel.code">
                            <button t-attf-class="btn-fuel-tab #{fuel.class} #{state.selectedFuel === fuel.code ? 'active-fuel' : ''}" 
                                    t-on-click="() => this.selectFuel(fuel.code)">
                                <strong><t t-esc="fuel.code"/></strong> <span><t t-esc="fuel.name"/></span>
                            </button>
                        </t>
                    </div>

                    <!-- ACCIONES DE PISTA: BORRAR / AUTORIZAR CALLE -->
                    <div class="virtus-keypad-actions">
                        <button class="btn-action-clear" t-on-click="() => this.clearPreset()">
                            <i class="fa fa-times mr-1"/> C (BORRAR)
                        </button>
                        <t t-if="isSelectedPumpActive">
                            <button class="btn-action-auth btn-busy" title="Esta calle ya se encuentra en proceso de suministro">
                                <i class="fa fa-spinner fa-spin mr-1"/> EN PROCESO
                            </button>
                        </t>
                        <t t-else="">
                            <button class="btn-action-auth" t-on-click="() => this.authorizePreset()">
                                <i class="fa fa-check-circle mr-1"/> AUTORIZAR <t t-if="state.selectedPumpId">CALLE <t t-esc="state.selectedPumpId"/></t>
                            </button>
                        </t>
                    </div>

                </div>

                <!-- 3. BARRA DE TOTAL Y BOTÓN DE COBRO GIGANTE (ABAJO) -->
                <div class="virtus-checkout-card">
                    <div class="checkout-amount-display">
                        <span class="checkout-label">TOTAL A COBRAR:</span>
                        <span class="checkout-val"><t t-esc="currentTotalAmount.toFixed(2)"/> €</span>
                    </div>
                    <button class="btn-virtus-pay" t-on-click="() => this.goToPayment()">
                        <i class="fa fa-credit-card mr-2"/> COBRAR (<t t-esc="currentTotalAmount.toFixed(2)"/> €)
                    </button>
                </div>

            </div>

            <!-- ============================================================ -->
            <!-- MODAL / PARRILLA DE PRODUCTOS DE TIENDA                      -->
            <!-- ============================================================ -->
            <t t-if="state.isStoreModalOpen">
                <div class="utrecar-modal-backdrop" t-on-click="() => this.closeStoreModal()">
                    <div class="utrecar-store-modal" t-on-click.stop="">
                        
                        <div class="store-modal-header">
                            <div class="modal-title">
                                <i class="fa fa-store mr-2 text-primary"/> CATÁLOGO DE TIENDA Y ARTÍCULOS DE PISTA
                            </div>
                            <div class="modal-search-box">
                                <i class="fa fa-search search-icon"/>
                                <input type="text" 
                                       class="store-search-input" 
                                       placeholder="Buscar producto (ej: agua, coca, hielo, butano...)" 
                                       t-att-value="state.storeSearch"
                                       t-on-input="(ev) => this.onStoreSearchInput(ev)" />
                            </div>
                            <button class="btn-close-modal" t-on-click="() => this.closeStoreModal()">
                                <i class="fa fa-times"/>
                            </button>
                        </div>

                        <div class="store-products-grid">
                            <t t-if="filteredStoreProducts.length === 0">
                                <div class="text-center py-5 w-100 text-muted">
                                    <i class="fa fa-box-open fa-3x mb-3 opacity-50"/>
                                    <p>No se encontraron productos coincidentes.</p>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-foreach="filteredStoreProducts" t-as="product" t-key="product.id">
                                    <div class="store-product-card" t-on-click="() => this.addStoreProductToOrder(product)">
                                        <div class="product-card-body">
                                            <div class="product-code"><t t-esc="product.default_code || 'ART'"/></div>
                                            <div class="product-name"><t t-esc="product.display_name"/></div>
                                            <div class="product-price"><t t-esc="product.lst_price.toFixed(2)"/> €</div>
                                        </div>
                                        <div class="product-card-footer">
                                            <i class="fa fa-plus-circle mr-1"/> Añadir
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>

                    </div>
                </div>
            </t>

        </div>
    </t>

    <!-- SUSTITUCIÓN COMPLETA DE PRODUCTSCREEN -->
    <t t-name="pos_gas_station.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('product-screen')]" position="replace">
            <div class="product-screen screen d-flex flex-column h-100 p-0 m-0">
                <UtrecarMainScreen />
            </div>
        </xpath>
    </t>

    <!-- EXTENSIÓN DE PAYMENTSCREENVALIDATE - LAS 3 SALIDAS DE VIRTUSTPV (TICKET / FACTURA / SIN IMPRIMIR) -->
    <t t-name="pos_gas_station.PaymentScreenValidate" t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('validation')]" position="after">
            <div class="virtus-payment-actions-bar">
                <button class="btn-virtus-action btn-action-ticket" t-on-click="() => this.validateVirtusTicket()">
                    <div class="action-icon">🖨</div>
                    <div class="action-details">
                        <strong>TICKET</strong>
                        <span>Imprimir</span>
                    </div>
                </button>
                <button class="btn-virtus-action btn-action-invoice" t-on-click="() => this.validateVirtusInvoice()">
                    <div class="action-icon">📄</div>
                    <div class="action-details">
                        <strong>FACTURA</strong>
                        <span>NIF/CIF</span>
                    </div>
                </button>
                <button class="btn-virtus-action btn-action-noprint" t-on-click="() => this.validateVirtusNoPrint()">
                    <div class="action-icon">⚡</div>
                    <div class="action-details">
                        <strong>SIN TICKET</strong>
                        <span>Rápido</span>
                    </div>
                </button>
            </div>
        </xpath>
    </t>

</templates>
