<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ============================================================ -->
    <!-- PLANTILLA VIRTUSTPV AUTÉNTICA PARA ODOO 17 (ESTRUCTURA 2X2)  -->
    <!-- ============================================================ -->
    <t t-name="pos_gas_station.UtrecarMainScreen" owl="1">
        <div class="virtus-screen-master">

            <!-- ======================================================== -->
            <!-- FILA SUPERIOR: TABLA DE TICKET (68%) + PARRILLA TIENDA (32%) -->
            <!-- ======================================================== -->
            <div class="virtus-row-top">

                <!-- 1. CUADRANTE SUPERIOR IZQUIERDO: TICKET / ARTÍCULOS -->
                <div class="virtus-quadrant-ticket">
                    <!-- CABECERA SUPERIOR DE VENTA -->
                    <div class="virtus-ticket-topbar">
                        <div class="ticket-card-icon" title="Tarjeta / Cliente">
                            <button class="virtus-card-cards-badge" t-on-click="() => this.openClientModal()">
                                <i class="fa fa-address-card me-1"/>
                                <t t-if="currentOrderPartner">
                                    <t t-esc="currentOrderPartner.name"/>
                                </t>
                                <t t-else="">
                                    💳 CLIENTE
                                </t>
                            </button>
                        </div>
                        <div class="virtus-plate-box">
                            <span class="eu-flag-box">🇪🇸 E</span>
                            <input type="text" 
                                   class="virtus-plate-input" 
                                   placeholder="3696 GBC" 
                                   t-att-value="state.vehiclePlate"
                                   t-on-input="(ev) => this.onPlateChange(ev)" />
                        </div>
                        <div class="virtus-user-badge" t-on-click="() => this.changeCashierName()" title="Haga clic para cambiar de cajero / operador" style="cursor: pointer;">
                            <i class="fa fa-user mr-1 text-primary"/>
                            <span class="user-name"><t t-esc="pos.user ? pos.user.name : 'SUPERVISOR'"/></span>
                            <i class="fa fa-pencil ms-1 text-muted" style="font-size: 10px;"/>
                        </div>
                        <div class="station-mini-label">
                            <t t-esc="state.stationName"/>
                        </div>
                    </div>

                    <!-- TABLA PRINCIPAL DE LÍNEAS DE VENTA -->
                    <div class="virtus-table-container">
                        <table class="virtus-grid-table">
                            <thead>
                                <tr>
                                    <th style="width: 14%;">Código</th>
                                    <th style="width: 38%;">Artículo</th>
                                    <th style="width: 12%; text-align: right;">+Cantidad</th>
                                    <th style="width: 12%; text-align: right;">Precio</th>
                                    <th style="width: 10%; text-align: right;">Descuento</th>
                                    <th style="width: 14%; text-align: right;">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="currentOrderLines.length === 0">
                                    <tr class="empty-placeholder-row">
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="fa fa-shopping-cart fa-2x mb-1 d-block opacity-30"/>
                                            Ticket vacío. Seleccione una <strong>Calle</strong> o pulse un <strong>Producto de Tienda</strong>.
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-foreach="currentOrderLines" t-as="line" t-key="line.id">
                                        <tr t-att-class="(state.selectedLineId === line.id || line.selected) ? 'row-selected' : ''" 
                                            t-on-click="() => this.selectOrderLine(line)">
                                            <td><span class="cell-code"><t t-esc="line.product.default_code || 'ART'"/></span></td>
                                            <td class="font-weight-bold">
                                                <t t-if="line.get_quantity() > 0 &amp;&amp; (line.product.display_name.includes('Gasóleo') || line.product.display_name.includes('Sin Plomo'))">
                                                    <span class="fuel-line-icon">⛽</span>
                                                </t>
                                                <t t-esc="line.product.display_name"/>
                                            </td>
                                            <td class="text-right font-weight-bold"><t t-esc="line.get_quantity_str()"/></td>
                                            <td class="text-right"><t t-esc="line.get_unit_price().toFixed(3)"/> €</td>
                                            <td class="text-right"><t t-esc="line.get_discount_str()"/> %</td>
                                            <td class="text-right font-weight-bold text-primary"><t t-esc="line.get_display_price().toFixed(2)"/> €</td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- BARRA DE HERRAMIENTAS INFERIOR DE TICKET -->
                    <div class="virtus-ticket-tools-bar">
                        <div class="tools-left-group">
                            <button class="tool-btn btn-barcode" title="Lector de código de barras" t-on-click="() => this.focusBarcode()">
                                ▌▌█║▌
                            </button>
                            <button class="tool-btn btn-trash-red" title="Borrar línea seleccionada" t-on-click="() => this.deleteSelectedLine()">
                                🗑 BORRAR
                            </button>
                            <button class="tool-btn btn-discount" title="Descuentos" t-on-click="() => this.applyQuickDiscount()">
                                % DTO
                            </button>
                            <button class="tool-btn btn-history" title="Historial de turno / Devoluciones" t-on-click="() => this.openRefundScreen()">
                                ⏱ Historial
                            </button>
                            <button class="tool-btn btn-cancel-order" title="Cancelar venta" t-on-click="() => this.clearCurrentOrder()">
                                ✖ Cancelar
                            </button>
                        </div>
                        <div class="tools-total-box" t-on-click="() => this.goToPayment()" title="Haga clic aquí para cobrar el ticket">
                            <span class="total-digits"><t t-esc="currentTotalAmount.toFixed(2)"/> €</span>
                        </div>
                    </div>
                </div>

                <!-- 2. CUADRANTE SUPERIOR DERECHO: PARRILLA DE TIENDA (32%) -->
                <div class="virtus-quadrant-store">
                    <!-- BARRA DE ACCIONES Y PÁGINAS SUPERIOR -->
                    <div class="virtus-store-topbar">
                        <button class="btn-store-cat" t-on-click="() => this.onSecurityDepositClick()" title="Opciones de Turno / Ingreso de Seguridad">
                            ⏱
                        </button>
                        <button class="btn-store-cat btn-catalog-open" t-on-click="() => this.openStoreModal()" title="Catálogo Completo y Búsqueda (Nombre, Código o Código de Barras)">
                            📦
                        </button>
                        <button t-attf-class="btn-store-cat btn-cart-toggle #{!state.isStoreModalOpen ? 'active-grid' : ''}" t-on-click="() => this.onCartButtonClick()" title="Parrilla Rápida de Tienda (Clic para avanzar de página)">
                            🛒 <span class="page-indicator"><t t-esc="'P' + state.currentStorePage"/></span>
                        </button>
                        <div class="btn-dropdown-wrapper">
                            <button class="btn-store-cat btn-cat-nav" t-on-click="() => this.togglePageDropdown()" title="Desplegar Páginas y Categorías de Parrilla">
                                ▼
                            </button>
                            <t t-if="state.isPageDropdownOpen">
                                <div class="virtus-page-dropdown-menu" t-on-click.stop="">
                                    <div class="dropdown-header-title">📄 PÁGINAS DE LA PARRILLA</div>
                                    <div t-attf-class="dropdown-page-item #{state.currentStorePage === 1 ? 'active' : ''}" t-on-click="() => this.setStorePage(1)">
                                        <span class="page-icon">⭐</span>
                                        <div class="page-info">
                                            <strong>Página 1: Favoritos</strong>
                                            <small>Hielo, Bebidas, Cafés y Butano</small>
                                        </div>
                                    </div>
                                    <div t-attf-class="dropdown-page-item #{state.currentStorePage === 2 ? 'active' : ''}" t-on-click="() => this.setStorePage(2)">
                                        <span class="page-icon">🥤</span>
                                        <div class="page-info">
                                            <strong>Página 2: Bebidas y Cafetería</strong>
                                            <small>Aguas, Refrescos, Energéticas y Cafés</small>
                                        </div>
                                    </div>
                                    <div t-attf-class="dropdown-page-item #{state.currentStorePage === 3 ? 'active' : ''}" t-on-click="() => this.setStorePage(3)">
                                        <span class="page-icon">🚗</span>
                                        <div class="page-info">
                                            <strong>Página 3: Auto, Aceites y Accesorios</strong>
                                            <small>Aceites 2T, Anticongelante, AdBlue y Repuestos</small>
                                        </div>
                                    </div>
                                    <div t-attf-class="dropdown-page-item #{state.currentStorePage === 4 ? 'active' : ''}" t-on-click="() => this.setStorePage(4)">
                                        <span class="page-icon">🍫</span>
                                        <div class="page-info">
                                            <strong>Página 4: Snacks y Alimentación</strong>
                                            <small>Patatas, Dulces, Chocolates y Tabaco</small>
                                        </div>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    <div class="dropdown-page-item dropdown-catalog-item" t-on-click="() => this.openStoreModalFromDropdown()">
                                        <span class="page-icon">📦</span>
                                        <div class="page-info">
                                            <strong>Abrir Catálogo Completo...</strong>
                                            <small>Búsqueda por código interno o código de barras</small>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- CUADRÍCULA DIRECTA DE 20 PRODUCTOS VIRTUSTPV (5x4) -->
                    <div class="virtus-store-grid">
                        <t t-foreach="popularStoreProducts" t-as="prod" t-key="prod.id">
                            <t t-if="prod.is_empty">
                                <div class="store-item-btn empty-slot"></div>
                            </t>
                            <t t-elif="prod.bg_image">
                                <button class="store-item-btn" 
                                        t-att-title="prod.display_name"
                                        t-on-click="() => this.addStoreProductToOrder(prod)">
                                    <img t-att-src="prod.bg_image" class="store-product-img-tag" alt="Producto"/>
                                </button>
                            </t>
                            <t t-elif="prod.text_only">
                                <button class="store-item-btn text-item-btn" 
                                        t-att-title="prod.full_name || prod.display_name"
                                        t-on-click="() => this.addStoreProductToOrder(prod)">
                                    <span class="text-btn-label"><t t-esc="prod.display_name"/></span>
                                </button>
                            </t>
                            <t t-else="">
                                <button class="store-item-btn" t-on-click="() => this.addStoreProductToOrder(prod)">
                                    <span class="store-item-name"><t t-esc="prod.display_name"/></span>
                                </button>
                            </t>
                        </t>
                    </div>
                </div>

            </div>

            <!-- ======================================================== -->
            <!-- FILA INFERIOR: MAPA SURTIDORES (68%) + TECLADO COBRO (32%) -->
            <!-- ======================================================== -->
            <div class="virtus-row-bottom">

                <!-- 3. CUADRANTE INFERIOR IZQUIERDO: POSTES DE SURTIDORES ASEPRODA -->
                <div t-attf-class="virtus-quadrant-pumps #{state.trackMode === 'atendido' ? 'track-atendido' : 'track-prepago'}">
                    <div class="pumps-brand-watermark d-flex justify-content-between align-items-center">
                        <span class="pumps-panel-title fw-bold text-dark"><i class="fa fa-gas-pump me-1 text-primary"/>SURTIDORES DE PISTA</span>
                        <div class="track-mode-switch-wrapper">
                            <button t-attf-class="btn-track-mode-toggle #{state.trackMode === 'atendido' ? 'mode-atendido' : 'mode-prepago'}"
                                    t-on-click="() => this.toggleTrackMode()"
                                    title="Haga clic para cambiar entre modo Prepago y Atendido">
                                <t t-if="state.trackMode === 'atendido'">
                                    <span class="mode-led led-green">●</span> <strong>PISTA: ATENDIDO (POSTPAGO)</strong>
                                    <span class="mode-switch-hint">🔄 Cambiar a Prepago</span>
                                </t>
                                <t t-else="">
                                    <span class="mode-led led-red">●</span> <strong>PISTA: PREPAGO (BLOQUEO)</strong>
                                    <span class="mode-switch-hint">🔄 Cambiar a Atendido</span>
                                </t>
                            </button>
                        </div>
                    </div>
                    
                    <div class="virtus-pumps-row">
                        <t t-foreach="state.pumps" t-as="pump" t-key="pump.id">
                            <t t-set="fuelInfo" t-value="getPumpFuelData(pump)"/>
                            
                            <div t-attf-class="aseproda-dispenser-box status-#{pump.status} #{state.selectedPumpId === pump.id ? 'is-selected' : ''}"
                                 t-on-click="() => this.onPumpSelect(pump)">
                                
                                <!-- Pestana superior azul con numero de calle -->
                                <div class="dispenser-corner-tab"><t t-esc="pump.id"/></div>
                                
                                <!-- Silueta lateral de manguera / boquilla negra -->
                                <div class="dispenser-nozzle-handle"></div>

                                <!-- Cabecera / Display LCD blanco -->
                                <div class="dispenser-head">
                                    <div class="lcd-header-line">
                                        <span class="f-code"><t t-esc="pump.amount > 0 ? (pump.fuel ? pump.fuel.slice(0,4) : 'GA') : 'N/A'"/></span>
                                        <span class="f-liters"><t t-esc="pump.liters > 0 ? pump.liters.toFixed(2) + 'L' : '0.00L'"/></span>
                                    </div>
                                    <div class="lcd-price-main">
                                        <t t-esc="pump.amount > 0 ? pump.amount.toFixed(2).replace('.', ',') + ' €' : '0,00 €'"/>
                                    </div>
                                    <div class="lcd-black-strip">
                                        <t t-if="pump.status === 'ready'">FIN REPOSTAJE</t>
                                        <t t-elif="pump.status === 'atendido'">POSTPAGO LIBRE</t>
                                        <t t-elif="pump.amount > 0">SUMINISTRO</t>
                                        <t t-else="">Sin prefijado</t>
                                    </div>
                                </div>

                                <!-- Cuerpo inferior (Verde en atendido/postpago, Rojo en prepago/bloqueado) -->
                                <div class="dispenser-lower-body">
                                    <t t-if="pump.status === 'ready' || (pump.amount > 0 &amp;&amp; pump.status !== 'dispensing')">
                                        <button class="btn-virtus-pasar-ticket" t-on-click.stop="() => this.onPumpClick(pump)">
                                            <div class="icon-up">⬆</div>
                                            <strong>COBRAR</strong>
                                        </button>
                                    </t>
                                    <t t-elif="pump.status === 'atendido' || pump.status === 'postpago' || (pump.status === 'idle' &amp;&amp; state.trackMode === 'atendido')">
                                        <div class="dispenser-padlock-panel atendido-green">
                                            <img src="/pos_gas_station/static/src/img/lock_virtus_combination.svg" class="virtus-dial-lock" alt="🔓" />
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="dispenser-padlock-panel blocked-red">
                                            <img src="/pos_gas_station/static/src/img/lock_virtus_combination.svg" class="virtus-dial-lock" alt="🔒" />
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- 4. CUADRANTE INFERIOR DERECHO: TECLADO Y COBRO (32%) -->
                <div class="virtus-quadrant-keypad">
                    
                    <div class="virtus-numpad-header">
                        <div class="lcd-value-display" t-on-click="() => this.promptCustomAmount()" title="Pulsar para teclear importe exacto con decimales">
                            <span class="lcd-current"><t t-esc="state.presetValue > 0 ? (state.presetValue % 1 === 0 ? state.presetValue.toFixed(0) : state.presetValue.toFixed(2)) : '0,00'"/> <t t-esc="state.mode === 'money' ? '€' : 'L'"/></span>
                            <span class="lcd-edit-icon" title="Editar importe con decimales">✏️</span>
                        </div>
                        <button class="btn-numpad-tool btn-decimals-tool" t-on-click="() => this.promptCustomAmount()" title="Escribir cantidad exacta con decimales">
                            🔢 Dec.
                        </button>
                        <button class="btn-numpad-tool btn-mode-calles" t-on-click="() => this.toggleMode()">
                            <t t-esc="state.mode === 'money' ? 'Modo €' : 'Modo L'"/>
                        </button>
                        <button class="btn-numpad-tool btn-gear" t-on-click="() => this.openStoreModal()" title="Abrir Catálogo">
                            ⚙
                        </button>
                    </div>

                    <div class="virtus-keypad-matrix">
                        <div class="matrix-bills-grid">
                            <t t-if="state.mode === 'money'">
                                <button class="matrix-bill-btn bill-img-tile bill-1e" t-on-click="() => this.addPreset(1)"></button>
                                <button class="matrix-bill-btn bill-img-tile bill-5e" t-on-click="() => this.addPreset(5)"></button>
                                <button class="matrix-bill-btn bill-img-tile bill-10e" t-on-click="() => this.addPreset(10)"></button>
                                <button class="matrix-bill-btn bill-img-tile bill-20e" t-on-click="() => this.addPreset(20)"></button>
                                <button class="matrix-bill-btn bill-img-tile bill-50e" t-on-click="() => this.addPreset(50)"></button>
                                <button class="matrix-bill-btn bill-img-tile bill-100e" t-on-click="() => this.addPreset(100)"></button>
                            </t>
                            <t t-else="">
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(1)">1 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(5)">5 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(10)">10 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(20)">20 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(50)">50 L</button>
                                <button class="matrix-bill-btn liter-tile liter-full-tile" t-on-click="() => this.addPreset(999)">⛽ LLENO</button>
                            </t>
                        </div>

                        <div class="matrix-fuels-grid">
                            <t t-foreach="state.availableFuels" t-as="fuel" t-key="fuel.code">
                                <button t-attf-class="fuel-matrix-btn fuel-#{fuel.class} #{state.selectedFuel === fuel.code ? 'active' : ''}" 
                                        t-on-click="() => this.selectFuel(fuel.code)" 
                                        t-esc="fuel.code"/>
                            </t>
                        </div>
                    </div>

                    <div class="virtus-action-row">
                        <button class="btn-action-tile btn-water-drop" t-on-click="() => this.toggleMode()" title="Conmutar Litros/Euros">
                            💧
                        </button>
                        <button class="btn-action-tile btn-c-reset" t-on-click="() => this.clearPreset()" title="Borrar prefijado">
                            C
                        </button>
                        <button class="btn-action-tile btn-auth-green" t-on-click="() => this.authorizePreset()" title="Autorizar calle seleccionada">
                            AUTORIZAR <t t-if="state.selectedPumpId">CALLE <t t-esc="state.selectedPumpId"/></t>
                        </button>

                    </div>

                    <!-- BARRA DE SINCRONIZACIÓN AZUL VIRTUS -->
                    <div class="virtus-sync-bar">
                        <span>SYNC: 0</span>
                    </div>

                    <!-- PIE DE ESTADO DE DOS LÍNEAS VIRTUS -->
                    <div class="virtus-tpv-status-footer-double">
                        <div class="footer-line-1">
                            CAJA: <strong>A</strong> | TPV: <strong>1</strong> | TURNO: <strong>MAÑANA</strong>
                        </div>
                        <div class="footer-line-2">
                            USUARIO: <strong><t t-esc="pos.user ? pos.user.name.toUpperCase() : 'SUPERVISOR'"/></strong> | <t t-esc="currentDateTimeStr"/>
                        </div>
                    </div>

                </div>

            </div>

            <!-- ======================================================== -->
            <!-- MODAL DE BÚSQUEDA DE TIENDA COMPLETO                      -->
            <!-- ======================================================== -->
            <t t-if="state.isStoreModalOpen">
                <div class="utrecar-modal-backdrop" t-on-click="() => this.closeStoreModal()">
                    <div class="utrecar-store-modal" t-on-click.stop="">
                        <div class="store-modal-header">
                            <div class="modal-title">
                                <i class="fa fa-boxes me-2"/>
                                <strong>CATÁLOGO COMPLETO DE TIENDA</strong>
                            </div>
                            <div class="modal-search-box">
                                <input type="text" 
                                       class="store-search-input" 
                                       placeholder="Buscar por Nombre, Código Interno o Código de Barras..." 
                                       t-att-value="state.storeSearch" 
                                       t-on-input="(ev) => this.onStoreSearchInput(ev)" />
                                <button t-if="state.storeSearch" class="btn-clear-search-store" t-on-click="() => this.clearStoreSearch()">✖</button>
                            </div>
                            <button class="btn-close-modal" t-on-click="() => this.closeStoreModal()">✖</button>
                        </div>

                        <!-- CATEGORÍAS TPV EN EL MODAL -->
                        <div class="store-modal-categories" t-if="posCategories.length > 0">
                            <button t-attf-class="btn-cat-chip #{!state.selectedModalCategory ? 'active' : ''}" 
                                    t-on-click="() => this.selectModalCategory(null)">
                                Todos los Artículos
                            </button>
                            <t t-foreach="posCategories" t-as="cat" t-key="cat.id">
                                <button t-attf-class="btn-cat-chip #{state.selectedModalCategory === cat.id ? 'active' : ''}" 
                                        t-on-click="() => this.selectModalCategory(cat.id)">
                                    <t t-esc="cat.name"/>
                                </button>
                            </t>
                        </div>

                        <div class="store-products-grid">
                            <t t-if="filteredStoreProducts.length === 0">
                                <div class="col-12 text-center py-5 text-muted">
                                    <i class="fa fa-search fa-2x mb-2 d-block opacity-40"/>
                                    No se encontró ningún artículo para "<strong><t t-esc="state.storeSearch"/></strong>".
                                </div>
                            </t>
                            <t t-foreach="filteredStoreProducts" t-as="product" t-key="product.id">
                                <div class="store-product-card" t-on-click="() => this.addStoreProductToOrder(product)">
                                    <div class="product-card-body">
                                        <div class="product-badges-row">
                                            <span class="product-code" t-if="product.default_code"><t t-esc="product.default_code"/></span>
                                            <span class="product-barcode-tag" t-if="product.barcode">
                                                <i class="fa fa-barcode me-1"/><t t-esc="product.barcode"/>
                                            </span>
                                        </div>
                                        <div class="product-name"><t t-esc="product.display_name"/></div>
                                        <div class="product-price"><t t-esc="(product.lst_price || product.list_price || 0).toFixed(2)"/> €</div>
                                    </div>
                                    <div class="product-card-footer">➕ Añadir a Venta</div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ======================================================== -->
            <!-- MODAL FLOTANTE DE BÚSQUEDA Y SELECCIÓN DE CLIENTE        -->
            <!-- ======================================================== -->
            <t t-if="state.isClientModalOpen">
                <div class="utrecar-modal-backdrop" t-on-click="() => this.closeClientModal()">
                    <div class="utrecar-client-modal" t-on-click.stop="">
                        <div class="client-modal-header">
                            <div class="modal-title">
                                <i class="fa fa-address-card mr-2"/>
                                <strong>SELECCIÓN DE CLIENTE</strong>
                            </div>
                            <div class="modal-search-box">
                                <input type="text" class="client-search-input" 
                                       placeholder="Buscar por Nombre, CIF/NIF, Teléfono..." 
                                       t-att-value="state.clientSearch" 
                                       t-on-input="(ev) => this.onClientSearchInput(ev)" />
                            </div>
                            <div class="header-actions">
                                <button class="btn-clear-client" t-on-click="() => this.removeClient()" title="Desasignar cliente">
                                    Quitar Cliente
                                </button>
                                <button class="btn-close-modal" t-on-click="() => this.closeClientModal()">✖</button>
                            </div>
                        </div>
                        <div class="client-table-wrapper">
                            <table class="client-modal-table">
                                <thead>
                                    <tr>
                                        <th style="width: 38%;">Nombre / Razón Social</th>
                                        <th style="width: 18%;">CIF / NIF</th>
                                        <th style="width: 18%;">Teléfono</th>
                                        <th style="width: 26%;">Email / Población</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="filteredClients.length === 0">
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                No se encontraron clientes con ese criterio.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="filteredClients" t-as="c" t-key="c.id">
                                        <tr t-att-class="(currentOrderPartner and currentOrderPartner.id === c.id) ? 'client-row selected' : 'client-row'"
                                            t-on-click="() => this.selectClient(c)">
                                            <td>
                                                <strong><t t-esc="c.name"/></strong>
                                            </td>
                                            <td>
                                                <span class="vat-badge"><t t-esc="c.vat || '-'"/></span>
                                            </td>
                                            <td>
                                                <t t-esc="c.phone || c.mobile || '-'"/>
                                            </td>
                                            <td>
                                                <t t-esc="c.email || c.city || '-'"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>

        </div>
    </t>

    <!-- SUSTITUCIÓN COMPLETA DE PRODUCTSCREEN -->
    <t t-name="pos_gas_station.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('product-screen')]" position="replace">
            <div class="product-screen screen d-flex flex-column h-100 p-0 m-0">
                <UtrecarMainScreen />
            </div>
        </xpath>
    </t>

    <!-- HEADER SUPERIOR DE PAYMENTSCREEN CON BOTÓN VOLVER MUY VISIBLE -->
    <t t-name="pos_gas_station.PaymentScreenTop" t-inherit="point_of_sale.PaymentScreenTop" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('top-content')]" position="replace">
            <div class="top-content utrecar-payment-top-bar d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                <button class="btn btn-danger btn-lg d-flex align-items-center gap-2 fw-bold text-white shadow-sm utrecar-back-btn" t-on-click="() => pos.showScreen('ProductScreen')">
                    <i class="fa fa-arrow-left fa-lg" />
                    <span>⬅ VOLVER A PISTA / CANCELAR</span>
                </button>
                <div class="top-content-center">
                    <h3 class="mb-0 fw-bold text-dark text-uppercase">
                        <i class="fa fa-credit-card me-2 text-primary"/>Cobro de Venta
                    </h3>
                </div>
                <div>
                    <button class="btn btn-outline-danger fw-bold" t-on-click="() => pos.showScreen('ProductScreen')">
                        <i class="fa fa-times me-1"/> Salir sin cobrar
                    </button>
                </div>
            </div>
        </xpath>
    </t>

    <!-- SUSTITUCIÓN COMPLETA DEL BOTÓN VALIDATE DE PAYMENTSCREEN -->
    <t t-name="pos_gas_station.PaymentScreenValidate" t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('validation')]" position="replace">
            <div class="utrecar-payment-actions-wrapper p-2 bg-light border-top">
                <div class="utrecar-payment-actions-grid mb-2">
                    <button class="btn-virtus-pay btn-pay-ticket" 
                             
                            t-on-click="() => this.validateVirtusTicket()"
                            title="Cobrar e imprimir ticket">
                        <div class="pay-icon">🖨</div>
                        <div class="pay-details">
                            <strong>TICKET</strong>
                            <span>Imprimir</span>
                        </div>
                    </button>

                    <button class="btn-virtus-pay btn-pay-invoice" 
                             
                            t-on-click="() => this.validateVirtusInvoice()"
                            title="Cobrar y emitir Factura con NIF/CIF">
                        <div class="pay-icon">📄</div>
                        <div class="pay-details">
                            <strong>FACTURA</strong>
                            <span>NIF / CIF</span>
                        </div>
                    </button>

                    <button class="btn-virtus-pay btn-pay-noprint" 
                             
                            t-on-click="() => this.validateVirtusNoPrint()"
                            title="Guardar venta sin imprimir ticket">
                        <div class="pay-icon">💾</div>
                        <div class="pay-details">
                            <strong>GUARDAR</strong>
                            <span>Sin Ticket</span>
                        </div>
                    </button>
                </div>
                

            </div>
        </xpath>
    </t>

</templates>
