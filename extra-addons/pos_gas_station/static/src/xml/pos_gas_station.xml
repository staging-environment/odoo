<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- PANTALLA COMPLETA PRINCIPAL UTRECAR TPV -->
    <t t-name="pos_gas_station.UtrecarMainScreen" owl="1">
        <div class="utrecar-fullscreen-tpv">
            
            <!-- ============================================================ -->
            <!-- ZONA 1 (SUPERIOR): CABECERA, MATRÍCULA Y TABLA DE ARTÍCULOS  -->
            <!-- ============================================================ -->
            <div class="utrecar-top-section">
                
                <!-- BARRA SUPERIOR DE ACCIONES -->
                <div class="utrecar-header-bar">
                    <div class="header-left">
                        <span class="station-brand-badge">
                            <i class="fa fa-gas-pump mr-1"/> <t t-esc="state.stationName"/>
                        </span>
                        <span class="live-indicator"><i class="fa fa-circle mr-1"/> EN DIRECTO (1s)</span>
                    </div>

                    <!-- MATRÍCULA EUROPEA CENTRAL -->
                    <div class="header-center">
                        <div class="euro-plate-wrapper">
                            <span class="eu-flag">🇪🇸 E</span>
                            <input type="text" 
                                   class="euro-plate-text" 
                                   placeholder="MATRÍCULA..." 
                                   t-att-value="state.vehiclePlate"
                                   t-on-input="(ev) => this.onPlateChange(ev)" />
                        </div>
                    </div>

                    <!-- BOTONES DE TURNO, DEVOLUCIONES Y SEGURIDAD -->
                    <div class="header-right">
                        <button class="btn-top-action btn-store-toggle" t-on-click="() => this.openStoreModal()">
                            <i class="fa fa-shopping-bag mr-1"/> <strong>TIENDA / PARRILLA</strong>
                        </button>
                        <button class="btn-top-action btn-refund" t-on-click="() => this.openRefundScreen()" title="Consultar tickets anteriores o realizar un abono/devolución">
                            <i class="fa fa-undo mr-1"/> <strong>Devolución / Historial</strong>
                        </button>
                        <button class="btn-top-action btn-security" t-on-click="() => this.onSecurityDepositClick()">
                            <i class="fa fa-shield-alt mr-1"/> Ingreso Seguridad
                        </button>
                        <button class="btn-top-action btn-emergency" t-on-click="() => this.onEmergencyStopClick()">
                            <i class="fa fa-stop-circle mr-1"/> Parada Emergencia
                        </button>
                    </div>
                </div>

                <!-- TABLA DE ARTÍCULOS / TICKET EN CURSO -->
                <div class="utrecar-ticket-table-container">
                    <table class="utrecar-ticket-table">
                        <thead>
                            <tr>
                                <th style="width: 10%;">CÓDIGO</th>
                                <th style="width: 38%;">ARTÍCULO / COMBUSTIBLE</th>
                                <th style="width: 12%; text-align: right;">CANTIDAD</th>
                                <th style="width: 12%; text-align: right;">PRECIO</th>
                                <th style="width: 8%; text-align: right;">DESC %</th>
                                <th style="width: 14%; text-align: right;">IMPORTE</th>
                                <th style="width: 6%; text-align: center;">BORRAR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="currentOrderLines.length === 0">
                                <tr class="empty-ticket-row">
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="fa fa-shopping-cart fa-2x mb-2 d-block opacity-50"/>
                                        Ticket vacío. Seleccione una <strong>Calle libre</strong> + importe para Prepago, o pulse <strong>PASAR A TICKET</strong> para Postpago.
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <t t-foreach="currentOrderLines" t-as="line" t-key="line.id">
                                    <tr t-att-class="(state.selectedLineId === line.id || line.selected) ? 'selected-line' : ''" 
                                        t-on-click="() => this.selectOrderLine(line)"
                                        style="cursor: pointer;">
                                        <td><t t-esc="line.product.default_code || 'COMB'"/></td>
                                        <td class="font-weight-bold"><t t-esc="line.product.display_name"/></td>
                                        <td class="text-right"><t t-esc="line.get_quantity_str()"/> <t t-esc="line.product.uom_id ? line.product.uom_id[1] : 'Ud'"/></td>
                                        <td class="text-right"><t t-esc="line.get_unit_price().toFixed(3)"/> €</td>
                                        <td class="text-right"><t t-esc="line.get_discount_str()"/> %</td>
                                        <td class="text-right font-weight-bold text-success"><t t-esc="line.get_display_price().toFixed(2)"/> €</td>
                                        <td class="text-center" style="padding: 2px;">
                                            <button class="btn btn-sm btn-outline-danger" 
                                                    style="padding: 2px 6px; font-size: 11px; border-radius: 4px;"
                                                    t-on-click.stop="() => this.deleteSpecificLine(line)" 
                                                    title="Eliminar esta línea">
                                                <i class="fa fa-times text-danger"/>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- BARRA INFERIOR DE TICKET (TOTAL COMBINADO Y BOTÓN DE COBRO) -->
                <div class="utrecar-ticket-footer">
                    <div class="ticket-tools">
                        <button class="btn-tool btn-add-product" t-on-click="() => this.openStoreModal()" title="Añadir producto de tienda">
                            <i class="fa fa-plus-circle mr-1 text-primary"/> <strong>Añadir Artículo</strong>
                        </button>
                        <button class="btn-tool btn-delete-line" t-on-click="() => this.deleteSelectedLine()" title="Eliminar línea seleccionada">
                            <i class="fa fa-trash-alt mr-1"/> Borrar Artículo
                        </button>
                        <button class="btn-tool btn-clear-all" t-on-click="() => this.clearCurrentOrder()" title="Cancelar venta">
                            <i class="fa fa-times-circle mr-1"/> Cancelar Ticket
                        </button>
                    </div>
                    
                    <div class="ticket-totals-box">
                        <span class="total-label">TOTAL A COBRAR:</span>
                        <span class="total-amount"><t t-esc="currentTotalAmount.toFixed(2)"/> €</span>
                        <button class="btn-pay-now" t-on-click="() => this.goToPayment()">
                            <i class="fa fa-credit-card mr-2"/> COBRAR (<t t-esc="currentTotalAmount.toFixed(2)"/> €)
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- ZONA 2 (INFERIOR): MAPA DE SURTIDORES + TECLADO DE BILLETES  -->
            <!-- ============================================================ -->
            <div class="utrecar-bottom-section">
                
                <!-- PARTE INFERIOR IZQUIERDA: MAPA DE SURTIDORES (CALLAS 1 A 8) -->
                <div class="utrecar-pumps-card-panel">
                    <div class="panel-section-title">
                        <i class="fa fa-tachometer-alt mr-2 text-info"/> ESTADO EN PISTA DE SURTIDORES
                    </div>
                    
                    <div class="pumps-auto-grid">
                        <t t-foreach="state.pumps" t-as="pump" t-key="pump.id">
                            <div t-attf-class="pump-station-box status-#{pump.status} #{state.selectedPumpId === pump.id ? 'is-active-selection' : ''}"
                                 t-on-click="() => this.onPumpSelect(pump)">
                                
                                <div class="box-head">
                                    <span class="box-calle">CALLE <t t-esc="pump.id"/></span>
                                    <span class="box-badge"><t t-esc="pump.statusText"/></span>
                                </div>

                                <div class="box-fuel-label"><t t-esc="pump.fuel"/></div>

                                <div class="box-lcd-counter">
                                    <div class="lcd-euros">
                                        <t t-if="pump.amount > 0">
                                            <t t-esc="pump.amount.toFixed(2)"/> €
                                        </t>
                                        <t t-else="">0.00 €</t>
                                    </div>
                                    <div class="lcd-liters">
                                        <t t-if="pump.liters > 0">
                                            <t t-esc="pump.liters.toFixed(2)"/> L
                                        </t>
                                        <t t-else="">0.00 L</t>
                                    </div>
                                </div>

                                <div class="box-action-slot">
                                    <t t-if="pump.status === 'ready' || (pump.status !== 'dispensing' &amp;&amp; pump.amount > 0)">
                                        <button class="btn-box-load" t-on-click.stop="() => this.onPumpClick(pump)">
                                            <i class="fa fa-arrow-circle-up mr-1"/> PASAR A TICKET
                                        </button>
                                    </t>
                                    <t t-elif="pump.status === 'dispensing' || pump.statusText === 'AUTORIZADO'">
                                        <div class="badge-dispensing">
                                            <i class="fa fa-spinner fa-spin mr-1"/> EN PROCESO
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger mt-1 w-100" 
                                                style="font-size: 9.5px; padding: 2px 0; font-weight: 800; border-radius: 4px;" 
                                                t-on-click.stop="() => this.cancelPumpAuthorization(pump)"
                                                title="Cancelar autorización y bloquear surtidor">
                                            <i class="fa fa-ban mr-1"/> Cancelar
                                        </button>
                                    </t>
                                    <t t-else="">
                                        <div class="badge-idle">
                                            <t t-if="state.selectedPumpId === pump.id &amp;&amp; state.presetValue > 0">
                                                <button class="btn-box-load" style="background:#2563eb; color:#fff;" t-on-click.stop="() => this.authorizePreset()">
                                                    <i class="fa fa-plus mr-1"/> PREPAGO A TICKET
                                                </button>
                                            </t>
                                            <t t-else="">
                                                SURTIDOR LIBRE
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- PARTE INFERIOR DERECHA: PAD RÁPIDO CON BILLETES SVG VECTORIALES NÍTITOS -->
                <div class="utrecar-keypad-panel">
                    
                    <!-- DISPLAY DIGITAL -->
                    <div class="keypad-lcd-display">
                        <div class="lcd-info">
                            <span class="lcd-sub"><t t-esc="state.mode === 'money' ? 'PREFIJADO IMPORTE' : 'PREFIJADO LITROS'"/></span>
                            <span class="lcd-main"><t t-esc="state.presetValue > 0 ? state.presetValue : '0'"/> <t t-esc="state.mode === 'money' ? '€' : 'L'"/></span>
                        </div>
                        <button t-attf-class="btn-toggle-drop #{state.mode === 'liters' ? 'is-liters' : ''}" 
                                t-on-click="() => this.toggleMode()"
                                title="Cambiar a litros o dinero">
                            <span class="drop-icon">💧</span>
                            <span class="drop-text"><t t-esc="state.mode === 'money' ? 'A LITROS' : 'A EUROS'"/></span>
                        </button>
                    </div>

                    <!-- BOTONERA DE BILLETES Y MONEDAS CON VECTORES SVG PERFECTOS -->
                    <div class="keypad-bills-grid">
                        <t t-if="state.mode === 'money'">
                            <button class="bill-btn bill-svg bill-1e" t-on-click="() => this.addPreset(1)" title="1 Euro"></button>
                            <button class="bill-btn bill-svg bill-5e" t-on-click="() => this.addPreset(5)" title="5 Euros"></button>
                            <button class="bill-btn bill-svg bill-10e" t-on-click="() => this.addPreset(10)" title="10 Euros"></button>
                            <button class="bill-btn bill-svg bill-20e" t-on-click="() => this.addPreset(20)" title="20 Euros"></button>
                            <button class="bill-btn bill-svg bill-50e" t-on-click="() => this.addPreset(50)" title="50 Euros"></button>
                            <button class="bill-btn bill-svg bill-100e" t-on-click="() => this.addPreset(100)" title="100 Euros"></button>
                        </t>
                        <t t-else="">
                            <button class="bill-btn liter-btn" t-on-click="() => this.addPreset(5)">5 L</button>
                            <button class="bill-btn liter-btn" t-on-click="() => this.addPreset(10)">10 L</button>
                            <button class="bill-btn liter-btn" t-on-click="() => this.addPreset(20)">20 L</button>
                            <button class="bill-btn liter-btn" t-on-click="() => this.addPreset(30)">30 L</button>
                            <button class="bill-btn liter-btn" t-on-click="() => this.addPreset(40)">40 L</button>
                            <button class="bill-btn liter-btn" t-on-click="() => this.addPreset(50)">50 L</button>
                        </t>
                    </div>

                    <!-- SELECTOR DE COMBUSTIBLE DINÁMICO SEGÚN LA GASOLINERA -->
                    <div class="keypad-fuel-grid">
                        <t t-foreach="state.availableFuels" t-as="fuel" t-key="fuel.code">
                            <button t-attf-class="fuel-tab #{fuel.class} #{state.selectedFuel === fuel.code ? 'active-fuel' : ''}" 
                                    t-on-click="() => this.selectFuel(fuel.code)">
                                <strong><t t-esc="fuel.code"/></strong> <t t-esc="fuel.name"/>
                            </button>
                        </t>
                    </div>

                    <!-- BOTONES DE ACCIÓN (BORRAR / AUTORIZAR) -->
                    <div class="keypad-action-grid">
                        <button class="btn-keypad-action btn-c-clear" t-on-click="() => this.clearPreset()">
                            <i class="fa fa-times mr-1"/> C (BORRAR)
                        </button>
                        
                        <t t-if="isSelectedPumpActive">
                            <button class="btn-keypad-action" style="background:#f59e0b; color:#fff; cursor: not-allowed;" title="Esta calle ya se encuentra en proceso de suministro">
                                <i class="fa fa-spinner fa-spin mr-1"/> EN PROCESO
                            </button>
                        </t>
                        <t t-else="">
                            <button class="btn-keypad-action btn-authorize-call" t-on-click="() => this.authorizePreset()">
                                <i class="fa fa-check-circle mr-1"/> AUTORIZAR <t t-if="state.selectedPumpId">CALLE <t t-esc="state.selectedPumpId"/></t>
                            </button>
                        </t>
                    </div>

                </div>

            </div>

            <!-- ============================================================ -->
            <!-- MODAL / PARRILLA DE PRODUCTOS DE TIENDA DE LA GASOLINERA     -->
            <!-- ============================================================ -->
            <t t-if="state.isStoreModalOpen">
                <div class="utrecar-modal-backdrop" t-on-click="() => this.closeStoreModal()">
                    <div class="utrecar-store-modal" t-on-click.stop="">
                        
                        <div class="store-modal-header">
                            <div class="modal-title">
                                <i class="fa fa-store mr-2 text-primary"/> CATÁLOGO DE TIENDA Y ARTÍCULOS DE PISTA
                            </div>
                            <div class="modal-search-box">
                                <i class="fa fa-search search-icon"/>
                                <input type="text" 
                                       class="store-search-input" 
                                       placeholder="Buscar producto (ej: agua, coca, hielo, butano...)" 
                                       t-att-value="state.storeSearch"
                                       t-on-input="(ev) => this.onStoreSearchInput(ev)" />
                            </div>
                            <button class="btn-close-modal" t-on-click="() => this.closeStoreModal()">
                                <i class="fa fa-times"/>
                            </button>
                        </div>

                        <!-- CUADRÍCULA TÁCTIL DE PRODUCTOS DE TIENDA -->
                        <div class="store-products-grid">
                            <t t-if="filteredStoreProducts.length === 0">
                                <div class="text-center py-5 w-100 text-muted">
                                    <i class="fa fa-box-open fa-3x mb-3 opacity-50"/>
                                    <p>No se encontraron productos coincidentes.</p>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-foreach="filteredStoreProducts" t-as="product" t-key="product.id">
                                    <div class="store-product-card" t-on-click="() => this.addStoreProductToOrder(product)">
                                        <div class="product-card-body">
                                            <div class="product-code"><t t-esc="product.default_code || 'ART'"/></div>
                                            <div class="product-name"><t t-esc="product.display_name"/></div>
                                            <div class="product-price"><t t-esc="product.lst_price.toFixed(2)"/> €</div>
                                        </div>
                                        <div class="product-card-footer">
                                            <i class="fa fa-plus-circle mr-1"/> Añadir
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>

                    </div>
                </div>
            </t>

        </div>
    </t>

    <!-- SUSTITUCIÓN COMPLETA DE PRODUCTSCREEN -->
    <t t-name="pos_gas_station.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('product-screen')]" position="replace">
            <div class="product-screen screen d-flex flex-column h-100 p-0 m-0">
                <UtrecarMainScreen />
            </div>
        </xpath>
    </t>
</templates>
