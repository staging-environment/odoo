<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ============================================================ -->
    <!-- PLANTILLA VIRTUSTPV AUTÉNTICA PARA ODOO 17 (ESTRUCTURA 2X2)  -->
    <!-- ============================================================ -->
    <t t-name="pos_gas_station.UtrecarMainScreen" owl="1">
        <div class="virtus-screen-master">

            <!-- ======================================================== -->
            <!-- FILA SUPERIOR: TABLA DE TICKET (68%) + PARRILLA TIENDA (32%) -->
            <!-- ======================================================== -->
            <div class="virtus-row-top">

                <!-- 1. CUADRANTE SUPERIOR IZQUIERDO: TICKET / ARTÍCULOS -->
                <div class="virtus-quadrant-ticket">
                    <!-- CABECERA SUPERIOR DE VENTA -->
                                        <div class="virtus-ticket-topbar">
                        <div class="virtus-ticket-client-area">
                            <button class="virtus-card-cards-badge" t-on-click="onClickPartner">
                                <i class="fa fa-address-card me-1"/>
                                <t t-if="currentOrderPartner">
                                    <t t-esc="currentOrderPartner.name"/>
                                </t>
                                <t t-else="">
                                    💳 CLIENTE
                                </t>
                            </button>
                            <div class="virtus-plate-box">
                                <span class="eu-flag-box">🇪🇸 E</span>
                                <input type="text" class="virtus-plate-input" 
                                       placeholder="MATRÍCULA" 
                                       t-model="state.vehiclePlate"
                                       t-on-change="onPlateChange"/>
                            </div>
                        </div>
                        <button class="virtus-user-badge-btn" t-on-click="onClickCashier">
                            <i class="fa fa-user me-1"/>
                            <t t-esc="cashierName"/>
                        </button>
                        <div class="station-mini-label">
                            <t t-esc="posStationName"/>
                        </div>
                    </div>
                    </div>

                <!-- 2. CUADRANTE SUPERIOR DERECHO: PARRILLA DE TIENDA (32%) -->
                <div class="virtus-quadrant-store">
                    <!-- BARRA DE CATEGORÍAS SUPERIOR -->
                    <div class="virtus-store-topbar">
                        <button class="btn-store-cat" t-on-click="() => this.onSecurityDepositClick()" title="Opciones de Turno / Ingreso de Seguridad">
                            ⏱
                        </button>
                        <button class="btn-store-cat" t-on-click="() => this.openStoreModal()" title="Catálogo de Artículos">
                            📦
                        </button>
                        <button class="btn-store-cat" t-on-click="() => this.openStoreModal()" title="Parrilla Tienda">
                            🛒
                        </button>
                        <button class="btn-store-cat btn-cat-nav" title="Página Siguiente">
                            ▼
                        </button>
                    </div>

                    <!-- CUADRÍCULA DIRECTA DE 20 PRODUCTOS EXACTOS VIRTUSTPV (5x4) -->
                    <div class="virtus-store-grid">
                        <t t-foreach="popularStoreProducts" t-as="prod" t-key="prod.id">
                            <t t-if="prod.is_empty">
                                <div class="store-item-btn empty-slot"></div>
                            </t>
                            <t t-elif="prod.bg_image">
                                <button class="store-item-btn" 
                                        t-att-title="prod.display_name"
                                        t-on-click="() => this.addStoreProductToOrder(prod)">
                                    <img t-att-src="prod.bg_image" class="store-product-img-tag" alt="Producto"/>
                                </button>
                            </t>
                            <t t-elif="prod.text_only">
                                <button class="store-item-btn text-item-btn" 
                                        t-att-title="prod.full_name || prod.display_name"
                                        t-on-click="() => this.addStoreProductToOrder(prod)">
                                    <span class="text-btn-label"><t t-esc="prod.display_name"/></span>
                                </button>
                            </t>
                            <t t-else="">
                                <button class="store-item-btn" t-on-click="() => this.addStoreProductToOrder(prod)">
                                    <span class="store-item-name"><t t-esc="prod.display_name"/></span>
                                </button>
                            </t>
                        </t>
                    </div>
                </div>

            </div>

            <!-- ======================================================== -->
            <!-- FILA INFERIOR: MAPA SURTIDORES (68%) + TECLADO COBRO (32%) -->
            <!-- ======================================================== -->
            <div class="virtus-row-bottom">

                <!-- 3. CUADRANTE INFERIOR IZQUIERDO: POSTES DE SURTIDORES ASEPRODA -->
                <div class="virtus-quadrant-pumps">
                    <div class="pumps-brand-watermark">
                        <span class="aseproda-logo-text"><span class="a-blue">A</span>seproda</span>
                    </div>
                    
                    <div class="virtus-pumps-row">
                        <t t-foreach="state.pumps" t-as="pump" t-key="pump.id">
                            <t t-set="fuelInfo" t-value="getPumpFuelData(pump)"/>
                            
                            <!-- POSTE CON SILUETA Y MANGUERA TÍPICA ASEPRODA -->
                            <div t-attf-class="aseproda-dispenser-box status-#{pump.status} #{state.selectedPumpId === pump.id ? 'is-selected' : ''}"
                                 t-on-click="() => this.onPumpSelect(pump)">
                                
                                <!-- PARTE SUPERIOR DEL POSTE: NÚMERO Y PANTALLA LCD -->
                                <div class="dispenser-head">
                                    <div class="dispenser-number-tag"><t t-esc="pump.id"/></div>
                                    <div class="dispenser-lcd-screen">
                                        <div class="lcd-header-line">
                                            <span class="f-code"><t t-esc="fuelInfo.shortCode"/></span>
                                            <span class="f-liters"><t t-esc="pump.liters > 0 ? pump.liters.toFixed(2) + ' L' : '0.00 L'"/></span>
                                        </div>
                                        <div class="lcd-price-main">
                                            <t t-esc="pump.amount > 0 ? pump.amount.toFixed(2) + ' €' : '0,00 €'"/>
                                        </div>
                                        <div class="lcd-footer-line">
                                            <t t-if="pump.status === 'dispensing'">Suministrando</t>
                                            <t t-elif="pump.status === 'ready'">Fin Repostaje</t>
                                            <t t-else="">Sin prefijado</t>
                                        </div>
                                    </div>
                                </div>

                                <!-- PARTE INFERIOR DEL POSTE: CUERPO CON MANGUERA Y BOTÓN DE ESTADO -->
                                <div class="dispenser-lower-body">
                                    <t t-if="pump.status === 'ready' || (pump.amount > 0 &amp;&amp; pump.status !== 'dispensing')">
                                        <button class="btn-virtus-pasar-ticket" t-on-click.stop="() => this.onPumpClick(pump)">
                                            <div class="icon-up">⬆</div>
                                            <strong>PASAR A TICKET</strong>
                                        </button>
                                    </t>
                                    <t t-elif="pump.status === 'dispensing'">
                                        <div class="dispenser-green-padlock">
                                            <span class="padlock-icon">🔒</span>
                                            <span class="padlock-sub"><t t-esc="pump.liters > 0 ? pump.liters.toFixed(1) + ' L' : 'SUMINISTRO'"/></span>
                                        </div>
                                        <button class="btn-cancel-dispenser" t-on-click.stop="() => this.cancelPumpAuthorization(pump)">
                                            Cancelar
                                        </button>
                                    </t>
                                    <t t-else="">
                                        <div class="dispenser-nozzle-panel">
                                            <div class="nozzle-icon">⛽</div>
                                            <span class="nozzle-text">LIBRE</span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- 4. CUADRANTE INFERIOR DERECHO: TECLADO Y COBRO (32%) -->
                <div class="virtus-quadrant-keypad">
                    
                    <!-- DISPLAY LCD SUPERIOR DE PREFIJADO -->
                    <div class="virtus-numpad-header">
                        <div class="lcd-value-display">
                            <span class="lcd-current"><t t-esc="state.presetValue > 0 ? state.presetValue : '0,00'"/> <t t-esc="state.mode === 'money' ? '€' : 'L'"/></span>
                        </div>
                        <button class="btn-numpad-tool btn-mode-calles" t-on-click="() => this.toggleMode()">
                            <t t-esc="state.mode === 'money' ? 'Modo Dinero' : 'Modo Litros'"/>
                        </button>
                        <button class="btn-numpad-tool btn-gear" t-on-click="() => this.openStoreModal()">
                            ⚙
                        </button>
                    </div>

                    <!-- MATRIZ CENTRAL: BILLETES (65%) + COMBUSTIBLES (35%) -->
                    <div class="virtus-keypad-matrix">
                        
                        <!-- 6 BOTONES DE BILLETES Y MONEDAS (3 cols x 2 rows) -->
                        <div class="matrix-bills-grid">
                            <t t-if="state.mode === 'money'">
                                <button class="matrix-bill-btn bill-svg bill-1e" t-on-click="() => this.addPreset(1)"></button>
                                <button class="matrix-bill-btn bill-svg bill-5e" t-on-click="() => this.addPreset(5)"></button>
                                <button class="matrix-bill-btn bill-svg bill-10e" t-on-click="() => this.addPreset(10)"></button>
                                <button class="matrix-bill-btn bill-svg bill-20e" t-on-click="() => this.addPreset(20)"></button>
                                <button class="matrix-bill-btn bill-svg bill-50e" t-on-click="() => this.addPreset(50)"></button>
                                <button class="matrix-bill-btn bill-svg bill-100e" t-on-click="() => this.addPreset(100)"></button>
                            </t>
                            <t t-else="">
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(1)">1 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(5)">5 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(10)">10 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(20)">20 L</button>
                                <button class="matrix-bill-btn liter-tile" t-on-click="() => this.addPreset(50)">50 L</button>
                                <button class="matrix-bill-btn liter-tile liter-full-tile" t-on-click="() => this.addPreset(999)">⛽ LLENO</button>
                            </t>
                        </div>

                        <!-- 4 BOTONES DE COMBUSTIBLES (2 cols x 2 rows) -->
                        <div class="matrix-fuels-grid">
                            <button t-attf-class="fuel-matrix-btn fuel-ga #{state.selectedFuel === 'GA' ? 'active' : ''}" 
                                    t-on-click="() => this.selectFuel('GA')">GA</button>
                            <button t-attf-class="fuel-matrix-btn fuel-gb #{state.selectedFuel === 'GB' ? 'active' : ''}" 
                                    t-on-click="() => this.selectFuel('GB')">GB</button>
                            <button t-attf-class="fuel-matrix-btn fuel-sp95 #{state.selectedFuel === '95' ? 'active' : ''}" 
                                    t-on-click="() => this.selectFuel('95')">95</button>
                            <button t-attf-class="fuel-matrix-btn fuel-gplus #{state.selectedFuel === 'G+' ? 'active' : ''}" 
                                    t-on-click="() => this.selectFuel('G+')">G+</button>
                        </div>

                    </div>

                    <!-- FILA DE ACCIÓN: GOTA 💧 + BORRAR C + AUTORIZAR / COBRAR -->
                    <div class="virtus-action-row">
                        <button class="btn-action-tile btn-water-drop" t-on-click="() => this.toggleMode()" title="Conmutar Litros/Euros">
                            💧
                        </button>
                        <button class="btn-action-tile btn-c-reset" t-on-click="() => this.clearPreset()" title="Borrar prefijado">
                            C
                        </button>
                        <button class="btn-action-tile btn-auth-green" t-on-click="() => this.authorizePreset()" title="Autorizar calle seleccionada">
                            AUTORIZAR <t t-if="state.selectedPumpId">CALLE <t t-esc="state.selectedPumpId"/></t>
                        </button>
                        <button class="btn-action-tile btn-pay-direct" t-on-click="() => this.goToPayment()" title="Pasar al Cobro">
                            COBRAR <t t-esc="currentTotalAmount.toFixed(2)"/> €
                        </button>
                    </div>

                    <!-- BARRA INFERIOR DE ESTADO DEL TPV -->
                    <div class="virtus-tpv-status-footer">
                        <span>CAJA: <strong>A</strong></span>
                        <span>TPV: <strong>1</strong></span>
                        <span>TURNO: <strong>MAÑANA</strong></span>
                        <span>USUARIO: <strong><t t-esc="pos.user ? pos.user.name.toUpperCase() : 'SUPERVISOR'"/></strong></span>
                    </div>

                </div>

            </div>

            <!-- ======================================================== -->
            <!-- MODAL DE BÚSQUEDA DE TIENDA COMPLETO                      -->
            <!-- ======================================================== -->
            <t t-if="state.isStoreModalOpen">
                <div class="utrecar-modal-backdrop" t-on-click="() => this.closeStoreModal()">
                    <div class="utrecar-store-modal" t-on-click.stop="">
                        <div class="store-modal-header">
                            <div class="modal-title">🛒 CATÁLOGO COMPLETO DE TIENDA</div>
                            <div class="modal-search-box">
                                <input type="text" class="store-search-input" placeholder="Buscar producto..." t-att-value="state.storeSearch" t-on-input="(ev) => this.onStoreSearchInput(ev)" />
                            </div>
                            <button class="btn-close-modal" t-on-click="() => this.closeStoreModal()">✖</button>
                        </div>
                        <div class="store-products-grid">
                            <t t-foreach="filteredStoreProducts" t-as="product" t-key="product.id">
                                <div class="store-product-card" t-on-click="() => this.addStoreProductToOrder(product)">
                                    <div class="product-card-body">
                                        <div class="product-code"><t t-esc="product.default_code || 'ART'"/></div>
                                        <div class="product-name"><t t-esc="product.display_name"/></div>
                                        <div class="product-price"><t t-esc="product.lst_price.toFixed(2)"/> €</div>
                                    </div>
                                    <div class="product-card-footer">➕ Añadir</div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

        </div>
    </t>

    <!-- SUSTITUCIÓN COMPLETA DE PRODUCTSCREEN -->
    <t t-name="pos_gas_station.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('product-screen')]" position="replace">
            <div class="product-screen screen d-flex flex-column h-100 p-0 m-0">
                <UtrecarMainScreen />
            </div>
        </xpath>
    </t>

    <!-- EXTENSIÓN DE PAYMENTSCREENVALIDATE - LAS 3 SALIDAS DE VIRTUSTPV -->
    <t t-name="pos_gas_station.PaymentScreenValidate" t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('validation')]" position="after">
            <div class="virtus-payment-actions-bar">
                <button class="btn-virtus-action btn-action-ticket" t-on-click="() => this.validateVirtusTicket()">
                    <div class="action-icon">🖨</div>
                    <div class="action-details">
                        <strong>TICKET</strong>
                        <span>Imprimir</span>
                    </div>
                </button>
                <button class="btn-virtus-action btn-action-invoice" t-on-click="() => this.validateVirtusInvoice()">
                    <div class="action-icon">📄</div>
                    <div class="action-details">
                        <strong>FACTURA</strong>
                        <span>NIF/CIF</span>
                    </div>
                </button>
                <button class="btn-virtus-action btn-action-noprint" t-on-click="() => this.validateVirtusNoPrint()">
                    <div class="action-icon">⚡</div>
                    <div class="action-details">
                        <strong>SIN TICKET</strong>
                        <span>Rápido</span>
                    </div>
                </button>
            </div>
        </xpath>
    </t>

</templates>
